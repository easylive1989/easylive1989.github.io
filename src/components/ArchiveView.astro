---
import type { Article, Note } from '../lib/notion';
import type { Category } from '../lib/data';
import { categorySlug } from '../lib/category';
import { coverOf, type Cover } from '../lib/think';
import QuarterHeat from './QuarterHeat.astro';
import '../styles/archive.css';

interface Props {
  articles: Article[];
  allCategories: Category[];
  scopeCategoryName?: string;
  /** 碎碎念 to list among the articles. They count in the heatmap like any article, and a note with nothing written under its title gets no link. */
  notes?: (Note & { hasBody: boolean })[];
}

const BASE = import.meta.env.BASE_URL;
const NOTE_CAT = '碎碎念';
const { articles, allCategories, scopeCategoryName, notes = [] } = Astro.props;
const isScoped = Boolean(scopeCategoryName);

function fmtMonthDay(iso: string): string {
  const d = new Date(iso);
  return `${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
}

/** An article without a 首圖 gets a quiet ink wash in its place, its blots set by its title so no two rows look quite the same. */
function washOf(title: string): string {
  let h = 0;
  for (const ch of title) h = (h * 31 + ch.codePointAt(0)!) >>> 0;
  return `--wx:${20 + (h % 40)}%;--wy:${55 + ((h >> 6) % 25)}%;--wx2:${55 + ((h >> 11) % 30)}%;--wy2:${25 + ((h >> 16) % 25)}%`;
}

interface Row {
  title: string;
  cat: string;
  createdTime: string;
  href: string | null;
  /** the article's 首圖, small; 碎碎念 and articles that open with words have none */
  cover: Cover | null;
}

interface YearGroup {
  year: number;
  items: Row[];
}

// Everything the page lists, newest first: the articles and, each by its date, the 碎碎念.
const rows: Row[] = [
  ...(await Promise.all(articles.map(async (a) => ({
    title: a.title, cat: a.category, createdTime: a.createdTime, href: `${BASE}${categorySlug(a.category)}/${a.id}/`, cover: await coverOf(a.cover),
  })))),
  ...notes.map((n) => ({ title: n.title, cat: NOTE_CAT, createdTime: n.createdTime, href: n.hasBody ? `${BASE}notes/${n.id}/` : null, cover: null })),
].sort((a, b) => b.createdTime.localeCompare(a.createdTime));
// One block of the list per year.
const byYear = new Map<number, Row[]>();
for (const r of rows) {
  const year = new Date(r.createdTime).getFullYear();
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(r);
}
const yearGroups: YearGroup[] = Array.from(byYear.entries())
  .sort((a, b) => b[0] - a[0])
  .map(([year, items]) => ({ year, items }));

const years = Array.from(byYear.keys());
const oldestYear = years.length ? Math.min(...years) : new Date().getFullYear();
const newestYear = years.length ? Math.max(...years) : new Date().getFullYear();

// The heatmap at the top: how many of them each quarter of each year saw.
const byQuarter: Record<number, number[]> = {};
for (const r of rows) {
  const d = new Date(r.createdTime);
  (byQuarter[d.getFullYear()] ??= [0, 0, 0, 0])[Math.floor(d.getMonth() / 3)]++;
}

// The ink study's colours for the categories: ink, the red sun, a grey-blue wash; 碎碎念 in stone grey.
const palette = ['var(--cat-1)', 'var(--cat-2)', 'var(--cat-3)'];
function catColor(name: string): string {
  const idx = allCategories.findIndex((c) => c.name === name);
  if (idx === -1) return 'var(--color-neutral-500)';
  return palette[idx % palette.length];
}

const chipData = allCategories.map((c) => ({
  name: c.name,
  count: articles.filter((a) => a.category === c.name).length,
  color: catColor(c.name),
}));
// 碎碎念 stand as one more category among the chips
if (notes.length) chipData.push({ name: NOTE_CAT, count: notes.length, color: catColor(NOTE_CAT) });
---

<div class:list={['archive-sheet', { 'is-scoped': isScoped }]} id="top">
  {isScoped ? (
    <!-- A category page names its category; 所有文章 shows no heading, the heatmap opens the page -->
    <header class="arc-scope">
      <a class="arc-back" href={`${BASE}`}>← 所有文章</a>
      <h1>{scopeCategoryName}</h1>
      <p class="arc-scope-n num">{rows.length} 篇</p>
    </header>
  ) : (
    <h1 class="sr-only">所有文章</h1>
  )}

  {years.length > 0 && (
    <figure class="arc-heat">
      <figcaption>每季落筆</figcaption>
      <QuarterHeat label="每年每季發文數量熱度圖" counts={byQuarter} from={oldestYear} to={newestYear} unit="篇" />
    </figure>
  )}

  <!-- Filter bar: the categories in one row that scrolls sideways, the search behind an icon at its end -->
  <section class="filter-bar" id="archive-bar" aria-label="篩選文章">
    {!isScoped && (
      <div class="chips" id="archive-chips" role="group" aria-label="依分類篩選">
        <button class="chip is-on" type="button" data-cat="*" aria-pressed="true">
          全部 <span class="ct num">{rows.length}</span>
        </button>
        {chipData.map((c) => (
          <button class="chip" type="button" data-cat={c.name} aria-pressed="false">
            <span class="dot" style={`--c:${c.color}`}></span>
            {c.name}
            <span class="ct num">{c.count}</span>
          </button>
        ))}
      </div>
    )}
    <button class="find" id="archive-find" type="button" aria-label="搜尋標題" title="搜尋標題（⌘K）" aria-expanded="false" aria-controls="archive-search">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
    </button>
    <div class="search" id="archive-search" hidden>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
      <input id="archive-q" type="search" placeholder="搜尋標題…" autocomplete="off" aria-label="搜尋文章標題" />
      <button class="search-x" id="archive-x" type="button" aria-label="清除並收起搜尋">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </div>
  </section>

  <!-- The index itself, one block per year -->
  <section class="archive-list" id="archive-list" aria-label="文章列表">
    {yearGroups.map((g) => (
      <div class="year-block" data-year={g.year}>
        <div class="year-side">
          <div class="yr-n num">{g.year}</div>
        </div>
        <div class="rows">
          {g.items.map((r) => {
            const Tag = r.href ? 'a' : 'div';
            return (
              <Tag class="archive-row" href={r.href ?? undefined} data-cat={r.cat} data-title={r.title} data-date={r.createdTime}>
                <span class="row-date num">{fmtMonthDay(r.createdTime)}</span>
                {r.cover ? (
                  <span class="row-cover" aria-hidden="true">
                    <img src={r.cover.src} srcset={r.cover.srcset} sizes={r.cover.srcset && '104px'} width={r.cover.width} height={r.cover.height} alt="" loading="lazy" decoding="async" />
                  </span>
                ) : (
                  <span class="row-cover is-wash" style={washOf(r.title)} aria-hidden="true"></span>
                )}
                <span class="row-title">{r.title}</span>
                <span class="row-cat" title={r.cat}>
                  <span class="dot" style={`--c:${catColor(r.cat)}`}></span>
                  <span class="row-cat-name">{r.cat}</span>
                </span>
              </Tag>
            );
          })}
        </div>
      </div>
    ))}
    <div class="archive-empty" id="archive-empty" hidden={yearGroups.length > 0}>
      <p>找不到符合的文章，換個關鍵字或分類試試。</p>
      <button class="btn btn-secondary" id="archive-reset" type="button">清除篩選</button>
    </div>
  </section>

</div>

<script is:inline>
  (function () {
    var list = document.getElementById('archive-list');
    if (!list) return;
    var q = document.getElementById('archive-q');
    var chips = document.getElementById('archive-chips');
    var find = document.getElementById('archive-find');
    var box = document.getElementById('archive-search');
    var clearBtn = document.getElementById('archive-x');
    var emptyEl = document.getElementById('archive-empty');
    var resetBtn = document.getElementById('archive-reset');
    var sections = Array.prototype.slice.call(list.querySelectorAll('.year-block'));

    var activeCat = '*';
    var kw = '';

    function apply() {
      var anyVisible = false;
      for (var s = 0; s < sections.length; s++) {
        var sec = sections[s];
        var rows = sec.querySelectorAll('.archive-row');
        var visibleInSection = 0;
        for (var i = 0; i < rows.length; i++) {
          var row = rows[i];
          var cat = row.getAttribute('data-cat') || '';
          var title = (row.getAttribute('data-title') || '').toLowerCase();
          var catOk = activeCat === '*' || cat === activeCat;
          var kwOk = !kw || title.indexOf(kw) >= 0 || cat.toLowerCase().indexOf(kw) >= 0;
          var show = catOk && kwOk;
          row.hidden = !show;
          if (show) visibleInSection++;
        }
        sec.hidden = visibleInSection === 0;
        if (visibleInSection > 0) anyVisible = true;
      }
      if (emptyEl) emptyEl.hidden = anyVisible;
    }

    function setChip(cat) {
      activeCat = cat;
      if (!chips) return;
      var all = chips.querySelectorAll('.chip');
      for (var i = 0; i < all.length; i++) {
        var on = (all[i].getAttribute('data-cat') || '*') === cat;
        all[i].setAttribute('aria-pressed', on ? 'true' : 'false');
        all[i].classList.toggle('is-on', on);
      }
    }

    // The search lives behind an icon: it opens on a click (or ⌘K) and folds back once it is empty and left, or cleared.
    function openSearch() {
      if (!box || !find) return;
      box.hidden = false;
      find.hidden = true;
      find.setAttribute('aria-expanded', 'true');
      if (q) { q.focus(); q.select(); }
    }
    function closeSearch(clear) {
      if (!box || !find) return;
      if (clear && q) { q.value = ''; kw = ''; apply(); }
      box.hidden = true;
      find.hidden = false;
      find.setAttribute('aria-expanded', 'false');
    }

    if (find) find.addEventListener('click', openSearch);
    if (clearBtn) {
      // keep the input's blur from folding the box away before the click lands
      clearBtn.addEventListener('mousedown', function (e) { e.preventDefault(); });
      clearBtn.addEventListener('click', function () { closeSearch(true); if (find) find.focus(); });
    }
    if (q) {
      q.addEventListener('input', function () {
        kw = q.value.trim().toLowerCase();
        apply();
      });
      q.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') { closeSearch(true); if (find) find.focus(); }
      });
      q.addEventListener('blur', function () {
        if (!q.value) closeSearch(false);
      });
    }

    if (chips) {
      chips.addEventListener('click', function (e) {
        var c = e.target.closest ? e.target.closest('.chip') : null;
        if (!c) return;
        setChip(c.getAttribute('data-cat') || '*');
        apply();
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', function () {
        closeSearch(true);
        setChip('*');
        apply();
      });
    }

    // ⌘K / Ctrl+K opens the search
    document.addEventListener('keydown', function (e) {
      if ((e.metaKey || e.ctrlKey) && e.key && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        openSearch();
      }
    });
  })();
</script>
