---
import type { Article, Note } from '../lib/notion';
import type { Category } from '../lib/data';
import { categorySlug } from '../lib/category';
import '../styles/archive.css';

interface Props {
  articles: Article[];
  allCategories: Category[];
  scopeCategoryName?: string;
  /** 碎碎念 to list among the articles. They are left out of the figures in the masthead, and a note with nothing written under its title gets no link. */
  notes?: (Note & { hasBody: boolean })[];
}

const BASE = import.meta.env.BASE_URL;
const NOTE_CAT = '碎碎念';
const { articles, allCategories, scopeCategoryName, notes = [] } = Astro.props;
const isScoped = Boolean(scopeCategoryName);

function fmtMonthDay(iso: string): string {
  const d = new Date(iso);
  return `${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
}

function estimateMin(title: string): number {
  return Math.max(3, Math.min(15, Math.round(title.length / 8) + 3));
}

interface Row {
  title: string;
  cat: string;
  createdTime: string;
  href: string | null;
}

interface YearGroup {
  year: number;
  count: number;
  peak: boolean;
  items: Row[];
}

// The figures in the masthead count the articles alone.
const grouped = new Map<number, Article[]>();
for (const a of articles) {
  const year = new Date(a.createdTime).getFullYear();
  if (!grouped.has(year)) grouped.set(year, []);
  grouped.get(year)!.push(a);
}
let peakYear = 0;
let peakCount = 0;
for (const [year, items] of grouped.entries()) {
  if (items.length > peakCount) {
    peakCount = items.length;
    peakYear = year;
  }
}

// The list below them holds the 碎碎念 too, each by its date.
const rows: Row[] = [
  ...articles.map((a) => ({ title: a.title, cat: a.category, createdTime: a.createdTime, href: `${BASE}${categorySlug(a.category)}/${a.id}/` })),
  ...notes.map((n) => ({ title: n.title, cat: NOTE_CAT, createdTime: n.createdTime, href: n.hasBody ? `${BASE}notes/${n.id}/` : null })),
].sort((a, b) => b.createdTime.localeCompare(a.createdTime));
const listed = new Map<number, Row[]>();
for (const r of rows) {
  const year = new Date(r.createdTime).getFullYear();
  if (!listed.has(year)) listed.set(year, []);
  listed.get(year)!.push(r);
}
const yearGroups: YearGroup[] = Array.from(listed.entries())
  .sort((a, b) => b[0] - a[0])
  .map(([year, items]) => ({
    year,
    count: items.length,
    peak: year === peakYear,
    items,
  }));

const years = Array.from(grouped.keys());
const oldestYear = years.length ? Math.min(...years) : new Date().getFullYear();
const newestYear = years.length ? Math.max(...years) : new Date().getFullYear();
const yearSpan = Math.max(1, newestYear - oldestYear + 1);
const totalPosts = articles.length;

// The histogram runs over the whole span so a quiet year shows as a gap, not as a missing column.
const histogram = years.length
  ? Array.from({ length: yearSpan }, (_, i) => {
      const year = oldestYear + i;
      return { year, count: grouped.get(year)?.length ?? 0, peak: year === peakYear };
    })
  : [];
const maxYearCount = histogram.reduce((m, g) => Math.max(m, g.count), 0);

const yearNotes: Record<number, string> = {
  2026: '回歸更新',
  2025: '思考程式設計的本質',
  2024: '深入 Widget 底層',
  2023: '工作流與細節',
  2022: '工作、轉折',
  2021: '第一年',
  2020: '入門 Kata 練習',
};

// Process-ink palette for categories: cyan, magenta, and a darkened yellow that holds up on paper.
const palette = ['var(--cat-1)', 'var(--cat-2)', 'var(--cat-3)'];
function catColor(name: string): string {
  const idx = allCategories.findIndex((c) => c.name === name);
  if (idx === -1) return 'var(--color-neutral-500)';
  return palette[idx % palette.length];
}

const chipData = allCategories.map((c) => ({
  name: c.name,
  count: articles.filter((a) => a.category === c.name).length,
  color: catColor(c.name),
}));
if (notes.length) chipData.push({ name: NOTE_CAT, count: notes.length, color: catColor(NOTE_CAT) });

const heroTitle = isScoped ? scopeCategoryName! : '所有文章';
const heroDesc = isScoped
  ? `這個分類底下的 ${totalPosts} 篇文章，跨 ${yearSpan} 年。`
  : `從 ${oldestYear} 年的第一篇開始，記錄學習歷程。寫到自己也忘記為什麼開始的那一天。`;
const kicker = isScoped ? 'Series · 系列' : 'Archive · 歸檔';
---

<div class:list={['paper', 'archive-sheet', { 'is-scoped': isScoped }]} id="top">
  <!-- Masthead: double rule, kicker, headline, lede, then the figures -->
  <header class="masthead">
    <div class="rules" aria-hidden="true"><i></i><i></i></div>
    <div class="kicker-row">
      <span class="kicker card-kicker">{kicker}</span>
      <nav class="mast-links" aria-label="相關連結">
        {isScoped && <a href={`${BASE}archive/`}>← 所有文章</a>}
        <a href="/rss.xml" target="_blank" rel="noopener">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.18 17.82c0 1.2-.97 2.18-2.18 2.18S1.82 19.02 1.82 17.82 2.79 15.64 4 15.64s2.18.98 2.18 2.18zM4 4.44v3.06A12.5 12.5 0 0 1 16.5 20h3.06A15.56 15.56 0 0 0 4 4.44zM4 10.6v3.07A6.4 6.4 0 0 1 10.4 20h3.07A9.47 9.47 0 0 0 4 10.6z"/>
          </svg>
          RSS 訂閱
        </a>
      </nav>
    </div>

    <div class="mast-grid">
      <div class="mast-text">
        <h1 class:list={{ 'is-long': heroTitle.length > 10 }}>{heroTitle}<span class="stop">。</span></h1>
        <p class="lede">{heroDesc}</p>
      </div>

      {histogram.length > 0 && (
        <figure class="histo" aria-label="每年發文量" style={`--n:${histogram.length}`}>
          <figcaption class="histo-label">每年發文量</figcaption>
          <div class="histo-grid">
            {histogram.map((g) => (
              <div class:list={['histo-col', { peak: g.peak, zero: g.count === 0 }]} title={`${g.year}：${g.count} 篇`}>
                <div class="histo-slot">
                  <span
                    class="histo-bar"
                    style={`height:${maxYearCount > 0 ? (g.count / maxYearCount) * 100 : 0}%`}
                  ></span>
                </div>
                <span class="yr num">{g.year}</span>
                <span class="ct num">{g.count} 篇</span>
              </div>
            ))}
          </div>
        </figure>
      )}
    </div>

    <dl class="stats">
      <div class="stat">
        <dt>total posts</dt>
        <dd class="num">{totalPosts}</dd>
      </div>
      <div class="stat">
        <dt>spanning</dt>
        <dd class="num">{yearSpan}<span class="unit">{yearSpan === 1 ? ' yr' : ' yrs'}</span></dd>
      </div>
      <div class="stat">
        <dt>categories</dt>
        <dd class="num">{allCategories.length}</dd>
      </div>
      <div class="stat stat-peak">
        <dt>peak year · {peakCount} 篇</dt>
        <dd class="num">{peakYear || '-'}</dd>
      </div>
    </dl>
  </header>

  <!-- Filter bar: search, sort, categories -->
  <section class="filter-bar" id="archive-bar" aria-label="篩選文章">
    <div class="filter-main">
      <div class="search">
        <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5"></circle>
          <path d="M16 16l4.5 4.5"></path>
        </svg>
        <input
          id="archive-q"
          class="input"
          type="search"
          placeholder="搜尋標題…"
          autocomplete="off"
          aria-label="搜尋文章標題"
        />
        <kbd class="kbd" id="archive-kbd" aria-hidden="true">⌘K</kbd>
      </div>
      <button class="btn btn-secondary sort-btn" id="archive-sort" type="button" data-dir="desc" aria-label="切換排序">
        <span class="sort-prefix">排序</span>
        <span class="sort-label">↓ 新到舊</span>
      </button>
      <span class="result-count num" id="archive-count" data-total={rows.length} aria-live="polite">共 {rows.length} 篇</span>
    </div>
    {!isScoped && (
      <div class="chips" id="archive-chips" role="group" aria-label="依分類篩選">
        <button class="chip tag tag-accent" type="button" data-cat="*" aria-pressed="true">
          全部 <span class="ct num">{rows.length}</span>
        </button>
        {chipData.map((c) => (
          <button class="chip tag tag-outline" type="button" data-cat={c.name} aria-pressed="false">
            <span class="dot" style={`--c:${c.color}`}></span>
            {c.name}
            <span class="ct num">{c.count}</span>
          </button>
        ))}
      </div>
    )}
  </section>

  <!-- The index itself, one block per year -->
  <section class="archive-list" id="archive-list" aria-label="文章列表">
    {yearGroups.map((g) => (
      <div class="year-block" data-year={g.year}>
        <div class="year-side">
          <div class="yr-n num">{g.year}</div>
          <div class="yr-l num" data-total={g.count}>{g.count} 篇</div>
          {g.peak && yearGroups.length > 1 && <div class="tag tag-peak">★ 高峰年</div>}
          {yearNotes[g.year] && <div class="yr-note">{yearNotes[g.year]}</div>}
        </div>
        <div class="rows">
          {g.items.map((r, i) => {
            const Tag = r.href ? 'a' : 'div';
            return (
              <Tag
                class:list={['archive-row', { 'is-first': i === 0 }]}
                href={r.href ?? undefined}
                data-cat={r.cat}
                data-title={r.title}
                data-date={r.createdTime}
              >
                <span class="row-date num">{fmtMonthDay(r.createdTime)}</span>
                <span class="row-title">{r.title}</span>
                <span class="row-cat" title={r.cat}>
                  <span class="dot" style={`--c:${catColor(r.cat)}`}></span>
                  <span class="row-cat-name">{r.cat}</span>
                </span>
                <span class="row-min num">{estimateMin(r.title)} min</span>
                {r.href && <span class="row-arrow" aria-hidden="true">↗</span>}
              </Tag>
            );
          })}
        </div>
      </div>
    ))}
    <div class="archive-empty" id="archive-empty" hidden={yearGroups.length > 0}>
      <p>沒有符合的文章。</p>
      <button class="btn btn-secondary" id="archive-reset" type="button">清除篩選</button>
    </div>
  </section>

  <!-- Quiet colophon; the HUD has the way back, the desk's corner button the way up -->
  <footer class="archive-foot">
    <span>paul-learning.dev · © {new Date().getFullYear()} Paul Wu · built with Astro</span>
  </footer>
</div>

<script is:inline>
  (function () {
    var list = document.getElementById('archive-list');
    if (!list) return;
    var q = document.getElementById('archive-q');
    var chips = document.getElementById('archive-chips');
    var sortBtn = document.getElementById('archive-sort');
    var emptyEl = document.getElementById('archive-empty');
    var resetBtn = document.getElementById('archive-reset');
    var countEl = document.getElementById('archive-count');
    var bar = document.getElementById('archive-bar');
    var kbd = document.getElementById('archive-kbd');
    var sections = Array.prototype.slice.call(list.querySelectorAll('.year-block'));

    var activeCat = '*';
    var kw = '';

    // The shortcut hint should match the keyboard in front of the reader.
    if (kbd && !/Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent || '')) {
      kbd.textContent = 'Ctrl K';
    }

    // Rows are separated by hairlines drawn above every row but the first *visible* one.
    function markFirst() {
      for (var s = 0; s < sections.length; s++) {
        var rows = sections[s].querySelectorAll('.archive-row');
        var first = true;
        for (var i = 0; i < rows.length; i++) {
          var visible = rows[i].style.display !== 'none';
          rows[i].classList.toggle('is-first', visible && first);
          if (visible) first = false;
        }
      }
    }

    function apply() {
      var anyVisible = false;
      var shown = 0;
      var total = 0;
      for (var s = 0; s < sections.length; s++) {
        var sec = sections[s];
        var rows = sec.querySelectorAll('.archive-row');
        var visibleInSection = 0;
        for (var i = 0; i < rows.length; i++) {
          var row = rows[i];
          var cat = row.getAttribute('data-cat') || '';
          var title = (row.getAttribute('data-title') || '').toLowerCase();
          var catOk = activeCat === '*' || cat === activeCat;
          var kwOk = !kw || title.indexOf(kw) >= 0 || cat.toLowerCase().indexOf(kw) >= 0;
          var show = catOk && kwOk;
          row.style.display = show ? '' : 'none';
          if (show) visibleInSection++;
        }
        sec.style.display = visibleInSection > 0 ? '' : 'none';
        var yl = sec.querySelector('.yr-l');
        if (yl) {
          var t = parseInt(yl.getAttribute('data-total') || '0', 10);
          yl.textContent = visibleInSection === t ? t + ' 篇' : visibleInSection + ' / ' + t + ' 篇';
        }
        shown += visibleInSection;
        total += rows.length;
        if (visibleInSection > 0) anyVisible = true;
      }
      if (emptyEl) emptyEl.hidden = anyVisible;
      if (countEl) countEl.textContent = shown === total ? '共 ' + total + ' 篇' : '顯示 ' + shown + ' / ' + total + ' 篇';
      markFirst();
    }

    function setChip(cat) {
      if (!chips) return;
      var all = chips.querySelectorAll('.chip');
      for (var i = 0; i < all.length; i++) {
        var on = (all[i].getAttribute('data-cat') || '*') === cat;
        all[i].setAttribute('aria-pressed', on ? 'true' : 'false');
        all[i].classList.toggle('tag-accent', on);
        all[i].classList.toggle('tag-outline', !on);
      }
      activeCat = cat;
    }

    if (q) {
      q.addEventListener('input', function () {
        kw = q.value.trim().toLowerCase();
        apply();
      });
      q.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && q.value) {
          q.value = '';
          kw = '';
          apply();
        }
      });
    }

    if (chips) {
      chips.addEventListener('click', function (e) {
        var c = e.target.closest ? e.target.closest('.chip') : null;
        if (!c) return;
        setChip(c.getAttribute('data-cat') || '*');
        apply();
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', function () {
        if (q) q.value = '';
        kw = '';
        setChip('*');
        apply();
        if (q) q.focus();
      });
    }

    if (sortBtn) {
      sortBtn.addEventListener('click', function () {
        var cur = sortBtn.getAttribute('data-dir') === 'asc' ? 'asc' : 'desc';
        var next = cur === 'asc' ? 'desc' : 'asc';
        sortBtn.setAttribute('data-dir', next);
        var label = sortBtn.querySelector('.sort-label');
        if (label) label.textContent = next === 'desc' ? '↓ 新到舊' : '↑ 舊到新';

        // Reorder year blocks
        var ordered = sections.slice().sort(function (a, b) {
          var ya = parseInt(a.getAttribute('data-year') || '0', 10);
          var yb = parseInt(b.getAttribute('data-year') || '0', 10);
          return next === 'desc' ? yb - ya : ya - yb;
        });
        for (var i = 0; i < ordered.length; i++) list.insertBefore(ordered[i], emptyEl);

        // Reorder rows inside each block by date
        for (var j = 0; j < ordered.length; j++) {
          var host = ordered[j].querySelector('.rows');
          if (!host) continue;
          var rows = Array.prototype.slice.call(host.querySelectorAll('.archive-row'));
          rows.sort(function (a, b) {
            var da = a.getAttribute('data-date') || '';
            var db = b.getAttribute('data-date') || '';
            return next === 'desc' ? db.localeCompare(da) : da.localeCompare(db);
          });
          for (var k = 0; k < rows.length; k++) host.appendChild(rows[k]);
        }
        sections = ordered;
        markFirst();
      });
    }

    // ⌘K / Ctrl+K focuses search
    document.addEventListener('keydown', function (e) {
      if ((e.metaKey || e.ctrlKey) && e.key && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (q) {
          q.focus();
          q.select();
        }
      }
    });

    // The bar sticks to the top of the window on desktop; give it its edge only while it is stuck.
    if (bar) {
      var desktop = window.matchMedia('(min-width: 761px)');
      var queued = false;
      var update = function () {
        queued = false;
        var stuck = desktop.matches && bar.getBoundingClientRect().top <= 0.5 && window.scrollY > 0;
        bar.classList.toggle('is-stuck', stuck);
      };
      var onScroll = function () {
        if (queued) return;
        queued = true;
        window.requestAnimationFrame(update);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      update();
    }

    markFirst();
  })();
</script>
