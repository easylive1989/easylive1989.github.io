---
import { loadConfig } from '../lib/config';

interface Props {
  /** Page-specific title; the site title is appended unless it is the site title itself. */
  title?: string;
  /** The name appended to the title: the site's own (the room) unless a page passes the blog's. */
  siteTitle?: string;
  description?: string;
  ogImage?: string;
  /** Fetch the type sheet off the critical path: the room's door paints without it, and study.js redraws its lettering once it is in. */
  deferType?: boolean;
}

const config = loadConfig();
const BASE = import.meta.env.BASE_URL;
const {
  siteTitle = config.site.title,
  description = config.site.description,
  ogImage,
  deferType = false,
} = Astro.props;
const title = Astro.props.title ?? siteTitle;
const TYPE = 'https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;600;700&family=Source+Serif+4:ital,wght@0,400;0,600;0,700;1,400&display=swap';

const pageTitle = title === siteTitle ? title : `${title} | ${siteTitle}`;
const canonicalUrl = new URL(Astro.url.pathname, config.site.url);
const image = ogImage ?? new URL(`${BASE}${config.author.avatar}`, config.site.url).href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="icon" type="image/x-icon" href={`${BASE}favicon.ico`} />
<link rel="icon" type="image/png" sizes="32x32" href={`${BASE}favicon-32x32.png`} />
<link rel="icon" type="image/png" sizes="16x16" href={`${BASE}favicon-16x16.png`} />
<link rel="canonical" href={canonicalUrl.href} />
<link rel="alternate" type="application/rss+xml" title={config.site.title} href="/rss.xml" />

<!-- Broadsheet design-system type: Source Serif 4 for Latin, Noto Serif TC for long-form Chinese -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
{deferType ? (
  <>
    <!-- a print sheet is fetched at low priority and blocks nothing; switched on once it is in -->
    <link id="type-sheet" rel="stylesheet" href={TYPE} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={TYPE} /></noscript>
  </>
) : (
  <link rel="stylesheet" href={TYPE} />
)}

<!-- Open Graph -->
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalUrl.href} />
<meta property="og:image" content={image} />

<!-- Twitter -->
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />

<!-- Cloudflare Web Analytics -->
<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "3c65582aa3704510be97c0638201eaa0"}'></script>

<!-- The service worker (public/sw.js), registered once the page has loaded so it never competes with it; then told what this page
     fetched before it was there, so a second visit already finds those in its cache. Not in dev, where nothing is hashed -->
{import.meta.env.PROD && (
  <script is:inline>
    if ('serviceWorker' in navigator) addEventListener('load', () => {
      navigator.serviceWorker.register('/sw.js').then(() => navigator.serviceWorker.ready).then((r) => {
        r.active?.postMessage({ page: location.href, warm: performance.getEntriesByType('resource').map((e) => e.name) });
      }).catch(() => {});
    });
  </script>
)}
