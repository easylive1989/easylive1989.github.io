---
import { loadConfig } from '../lib/config';

interface Props {
  /** Page-specific title; the site's name is appended unless it is the site's name itself. */
  title?: string;
  /** The name appended to the title. */
  siteTitle?: string;
  description?: string;
  /** A picture for link previews: a path on this site or a full URL. Without one, the author's portrait. */
  ogImage?: string;
  /** For an article: when it was written and last changed, and the category it sits under. */
  article?: { published: string; modified?: string; section?: string };
}

const config = loadConfig();
const BASE = import.meta.env.BASE_URL;
const { siteTitle = config.site.title, description = config.site.description, ogImage, article } = Astro.props;
const title = Astro.props.title ?? siteTitle;
// Three voices (desk.css): LXGW WenKai TC, a brush-written 楷, for the blog's name; Noto Serif TC (300 is the ink study's
// headings) with Source Serif 4 for the Latin, for reading and headings; Noto Sans TC for the chrome (tabs, chips, dates)
const TYPE = 'https://fonts.googleapis.com/css2?family=LXGW+WenKai+TC:wght@700&family=Noto+Sans+TC:wght@400;500&family=Noto+Serif+TC:wght@300;400;600;700&family=Source+Serif+4:ital,wght@0,400;0,600;0,700;1,400&display=swap';

const pageTitle = title === siteTitle ? title : `${title} | ${siteTitle}`;
const canonicalUrl = new URL(Astro.url.pathname, config.site.url);
const image = new URL(ogImage ?? `${BASE}${config.author.avatar}`, config.site.url).href;
// a picture of the page's own shows large in a preview; the portrait stays a small square beside the title
const twitterCard = ogImage ? 'summary_large_image' : 'summary';
---

<meta charset="utf-8" />
<!-- Only the CSP rules that restrict nothing the site loads: no plugins, no <base> or form pointed elsewhere, http upgraded to https.
     Scripts, styles and images are left open (inline scripts, Google Fonts). GitHub Pages sends no headers -->
<meta http-equiv="Content-Security-Policy" content="object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="icon" type="image/x-icon" href={`${BASE}favicon.ico`} />
<link rel="icon" type="image/png" sizes="32x32" href={`${BASE}favicon-32x32.png`} />
<link rel="icon" type="image/png" sizes="16x16" href={`${BASE}favicon-16x16.png`} />
<link rel="canonical" href={canonicalUrl.href} />
<link rel="alternate" type="application/rss+xml" title={config.site.title} href="/rss.xml" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href={TYPE} />

<!-- Open Graph -->
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:site_name" content={siteTitle} />
<meta property="og:locale" content="zh_TW" />
<meta property="og:url" content={canonicalUrl.href} />
<meta property="og:image" content={image} />
{article && (
  <>
    <meta property="article:published_time" content={article.published} />
    {article.modified && <meta property="article:modified_time" content={article.modified} />}
    {article.section && <meta property="article:section" content={article.section} />}
    <meta property="article:author" content={config.author.name} />
  </>
)}

<!-- Twitter -->
<meta name="twitter:card" content={twitterCard} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />

<!-- Cloudflare Web Analytics -->
<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "3c65582aa3704510be97c0638201eaa0"}'></script>
