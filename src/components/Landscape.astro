---
/**
 * The ink landscape across the top of every blog page, painted as ink wash: far peaks pale in the mist, the red sun with its
 * birds, a range of steep peaks with pines on their tops, and a near rock with a pine leaning out of it. Each is a layer of its
 * own, its ink darkest along the ridge and fading down into mist, its edges roughened like a brush's. `near` is the same scene
 * with the camera pushed in: the about page's view. The 推進山水 transition (deskFx.js) moves the layers from one to the other,
 * so the two pages join up. Over it hangs Taichung's weather: clear, cloudy, fog, rain, a thunderstorm, or night.
 */
interface Props {
  near?: boolean;
}

const { near = false } = Astro.props;

// The weather over it follows Taichung's (layouts/weather.js sets html[data-weather]; desk.css shows the layers for it).
// The ink rain: 34 strokes, and 24 more that fall only in a thunderstorm. Where each falls and how fast is fixed.
const rain = Array.from({ length: 58 }, (_, i) => ({
  storm: i >= 34,
  style: `left:${(i * 37 + (i >= 34 ? 17 : 0)) % 100}%;height:${18 + ((i * 7) % 16)}px;--d:${(1.1 + (i % 5) * 0.16).toFixed(2)}s;animation-delay:${(-((i * 0.29) % 2)).toFixed(2)}s`,
}));
---

<div class:list={['ink-land', { 'is-near': near }]} aria-hidden="true">
  <svg class="l-far" viewBox="0 0 1440 520" preserveAspectRatio="xMaxYMax slice">
    <defs>
      <linearGradient id="ink-far" gradientUnits="userSpaceOnUse" x1="0" y1="110" x2="0" y2="410"><stop offset="0" stop-color="#2c2b28" stop-opacity="0.17"></stop><stop offset="0.55" stop-color="#2c2b28" stop-opacity="0.07"></stop><stop offset="1" stop-color="#2c2b28" stop-opacity="0"></stop></linearGradient>
      <filter id="brush-far" x="-5%" y="-5%" width="110%" height="110%"><feTurbulence type="fractalNoise" baseFrequency="0.025" numOctaves="3" seed="3"></feTurbulence><feDisplacementMap in="SourceGraphic" scale="9"></feDisplacementMap><feGaussianBlur stdDeviation="1.2"></feGaussianBlur></filter>
    </defs>
    <g filter="url(#brush-far)">
      <path d="M0 384 C80 344 140 334 200 350 C260 364 300 326 360 320 C420 314 470 352 520 362 L560 420 L0 420 Z" fill="url(#ink-far)"></path>
      <path d="M560 400 C600 330 612 262 640 250 C668 240 674 302 700 302 C722 222 760 150 792 148 C826 146 842 230 868 236 C892 200 930 120 968 116 C1006 112 1020 200 1046 210 C1070 170 1100 150 1128 156 C1160 162 1172 230 1196 236 C1222 196 1250 170 1280 176 C1310 182 1332 240 1360 244 C1390 214 1420 196 1440 200 L1440 420 L560 420 Z" fill="url(#ink-far)"></path>
    </g>
    <!-- a band of mist across the foot of the far range -->
    <rect x="0" y="300" width="1440" height="80" fill="#f2f0eb" opacity="0.35"></rect>
  </svg>
  <svg class="l-sun" viewBox="0 0 1440 520" preserveAspectRatio="xMaxYMax slice">
    <circle class="w-sun" cx="1188" cy="176" r="24" fill="#c8402f"></circle>
    <!-- at night the sun is a pale moon in a halo -->
    <g class="w-moon">
      <defs><radialGradient id="moon-halo" cx="50%" cy="50%" r="50%"><stop offset="0.45" stop-color="#f7f4ec" stop-opacity="0.9"></stop><stop offset="1" stop-color="#f7f4ec" stop-opacity="0"></stop></radialGradient></defs>
      <circle cx="1188" cy="176" r="56" fill="url(#moon-halo)"></circle>
      <circle cx="1188" cy="176" r="22" fill="#e4e0d4" stroke="#b9b5ad" stroke-width="1"></circle>
      <circle cx="1196" cy="170" r="20" fill="#f2f0eb" opacity="0.55"></circle>
    </g>
    <path class="w-birds" d="M968 148 q7 -6 14 0 q7 -6 14 0 M1012 132 q6 -5 12 0 q6 -5 12 0 M1050 156 q5 -4 10 0 q5 -4 10 0" fill="none" stroke="#2c2b28" stroke-width="1.4" opacity="0.38"></path>
    <!-- an overcast sky: a grey wash from the top that fades before the hills, and in it streaks of ink cloud, drifting -->
    <g class="w-sky">
      <defs>
        <linearGradient id="sky-dim" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2c2b28" stop-opacity="1"></stop><stop offset="0.72" stop-color="#2c2b28" stop-opacity="0"></stop></linearGradient>
        <linearGradient id="sky-cloud" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="380"><stop offset="0" stop-color="#ffffff" stop-opacity="1"></stop><stop offset="0.6" stop-color="#ffffff" stop-opacity="0.6"></stop><stop offset="1" stop-color="#ffffff" stop-opacity="0"></stop></linearGradient>
        <filter id="sky-ink" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
          <feTurbulence type="fractalNoise" baseFrequency="0.0022 0.011" numOctaves="4" seed="5" result="n"></feTurbulence>
          <feColorMatrix in="n" type="matrix" values="0 0 0 0 0.17  0 0 0 0 0.17  0 0 0 0 0.16  0 0 0 1.8 -0.62" result="ink"></feColorMatrix>
          <feComposite in="ink" in2="SourceGraphic" operator="in"></feComposite>
          <feGaussianBlur stdDeviation="2.5"></feGaussianBlur>
        </filter>
      </defs>
      <rect class="w-dim" x="0" y="0" width="1440" height="520" fill="url(#sky-dim)"></rect>
      <g class="w-cloud"><rect x="-240" y="0" width="1920" height="400" fill="url(#sky-cloud)" filter="url(#sky-ink)"></rect></g>
    </g>
  </svg>
  <svg class="l-mid" viewBox="0 0 1440 520" preserveAspectRatio="xMaxYMax slice">
    <defs>
      <linearGradient id="ink-mid" gradientUnits="userSpaceOnUse" x1="0" y1="236" x2="0" y2="470"><stop offset="0" stop-color="#2c2b28" stop-opacity="0.32"></stop><stop offset="0.5" stop-color="#2c2b28" stop-opacity="0.12"></stop><stop offset="1" stop-color="#2c2b28" stop-opacity="0"></stop></linearGradient>
      <filter id="brush-mid" x="-5%" y="-5%" width="110%" height="110%"><feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="3" seed="8"></feTurbulence><feDisplacementMap in="SourceGraphic" scale="7"></feDisplacementMap><feGaussianBlur stdDeviation="0.6"></feGaussianBlur></filter>
    </defs>
    <g filter="url(#brush-mid)">
      <path d="M700 470 C730 420 742 330 772 318 C800 308 806 380 826 392 C840 330 858 250 896 240 C934 232 940 330 958 350 C976 300 1000 268 1030 270 C1066 274 1070 360 1092 372 C1110 300 1140 262 1176 264 C1214 266 1224 350 1246 360 C1270 330 1300 316 1330 322 C1366 330 1380 380 1404 390 C1420 372 1430 366 1440 364 L1440 480 L700 480 Z" fill="url(#ink-mid)"></path>
      <!-- the ridgeline, darker, in a dry brush -->
      <path d="M700 470 C730 420 742 330 772 318 C800 308 806 380 826 392 C840 330 858 250 896 240 C934 232 940 330 958 350 C976 300 1000 268 1030 270 C1066 274 1070 360 1092 372 C1110 300 1140 262 1176 264 C1214 266 1224 350 1246 360 C1270 330 1300 316 1330 322 C1366 330 1380 380 1404 390 C1420 372 1430 366 1440 364" fill="none" stroke="#2c2b28" stroke-width="2" stroke-opacity="0.32" stroke-linecap="round"></path>
      <!-- wrinkle strokes down the faces -->
      <path d="M884 262 l-14 42 M902 284 l-10 34 M916 300 l-6 22 M1022 290 l-10 32 M1040 300 l-6 22 M1166 284 l-12 38 M1184 296 l-8 28 M1322 340 l-8 26" fill="none" stroke="#2c2b28" stroke-width="1.6" stroke-opacity="0.22" stroke-linecap="round"></path>
    </g>
    <!-- pines on the tops, a few dabs each -->
    <g stroke="#2c2b28" stroke-opacity="0.42" stroke-width="2" stroke-linecap="round" fill="none">
      <path d="M896 241 v-15 M889 234 h14 M891 229 h10 M893 225 h6"></path>
      <path d="M906 245 v-11 M901 240 h10 M903 236 h6"></path>
      <path d="M1176 265 v-15 M1169 258 h14 M1171 253 h10 M1173 249 h6"></path>
      <path d="M1030 271 v-12 M1025 265 h10 M1027 261 h6"></path>
    </g>
  </svg>
  <!-- 小書齋: a little study by the water at the foot of the far hills on the left, beside the page's words, half lost in a drift
       of mist: its roof and a pine over it in mid ink, its walls going into the mist, and below it a landing and a skiff coming
       out of the mist, faint. At night its lamp glows through the mist. -->
  <svg class="l-study" viewBox="0 0 340 210">
    <defs>
      <linearGradient id="study-roof" gradientUnits="userSpaceOnUse" x1="0" y1="72" x2="0" y2="100"><stop offset="0" stop-color="#2c2b28" stop-opacity="0.46"></stop><stop offset="1" stop-color="#2c2b28" stop-opacity="0.16"></stop></linearGradient>
      <linearGradient id="study-drift" gradientUnits="userSpaceOnUse" x1="0" y1="104" x2="0" y2="150"><stop offset="0" stop-color="#f2f0eb" stop-opacity="0"></stop><stop offset="0.45" stop-color="#f2f0eb" stop-opacity="0.92"></stop><stop offset="0.75" stop-color="#f2f0eb" stop-opacity="0.92"></stop><stop offset="1" stop-color="#f2f0eb" stop-opacity="0.2"></stop></linearGradient>
      <linearGradient id="study-side" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#fff" stop-opacity="0"></stop><stop offset="0.25" stop-color="#fff"></stop><stop offset="0.8" stop-color="#fff"></stop><stop offset="1" stop-color="#fff" stop-opacity="0"></stop></linearGradient>
      <mask id="study-edge" maskUnits="userSpaceOnUse" x="0" y="0" width="340" height="210"><rect width="340" height="210" fill="url(#study-side)"></rect></mask>
      <radialGradient id="study-lamp" cx="50%" cy="50%" r="50%"><stop offset="0" stop-color="#f3d9a0" stop-opacity="0.75"></stop><stop offset="1" stop-color="#f3d9a0" stop-opacity="0"></stop></radialGradient>
      <filter id="study-blur" x="-10%" y="-40%" width="120%" height="180%"><feGaussianBlur stdDeviation="5"></feGaussianBlur></filter>
      <filter id="brush-study" x="-5%" y="-10%" width="110%" height="120%"><feTurbulence type="fractalNoise" baseFrequency="0.05" numOctaves="2" seed="21"></feTurbulence><feDisplacementMap in="SourceGraphic" scale="3"></feDisplacementMap><feGaussianBlur stdDeviation="0.3"></feGaussianBlur></filter>
    </defs>
    <g filter="url(#brush-study)">
      <!-- a pine behind it, in the near rock's dabs -->
      <path d="M100 118 C98 96 104 80 96 60" fill="none" stroke="#2c2b28" stroke-width="2.6" stroke-opacity="0.4" stroke-linecap="round"></path>
      <ellipse cx="96" cy="58" rx="20" ry="5.5" fill="#2c2b28" fill-opacity="0.36"></ellipse>
      <ellipse cx="112" cy="70" rx="16" ry="4.5" fill="#2c2b28" fill-opacity="0.32"></ellipse>
      <ellipse cx="84" cy="76" rx="12" ry="4" fill="#2c2b28" fill-opacity="0.3"></ellipse>
      <!-- the study: a back wall with a round window, its posts, a scholar at his book -->
      <rect x="128" y="98" width="64" height="30" fill="#2c2b28" fill-opacity="0.06"></rect>
      <circle cx="142" cy="110" r="7" fill="none" stroke="#2c2b28" stroke-width="1.1" stroke-opacity="0.28"></circle>
      <path d="M128 98 v30 M192 98 v30" stroke="#2c2b28" stroke-width="2" stroke-opacity="0.38" stroke-linecap="round"></path>
      <circle cx="170" cy="106" r="2.8" fill="#2c2b28" fill-opacity="0.42"></circle>
      <path d="M164 120 C164 113 166 110 170 109 C174 110 176 113 176 120 Z" fill="#2c2b28" fill-opacity="0.28"></path>
      <!-- the thatched roof, its eaves turned up at the ends -->
      <path d="M110 99 C119 99 124 96 129 89 L141 76 C155 72 167 72 181 76 L192 89 C197 96 202 99 212 98 C196 103 124 103 110 99 Z" fill="#f2f0eb"></path>
      <path d="M110 99 C119 99 124 96 129 89 L141 76 C155 72 167 72 181 76 L192 89 C197 96 202 99 212 98 C196 103 124 103 110 99 Z" fill="url(#study-roof)"></path>
      <path d="M110 99 C119 99 124 96 129 89 L141 76 C155 72 167 72 181 76 L192 89 C197 96 202 99 212 98" fill="none" stroke="#2c2b28" stroke-width="1.7" stroke-opacity="0.44" stroke-linecap="round"></path>
    </g>
    <!-- the drift of mist across its walls, and the lamp glowing through it at night -->
    <rect x="-20" y="104" width="380" height="46" fill="url(#study-drift)" filter="url(#study-blur)"></rect>
    <ellipse class="w-lamp" cx="168" cy="114" rx="26" ry="14" fill="url(#study-lamp)"></ellipse>
    <!-- the shore, the landing and the skiff below the mist, and the water -->
    <g mask="url(#study-edge)" filter="url(#brush-study)">
      <path d="M40 160 C90 156 150 154 196 156 C206 157 212 160 216 166" fill="none" stroke="#2c2b28" stroke-width="1.3" stroke-opacity="0.18" stroke-linecap="round"></path>
      <g stroke="#2c2b28" stroke-linecap="round" fill="none">
        <path d="M196 162 h84" stroke-width="2" stroke-opacity="0.28"></path>
        <path d="M216 162 v10 M240 162 v9 M264 162 v10 M280 162 v8" stroke-width="1.4" stroke-opacity="0.24"></path>
        <path d="M30 182 h70 M130 188 h56 M210 184 h80 M80 198 h60 M180 202 h70" stroke-width="1.1" stroke-opacity="0.11"></path>
      </g>
      <path d="M262 176 C272 182 298 182 310 174 C298 178 274 178 262 176 Z" fill="#2c2b28" fill-opacity="0.26"></path>
    </g>
  </svg>
  <svg class="l-near" viewBox="0 0 1440 520" preserveAspectRatio="xMaxYMax slice">
    <defs>
      <linearGradient id="ink-near" gradientUnits="userSpaceOnUse" x1="0" y1="414" x2="0" y2="520"><stop offset="0" stop-color="#2c2b28" stop-opacity="0.46"></stop><stop offset="1" stop-color="#2c2b28" stop-opacity="0.06"></stop></linearGradient>
      <filter id="brush-near" x="-5%" y="-10%" width="110%" height="120%"><feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="3" seed="12"></feTurbulence><feDisplacementMap in="SourceGraphic" scale="6"></feDisplacementMap></filter>
    </defs>
    <!-- faint strokes on the water below the far hills -->
    <path d="M190 468 h130 M370 484 h96 M110 498 h70 M520 476 h60" fill="none" stroke="#2c2b28" stroke-width="1.4" stroke-opacity="0.12" stroke-linecap="round"></path>
    <g filter="url(#brush-near)">
      <path d="M980 520 C1008 474 1038 442 1078 436 C1110 432 1122 460 1150 456 C1190 450 1210 420 1250 418 C1300 416 1322 452 1360 450 C1400 448 1420 430 1440 428 L1440 520 Z" fill="url(#ink-near)"></path>
      <path d="M980 520 C1008 474 1038 442 1078 436 C1110 432 1122 460 1150 456 C1190 450 1210 420 1250 418 C1300 416 1322 452 1360 450 C1400 448 1420 430 1440 428" fill="none" stroke="#2c2b28" stroke-width="2.6" stroke-opacity="0.5" stroke-linecap="round"></path>
      <path d="M1068 450 l-10 26 M1090 446 l-6 20 M1262 432 l-8 24 M1280 436 l-5 16" fill="none" stroke="#2c2b28" stroke-width="1.8" stroke-opacity="0.32" stroke-linecap="round"></path>
      <!-- a pine leaning out from the rock -->
      <path d="M1252 420 C1246 398 1254 380 1238 362 C1228 350 1214 348 1198 352" fill="none" stroke="#2c2b28" stroke-width="4" stroke-opacity="0.62" stroke-linecap="round"></path>
      <path d="M1240 372 C1252 362 1262 360 1272 362" fill="none" stroke="#2c2b28" stroke-width="2.6" stroke-opacity="0.55" stroke-linecap="round"></path>
      <ellipse cx="1196" cy="349" rx="28" ry="7" fill="#2c2b28" fill-opacity="0.5"></ellipse>
      <ellipse cx="1222" cy="337" rx="21" ry="6" fill="#2c2b28" fill-opacity="0.46"></ellipse>
      <ellipse cx="1270" cy="358" rx="18" ry="5" fill="#2c2b28" fill-opacity="0.44"></ellipse>
      <ellipse cx="1180" cy="342" rx="12" ry="4" fill="#2c2b28" fill-opacity="0.4"></ellipse>
    </g>
  </svg>
  <i class="l-mist"></i>
  <!-- the weather over the whole scene: night's wash, fog drifting, ink rain, a lightning flash -->
  <i class="w-night"></i>
  <div class="w-fog"><i></i><i></i><i></i></div>
  <div class="w-rain">{rain.map((r) => <i class:list={{ 'w-storm': r.storm }} style={r.style}></i>)}</div>
  <i class="w-flash"></i>
</div>
