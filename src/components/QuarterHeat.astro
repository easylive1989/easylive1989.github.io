---
import '../styles/heat.css';

interface Props {
  /** What the figure shows, read out in place of its cells. */
  label: string;
  /** How many fell in each quarter of a year. A year left out is a column of empty cells, not a missing one. */
  counts: Record<number, number[]>;
  /** The first and the last year across the top. */
  from: number;
  to: number;
  /** What a cell counts, for its tooltip: 本, 篇. */
  unit: string;
}

const { label, counts, from, to, unit } = Astro.props;
const years = Array.from({ length: Math.max(1, to - from + 1) }, (_, i) => from + i);
// the quarters by their seasons
const SEASONS = ['春', '夏', '秋', '冬'];
const max = Math.max(1, ...Object.values(counts).flat());
// four shades of ink over the empty cell, by how near a quarter comes to the busiest one
const level = (v: number) => (v <= 0 ? 0 : Math.min(4, Math.max(1, Math.round((v / max) * 4))));
---

<figure class="heat" style={`--n:${years.length}`}>
  <div class="heat-grid" role="img" aria-label={label}>
    <span></span>
    {years.map((y) => <span class="heat-y num">{y}</span>)}
    {SEASONS.map((season, q) => (
      <>
        <span class="heat-q">{season}</span>
        {years.map((y) => {
          const v = counts[y]?.[q] ?? 0;
          return (
            <span class="heat-cell num" data-v={level(v)} title={`${y} ${season} · ${v} ${unit}`}>
              {v > 0 ? v : ''}
            </span>
          );
        })}
      </>
    ))}
  </div>
  <!-- bleeds the washes' edges into the paper, as ink does -->
  <svg class="heat-defs" width="0" height="0" aria-hidden="true">
    <filter id="heat-ink-bleed" x="-20%" y="-20%" width="140%" height="140%">
      <feTurbulence type="fractalNoise" baseFrequency="0.35" numOctaves="2" seed="3" />
      <feDisplacementMap in="SourceGraphic" scale="5" />
      <feGaussianBlur stdDeviation="0.6" />
    </filter>
  </svg>
</figure>
