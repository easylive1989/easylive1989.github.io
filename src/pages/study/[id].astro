---
import NotionRenderer from '../../components/notion/NotionRenderer.astro';
import { getArticle, getAllArticlesForStaticPaths, getBookNotes, getBookNoteBlocks } from '../../lib/data';

// The body of one article, or the notes kept in one book of the reading list, and
// nothing else: the study fetches this when a book is pulled off the shelf or a
// page is picked up from the desk, and typesets it there. The full article page
// still lives at /{category}/{id}/; a book's notes live only here.
export const partial = true;

export async function getStaticPaths() {
  const [paths, notes] = await Promise.all([getAllArticlesForStaticPaths(), getBookNotes()]);
  return [
    ...paths.map((p) => ({ params: { id: p.articleId }, props: { cat: p.categorySlug, book: false } })),
    ...[...notes.keys()].map((id) => ({ params: { id }, props: { cat: '', book: true } })),
  ];
}

const { cat, book } = Astro.props;
const id = Astro.params.id!;
const blocks = book ? await getBookNoteBlocks(id) : (await getArticle(cat, id))?.blocks;
---

{blocks && <NotionRenderer blocks={blocks} />}
