---
import DeskLayout from '../../layouts/DeskLayout.astro';
import { getAllNotes, getNoteBodies } from '../../lib/data';

// The whole 碎碎念 database, newest first. A note with nothing written under its title is
// listed by that title alone.
const [notes, bodies] = await Promise.all([getAllNotes(), getNoteBodies()]);
const sorted = [...notes].sort((a, b) => b.createdTime.localeCompare(a.createdTime));
const BASE = import.meta.env.BASE_URL;

function fmtDate(iso: string): string {
  const d = new Date(iso);
  return `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
}
---

<DeskLayout title="碎碎念" description="零碎的想法，想到就記一筆。" width="reading" crumbs={[{ label: '碎碎念' }]}>
  <section class="paper notes">
    <header class="masthead">
      <div class="rules" aria-hidden="true"><i></i><i></i></div>
      <div class="kicker"><span class="card-kicker">書桌 · 碎碎念</span></div>
      <h1>碎碎念</h1>
      <p class="lede">零碎的想法，想到就記一筆。共 {sorted.length} 則。</p>
    </header>
    {sorted.length === 0 ? (
      <p class="empty">還沒有寫下什麼。</p>
    ) : (
      <ol class="list">
        {sorted.map((n) => (
          <li>
            <time class="num" datetime={n.createdTime}>{fmtDate(n.createdTime)}</time>
            {bodies.has(n.id) ? <a href={`${BASE}notes/${n.id}/`}>{n.title}</a> : <span>{n.title}</span>}
          </li>
        ))}
      </ol>
    )}
  </section>
</DeskLayout>

<style>
  .notes { padding: 48px 56px 56px; }
  .notes h1 { font-family: var(--font-reading); font-size: 40px; }
  .list { list-style: none; margin: var(--space-6) 0 0; padding: 0; display: flex; flex-direction: column; }
  .list li { display: flex; gap: var(--space-4); align-items: baseline; padding: 10px 0; border-bottom: 1px solid var(--color-divider); font-size: 17px; }
  .list time { flex: none; font-size: 13px; color: var(--color-neutral-700); }
  .list a { color: var(--color-text); text-decoration: none; }
  .list a:hover { color: var(--color-accent-700); text-decoration: underline; text-underline-offset: 3px; }
  .list span { color: var(--color-neutral-700); }
  .empty { font-style: italic; color: var(--color-neutral-700); }
  @media (max-width: 640px) {
    .notes { padding: 28px 20px 36px; }
    .notes h1 { font-size: 30px; }
    .list li { flex-direction: column; gap: 2px; }
  }
</style>
