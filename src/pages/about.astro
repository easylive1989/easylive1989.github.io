---
import DeskLayout from '../layouts/DeskLayout.astro';
import { loadConfig } from '../lib/config';
import { MY_BOOK, IRONMAN, TALKS, TAGLINE, channels } from '../lib/profile';

// Who Paul is, for the blog: his portrait in the moon gate, then the book, the Ironman runs and the talks that stand on the
// room's display shelves, and where to find him. The landscape behind is pushed in (Landscape.astro `near`): 推進山水 ends here.
const config = loadConfig();
const BASE = import.meta.env.BASE_URL;
const runs = [...IRONMAN].reverse(); // newest first here; the room keeps them oldest first for its bears
const away = (url: string) => (url.startsWith('mailto:') ? {} : { target: '_blank', rel: 'noopener' });
---

<DeskLayout title="關於我" description={config.author.bio} width="reading" tab="about" landscape="near">
  <article class="about">
    <header class="ab-hero">
      <div class="ab-gate">
        <img src={`${BASE}${config.author.avatar}`} alt={config.author.name} width="220" height="220" />
      </div>
      <div class="ab-who">
        <p class="ab-hi">Hi, I'm</p>
        <h1>{config.author.name}</h1>
        <p class="ab-tag"><i aria-hidden="true"></i>{TAGLINE}</p>
      </div>
    </header>

    <p class="ab-bio">{config.author.bio}</p>

    <section class="ab-sec" aria-labelledby="ab-book">
      <h2 id="ab-book"><i aria-hidden="true"></i>我出的書</h2>
      <div class="ab-book">
        <img src={`${BASE}${MY_BOOK.cover}`} alt={`《${MY_BOOK.title}》書封`} width="360" height="504" loading="lazy" />
        <div>
          <h3>{MY_BOOK.title}</h3>
          <p class="ab-by">{MY_BOOK.author}著</p>
          <p class="ab-blurb">{MY_BOOK.blurb}</p>
          <a class="ab-buy" href={MY_BOOK.url} {...away(MY_BOOK.url)}>到天瓏書局購買 ↗</a>
        </div>
      </div>
    </section>

    <section class="ab-sec" aria-labelledby="ab-ironman">
      <h2 id="ab-ironman"><i aria-hidden="true"></i>iThome 鐵人賽</h2>
      <ul class="ab-list">
        {runs.map(([year, result, series, url, prize]) => (
          <li>
            <span class="ab-y num">{year}</span>
            <span class="ab-t"><a href={url} {...away(url)}>{series} ↗</a><span>連續三十天、一天一篇</span></span>
            <span class:list={['ab-r', { win: prize }]}>{result}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="ab-sec" aria-labelledby="ab-talks">
      <h2 id="ab-talks"><i aria-hidden="true"></i>演講</h2>
      <ul class="ab-list">
        {TALKS.map(([year, title, host, url]) => (
          <li>
            <span class="ab-y num">{year}</span>
            <span class="ab-t"><a href={url} {...away(url)}>{title} ↗</a><span>{host}</span></span>
          </li>
        ))}
      </ul>
    </section>

    <section class="ab-sec" aria-labelledby="ab-find">
      <h2 id="ab-find"><i aria-hidden="true"></i>找到我</h2>
      <div class="ab-ch">
        {channels(config).map(([name, label, url]) => (
          <a href={url} {...away(url)}><b>{name}</b><span>{label}</span></a>
        ))}
      </div>
    </section>
  </article>
</DeskLayout>

<style>
  .about { max-width: 1000px; margin: 0 auto; }

  /* — the portrait in a moon gate — */
  .ab-hero { display: flex; flex-wrap: wrap; align-items: center; gap: 56px; padding-top: 32px; }
  .ab-gate {
    flex: none;
    width: 220px;
    height: 220px;
    margin: 22px;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: 0 0 0 18px var(--stone), 0 0 0 21px #7a766f, 0 16px 36px 20px rgba(0, 0, 0, 0.14);
  }
  .ab-gate img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .ab-who { flex: 1 1 300px; min-width: 0; }
  .ab-hi { margin: 0; font-size: 15px; letter-spacing: 0.24em; color: var(--muted); }
  .ab-who h1 { margin: 10px 0 16px; font-size: 66px; font-weight: 300; line-height: 1; letter-spacing: 0.06em; }
  .ab-tag { display: flex; align-items: center; gap: 10px; margin: 0; font-size: 16px; letter-spacing: 0.14em; color: var(--stone); }
  .ab-tag i { width: 8px; height: 8px; border-radius: 50%; background: var(--sun); }
  .ab-bio { max-width: 40em; margin: 48px 0 0; font-size: 19px; line-height: 2.05; }

  /* — sections: a red dot and the name in the left column, the content on the right — */
  .ab-sec {
    display: grid;
    grid-template-columns: 170px minmax(0, 1fr);
    gap: 28px;
    margin-top: 56px;
    padding-top: 22px;
    border-top: 1px solid rgba(44, 43, 40, 0.2);
  }
  .ab-sec h2 {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    align-self: start;
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0.3em;
    color: var(--stone);
  }
  .ab-sec h2 i { flex: none; width: 7px; height: 7px; border-radius: 50%; background: var(--sun); }

  /* the book, on a stone tablet */
  .ab-book {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 28px;
    padding: 28px;
    color: var(--plaster);
    background: var(--stone);
    border-radius: 2px;
    box-shadow: 0 6px 0 #3a3833;
  }
  .ab-book img { flex: none; width: 140px; height: auto; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35); }
  .ab-book > div { flex: 1 1 260px; min-width: 0; }
  .ab-book h3 { margin: 0 0 8px; font-size: 22px; font-weight: 600; line-height: 1.45; color: var(--plaster); }
  .ab-by { margin: 0 0 14px; font-size: 14px; letter-spacing: 0.08em; color: #d6d3cb; }
  .ab-blurb { margin: 0 0 20px; font-size: 16px; line-height: 1.85; }
  .ab-buy {
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding: 0 20px;
    font-size: 15px;
    color: var(--ink);
    background: var(--plaster);
    border-radius: 22px;
    text-decoration: none;
  }
  .ab-buy:hover { color: var(--sun); }

  /* the Ironman runs and the talks */
  .ab-list { list-style: none; margin: 0; padding: 0; }
  .ab-list li {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr) auto;
    gap: 18px;
    align-items: center;
    padding: 16px 0;
    border-bottom: 1px solid rgba(44, 43, 40, 0.1);
  }
  .ab-list li:last-child { border-bottom: 0; }
  .ab-y { font-size: 28px; font-weight: 300; line-height: 1; }
  .ab-t { min-width: 0; }
  .ab-t a { font-size: 18px; font-weight: 600; text-decoration: none; }
  .ab-t span { display: block; margin-top: 4px; font-size: 13px; color: var(--muted); }
  .ab-r {
    display: inline-flex;
    align-items: center;
    height: 30px;
    padding: 0 14px;
    font-size: 13px;
    letter-spacing: 0.1em;
    white-space: nowrap;
    color: var(--plaster);
    background: var(--ink);
    border-radius: 15px;
  }
  .ab-r.win { color: #fbfaf7; background: var(--sun); }

  /* where to find him */
  .ab-ch { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .ab-ch a {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
    min-height: 56px;
    padding: 0 22px;
    background: rgba(250, 249, 246, 0.8);
    border: 1px solid rgba(44, 43, 40, 0.2);
    border-radius: 28px;
    text-decoration: none;
  }
  .ab-ch b { flex: none; width: 72px; font-size: 12px; font-weight: 400; letter-spacing: 0.14em; color: var(--muted); }
  .ab-ch span { min-width: 0; font-size: 16px; overflow-wrap: anywhere; }
  .ab-ch a:hover { border-color: var(--ink); }

  @media (max-width: 760px) {
    .ab-sec { grid-template-columns: minmax(0, 1fr); gap: 16px; margin-top: 40px; }
    .ab-ch { grid-template-columns: minmax(0, 1fr); }
  }

  @media (max-width: 600px) {
    .ab-hero { gap: 34px; padding-top: 12px; justify-content: center; text-align: center; }
    .ab-gate { width: 180px; height: 180px; }
    .ab-who h1 { font-size: 44px; }
    .ab-tag { justify-content: center; }
    .ab-bio { font-size: 17px; line-height: 1.95; }
    .ab-book { padding: 20px; }
    .ab-list li { grid-template-columns: 48px minmax(0, 1fr); gap: 12px; }
    .ab-y { font-size: 22px; }
    .ab-r { grid-column: 2; justify-self: start; }
  }
</style>
