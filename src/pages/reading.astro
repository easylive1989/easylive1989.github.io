---
import DeskLayout from '../layouts/DeskLayout.astro';
import '../styles/reading.css';
import { getAllBooks, getBookNotes } from '../lib/data';
import {
  bookStatus,
  bookFinishedYear,
  bookFinishedQuarter,
  coverGradient,
  normaliseKind,
  categoryRank,
} from '../lib/bookCover';
import type { Book } from '../lib/notion';

const allBooks = await getAllBooks();
const noted = await getBookNotes(); // the books with notes in them get a page of their own
const BASE = import.meta.env.BASE_URL;

const totalCount = allBooks.length;
const readCount = allBooks.filter((b) => bookStatus(b) === 'read').length;
const wishlistCount = allBooks.filter((b) => bookStatus(b) === 'unstarted').length;

const currentBooks = allBooks.filter((b) => bookStatus(b) === 'reading');
const hasCurrent = currentBooks.length > 0;

interface Shelf {
  /** Stable key: the year, or "wish". */
  id: string;
  year?: number;
  /** Big line on the brass plate. */
  label: string;
  count: number;
  books: Book[];
  peak?: boolean;
  note?: string;
  wish?: boolean;
}

// Newest first; a book still being read counts as the newest of its year.
const finishedKey = (b: Book) => b.finishedDate ?? '9999';

const shelfBooks = allBooks.filter((b) => bookStatus(b) !== 'unstarted');
const wishlistBooks = allBooks
  .filter((b) => bookStatus(b) === 'unstarted')
  .sort((a, b) => a.title.localeCompare(b.title, 'zh-Hant'));
const byYear = new Map<number, Book[]>();
for (const b of shelfBooks) {
  const y = bookFinishedYear(b) ?? new Date().getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(b);
}
for (const items of byYear.values()) {
  items.sort((a, b) => finishedKey(b).localeCompare(finishedKey(a)));
}
let peakYear = 0;
let peakCount = 0;
for (const [year, items] of byYear) {
  if (items.length > peakCount) {
    peakCount = items.length;
    peakYear = year;
  }
}

const yearShelves: Shelf[] = Array.from(byYear.entries())
  .sort((a, b) => b[0] - a[0])
  .map(([year, items]) => ({
    id: String(year),
    year,
    label: String(year),
    count: items.length,
    books: items,
    peak: year === peakYear && items.length > 0,
  }));

const wishShelf: Shelf | null =
  wishlistBooks.length > 0
    ? { id: 'wish', label: '想讀', count: wishlistBooks.length, books: wishlistBooks, wish: true }
    : null;

const views = [
  { id: 'read', shelves: yearShelves, emptyText: '書架還是空的。' },
  { id: 'wish', shelves: wishShelf ? [wishShelf] : [], emptyText: '還沒加任何想讀的書。' },
];

// Heatmap data
const heatYears = Array.from(byYear.keys()).filter((y) => y > 0).sort();
const oldestYear = heatYears[0] ?? new Date().getFullYear();
const newestYear = heatYears[heatYears.length - 1] ?? new Date().getFullYear();
const heatRange: number[] = [];
for (let y = oldestYear; y <= newestYear; y++) heatRange.push(y);

const heatBucket: Record<number, [number, number, number, number]> = {};
for (const b of allBooks) {
  if (bookStatus(b) !== 'read') continue;
  const y = bookFinishedYear(b);
  const q = bookFinishedQuarter(b);
  if (y == null || q == null) continue;
  heatBucket[y] ??= [0, 0, 0, 0];
  heatBucket[y][q - 1]++;
}
const maxCell = Math.max(1, ...Object.values(heatBucket).flatMap((row) => row));
function heatLevel(v: number): number {
  if (v <= 0) return 0;
  return Math.min(4, Math.max(1, Math.round((v / maxCell) * 4)));
}

// Raw Notion 類型 counts — books appear in every category they're tagged with.
// The chips run in the shelving order of the categories, not by how many books each has.
const rawCatCounts = new Map<string, number>();
for (const b of allBooks) {
  for (const c of b.categories) {
    if (!c) continue;
    rawCatCounts.set(c, (rawCatCounts.get(c) ?? 0) + 1);
  }
}
const chipsData = Array.from(rawCatCounts.entries())
  .sort((a, b) => categoryRank(a[0]) - categoryRank(b[0]) || b[1] - a[1])
  .map(([name, count]) => ({
    name,
    count,
    dotClass: `dot-${normaliseKind(name)}`,
  }));

// Books on a real shelf are never quite the same height. Every cover keeps the
// column width but takes one of a few aspect ratios (3:4 is the tallest) and
// stands on the plank, so the skyline wavers a little.
const COVER_RATIOS = [0.75, 0.78, 0.8, 0.765, 0.82, 0.77];
function coverRatio(title: string): number {
  let h = 0;
  for (let i = 0; i < title.length; i++) h = (h * 31 + title.charCodeAt(i)) | 0;
  return COVER_RATIOS[Math.abs(h) % COVER_RATIOS.length];
}

const heatLabel = (y: number, v: number) => `${y} · ${v} 本`;
const yearsSpan = Math.max(0, newestYear - oldestYear + 1);
---

<DeskLayout title="書架" width="wide" tab="reading">
  <div class="reading" id="top">

    <!-- 1 · masthead sheet (+ the card for whatever is being read right now) -->
    <div class:list={['rd-top', { 'has-current': hasCurrent }]}>
      <section class="paper masthead rd-masthead" aria-labelledby="rd-h1">
        <div class="rules" aria-hidden="true"><i></i><i></i></div>
        <div class="rd-mast-grid">
          <div class="rd-mast-main">
            <div class="card-kicker kicker">Reading list · 書單</div>
            <h1 id="rd-h1">讀過的<em>書</em></h1>
            <p class="lede">隨手記錄看過的書。技術書幫我換腦袋、非虛構幫我換視角、小說幫我換情緒。</p>
            <dl class="rd-stats">
              <div class="rd-stat"><dt class="l">total</dt><dd class="n num">{totalCount}</dd></div>
              <div class="rd-stat"><dt class="l">read</dt><dd class="n num">{readCount}</dd></div>
              <div class="rd-stat"><dt class="l">wishlist</dt><dd class="n num">{wishlistCount}</dd></div>
              <div class="rd-stat"><dt class="l">years</dt><dd class="n num">{yearsSpan}</dd></div>
            </dl>
          </div>

          <div class="rd-heat">
            <div class="rd-heat-title">每季讀完的書</div>
            <div class="heat-grid" role="img" aria-label="每年每季讀完的書數量熱度圖">
              <span></span>
              {['Q1', 'Q2', 'Q3', 'Q4'].map((q) => <span class="heat-q">{q}</span>)}
              {heatRange.map((y) => {
                const row = heatBucket[y] ?? [0, 0, 0, 0];
                return (
                  <>
                    <span class="heat-y num">{y}</span>
                    {row.map((v) => (
                      <span class="heat-cell num" data-v={heatLevel(v)} title={heatLabel(y, v)}>
                        {v > 0 ? v : ''}
                      </span>
                    ))}
                  </>
                );
              })}
            </div>
            <div class="heat-legend" aria-hidden="true">
              <span>少</span>
              <i class="heat-cell" data-v="0"></i>
              <i class="heat-cell" data-v="1"></i>
              <i class="heat-cell" data-v="2"></i>
              <i class="heat-cell" data-v="3"></i>
              <i class="heat-cell" data-v="4"></i>
              <span>多</span>
            </div>
          </div>
        </div>
      </section>

      {hasCurrent && (
        <aside class="paper rd-current" id="current-tile" aria-label="正在讀">
          <div class="cur-kicker">
            ● 正在讀{currentBooks.length > 1 ? ` · ${currentBooks.length} 本` : ''}
          </div>
          <div class="cur-slides">
            <div class="cur-track">
              {currentBooks.map((book, i) => {
                const cv = coverGradient(book);
                return (
                  <div class="cur-slide" data-slide-index={i}>
                    <div class="cur-book">
                      {book.coverUrl ? (
                        <div class="cur-cover cover--img" aria-hidden="true">
                          <img src={book.coverUrl} alt="" loading="lazy" draggable="false" />
                        </div>
                      ) : (
                        <div
                          class="cur-cover"
                          style={`background:linear-gradient(135deg, ${cv.from} 0%, ${cv.to} 100%)`}
                          aria-hidden="true"
                        >
                          <span class="pub">{book.categories[0] ?? ''}</span>
                          <span class="ttl">{book.title}</span>
                        </div>
                      )}
                      <div class="cur-meta">
                        <h2>{book.title}</h2>
                        {book.categories[0] && (
                          <div class="cur-cat">
                            <i class={`dot dot-${cv.kind}`}></i>
                            {book.categories[0]}
                          </div>
                        )}
                        <div class="cur-progress">
                          <div class="cur-progress-head">
                            <span class="card-kicker">進度</span>
                            <span class="pct num">{book.progress}%</span>
                          </div>
                          <div
                            class="cur-bar"
                            role="progressbar"
                            aria-valuemin="0"
                            aria-valuemax="100"
                            aria-valuenow={book.progress}
                            aria-label={`${book.title} 閱讀進度`}
                          >
                            <div class="cur-fill" style={`width:${book.progress}%`}></div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
          {currentBooks.length > 1 && (
            <div class="cur-dots" role="tablist" aria-label="切換正在讀的書">
              {currentBooks.map((_, i) => (
                <button
                  type="button"
                  class="cur-dot"
                  data-dot-index={i}
                  aria-current={i === 0 ? 'true' : undefined}
                  aria-label={`第 ${i + 1} 本`}
                ></button>
              ))}
            </div>
          )}
        </aside>
      )}
    </div>

    <!-- 2 · filter strip -->
    <section class="paper rd-filter" aria-label="篩選書單">
      <div class="rd-frow">
        <label class="rd-search">
          <span class="ico" aria-hidden="true">⌕</span>
          <input id="reading-q" class="input" type="search" placeholder="搜尋書名 / 類型…" autocomplete="off" />
          <kbd class="kbd" id="reading-kbd">⌘K</kbd>
        </label>
        <button class="btn btn-secondary rd-sort" id="reading-sort" type="button" data-dir="desc">
          <span class="sort-pre">排序：</span><span class="sort-label">↓ 最近讀完</span>
        </button>
        <div class="seg" role="tablist" aria-label="已讀或想讀" id="reading-view">
          <button type="button" role="tab" data-view="read" aria-current="true">
            已讀 <span class="seg-ct num">{shelfBooks.length}</span>
          </button>
          <button type="button" role="tab" data-view="wish" aria-current="false">
            想讀 <span class="seg-ct num">{wishlistBooks.length}</span>
          </button>
        </div>
      </div>
      <div class="rd-frow rd-chips" id="reading-chips" role="group" aria-label="類型">
        <button type="button" class="chip tag tag-accent" data-cat="*" aria-current="true">
          全部 <span class="ct num">{totalCount}</span>
        </button>
        {chipsData.map((c) => (
          <button type="button" class="chip tag tag-outline" data-cat={c.name} aria-current="false">
            <i class={`dot ${c.dotClass}`}></i>
            {c.name}
            <span class="ct num">{c.count}</span>
          </button>
        ))}
      </div>
    </section>

    <!-- 3 · the bookcase -->
    <section class="bookcase" id="reading-shelves" data-view="read" aria-label="書架">
      <div class="bc-back">
        {views.map((v) => (
          <div class="rd-view" data-view-content={v.id} hidden={v.id !== 'read'}>
            {v.shelves.length === 0 && (
              <div class="rd-shelf rd-shelf--empty">
                <p class="rd-empty">{v.emptyText}</p>
              </div>
            )}
            {v.shelves.map((s) => (
              <section
                class:list={['year-section', { 'is-wish': s.wish }]}
                data-year={s.year ?? ''}
                data-shelf={s.id}
              >
                <h2 class="shelf-plate plate-brass">
                  <span class="pl-main num">{s.label}</span>
                  <span class="pl-count num" data-total={s.count}>{s.count} 本</span>
                  {(s.peak || s.note) && <span class="pl-note">{s.peak ? '★ 高峰年' : s.note}</span>}
                </h2>
                <div class="rd-shelf">
                  {s.books.map((b) => {
                    const cv = coverGradient(b);
                    const status = bookStatus(b);
                    const rawCats = b.categories.filter(Boolean);
                    const rawCat = rawCats[0] ?? '';
                    const ar = coverRatio(b.title);
                    return (
                      <div
                        class={`book is-${status}`}
                        data-title={b.title}
                        data-cats={b.categories.join('|')}
                        data-date={b.finishedDate ?? ''}
                        data-progress={b.progress}
                        title={b.title}
                      >
                        <div class="slot">
                          {b.coverUrl ? (
                            <div class="cover cover--img" style={`--ar:${ar}`}>
                              <img src={b.coverUrl} alt={b.title} loading="lazy" draggable="false" />
                            </div>
                          ) : (
                            <div
                              class="cover"
                              style={`--ar:${ar};background:linear-gradient(135deg, ${cv.from} 0%, ${cv.to} 100%)`}
                            >
                              <span class="pub">{rawCat}</span>
                              <span class="ttl">{b.title}</span>
                            </div>
                          )}
                          {status === 'reading' && <i class="ribbon" aria-hidden="true"></i>}
                        </div>
                        <div class="cap">
                          {status === 'reading' && <span class="now">● 閱讀中</span>}
                          {noted.has(b.id) ? <a class="t" href={`${BASE}reading/${b.id}/`}>{b.title}</a> : <span class="t">{b.title}</span>}
                          {rawCats.length > 0 && (
                            <span class="ks">
                              {rawCats.slice(0, 2).map((c) => (
                                <span class="k">
                                  <i class={`dot dot-${normaliseKind(c)}`}></i>
                                  {c}
                                </span>
                              ))}
                            </span>
                          )}
                        </div>
                      </div>
                    );
                  })}
                </div>
              </section>
            ))}
          </div>
        ))}

        <div class="rd-shelf rd-shelf--empty" id="reading-empty" hidden>
          <p class="rd-empty">沒有符合的書。</p>
        </div>
      </div>
    </section>
  </div>

  <script is:inline>
    (function () {
      var host = document.getElementById('reading-shelves');
      if (!host) return;
      var q = document.getElementById('reading-q');
      var kbd = document.getElementById('reading-kbd');
      var chips = document.getElementById('reading-chips');
      var sortBtn = document.getElementById('reading-sort');
      var view = document.getElementById('reading-view');
      var emptyEl = document.getElementById('reading-empty');
      var readContainer = host.querySelector('[data-view-content="read"]');
      var wishContainer = host.querySelector('[data-view-content="wish"]');
      var sections = readContainer ? Array.from(readContainer.querySelectorAll('.year-section')) : [];
      var wishSections = wishContainer ? Array.from(wishContainer.querySelectorAll('.year-section')) : [];
      var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      var activeCat = '*';
      var kw = '';
      var currentView = 'read';

      // The shortcut hint should match the keyboard in front of you.
      if (kbd && !/Mac|iPhone|iPad/.test(navigator.platform || '')) kbd.textContent = 'Ctrl K';

      function bookMatches(book) {
        var catsRaw = book.getAttribute('data-cats') || '';
        var cats = catsRaw ? catsRaw.split('|') : [];
        var title = (book.getAttribute('data-title') || '').toLowerCase();
        var catsLower = catsRaw.toLowerCase();
        var catOk = activeCat === '*' || cats.indexOf(activeCat) >= 0;
        var kwOk = !kw || title.indexOf(kw) >= 0 || catsLower.indexOf(kw) >= 0;
        return catOk && kwOk;
      }

      function apply() {
        var anyVisible = false;
        var list = currentView === 'read' ? sections : wishSections;
        list.forEach(function (sec) {
          var books = Array.from(sec.querySelectorAll('.book'));
          var visible = 0;
          books.forEach(function (book) {
            var show = bookMatches(book);
            book.hidden = !show;
            if (show) visible++;
          });
          sec.hidden = visible === 0;
          if (visible > 0) anyVisible = true;
          var ct = sec.querySelector('.pl-count');
          if (ct) {
            var total = books.length;
            ct.textContent = visible === total ? total + ' 本' : visible + ' / ' + total + ' 本';
          }
        });
        // A view with no shelves at all already says so itself.
        if (emptyEl) emptyEl.hidden = anyVisible || list.length === 0;
      }

      if (q) {
        q.addEventListener('input', function () {
          kw = q.value.trim().toLowerCase();
          apply();
        });
      }

      if (chips) {
        var chipEls = Array.from(chips.querySelectorAll('.chip'));
        chipEls.forEach(function (c) {
          c.addEventListener('click', function () {
            chipEls.forEach(function (x) {
              x.setAttribute('aria-current', 'false');
              x.classList.remove('tag-accent');
              x.classList.add('tag-outline');
            });
            c.setAttribute('aria-current', 'true');
            c.classList.remove('tag-outline');
            c.classList.add('tag-accent');
            activeCat = c.getAttribute('data-cat') || '*';
            apply();
          });
        });
      }

      if (sortBtn) {
        sortBtn.addEventListener('click', function () {
          if (currentView !== 'read' || !readContainer) return;
          var cur = sortBtn.getAttribute('data-dir') === 'asc' ? 'asc' : 'desc';
          var next = cur === 'asc' ? 'desc' : 'asc';
          sortBtn.setAttribute('data-dir', next);
          var label = sortBtn.querySelector('.sort-label');
          if (label) label.textContent = next === 'desc' ? '↓ 最近讀完' : '↑ 最舊讀完';
          var ordered = sections.slice().sort(function (a, b) {
            var ya = parseInt(a.getAttribute('data-year') || '0', 10);
            var yb = parseInt(b.getAttribute('data-year') || '0', 10);
            return next === 'desc' ? yb - ya : ya - yb;
          });
          ordered.forEach(function (sec) { readContainer.appendChild(sec); });
          // A book still being read has no date yet: it is the newest.
          var key = function (el) { return el.getAttribute('data-date') || '9999'; };
          ordered.forEach(function (sec) {
            var shelf = sec.querySelector('.rd-shelf');
            if (!shelf) return;
            var books = Array.from(shelf.querySelectorAll('.book'));
            books.sort(function (a, b) {
              return next === 'desc' ? key(b).localeCompare(key(a)) : key(a).localeCompare(key(b));
            });
            books.forEach(function (bk) { shelf.appendChild(bk); });
          });
        });
      }

      if (view) {
        var viewBtns = Array.from(view.querySelectorAll('button[data-view]'));
        viewBtns.forEach(function (b) {
          b.addEventListener('click', function () {
            var v = b.getAttribute('data-view') || 'read';
            if (v === currentView) return;
            viewBtns.forEach(function (x) { x.setAttribute('aria-current', 'false'); });
            b.setAttribute('aria-current', 'true');
            currentView = v;
            host.setAttribute('data-view', v);
            if (readContainer) readContainer.hidden = v !== 'read';
            if (wishContainer) wishContainer.hidden = v !== 'wish';
            if (sortBtn) sortBtn.hidden = v !== 'read';
            apply();
          });
        });
      }

      document.addEventListener('keydown', function (e) {
        if ((e.metaKey || e.ctrlKey) && e.key && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          if (q) q.focus();
        }
      });

      // Currently-reading carousel
      var currentTile = document.getElementById('current-tile');
      if (currentTile) {
        var track = currentTile.querySelector('.cur-track');
        var slides = Array.from(currentTile.querySelectorAll('.cur-slide'));
        var dots = Array.from(currentTile.querySelectorAll('.cur-dot'));
        if (track && slides.length > 1) {
          var active = 0;
          var timer = null;
          var dragging = false;
          var startX = 0;
          var pointerId = null;
          var INTERVAL_MS = 6000;
          var SWIPE_RATIO = 0.18; // 18% of slide width to commit

          var applyTransform = function (offsetPx, animate) {
            track.style.transition = animate && !reduceMotion ? '' : 'none';
            track.style.transform = 'translateX(calc(' + (-active * 100) + '% + ' + offsetPx + 'px))';
          };
          var show = function (idx) {
            active = (idx + slides.length) % slides.length;
            applyTransform(0, true);
            dots.forEach(function (d, i) {
              if (i === active) d.setAttribute('aria-current', 'true');
              else d.removeAttribute('aria-current');
            });
          };
          var stop = function () { if (timer) { clearInterval(timer); timer = null; } };
          var start = function () {
            stop();
            if (reduceMotion) return; // no unprompted movement
            timer = setInterval(function () { show(active + 1); }, INTERVAL_MS);
          };

          dots.forEach(function (d, i) {
            d.addEventListener('click', function () { show(i); start(); });
          });
          currentTile.addEventListener('mouseenter', stop);
          currentTile.addEventListener('mouseleave', start);

          // Pointer-based swipe (covers mouse + touch + pen)
          track.addEventListener('pointerdown', function (e) {
            if (e.button !== undefined && e.button !== 0) return;
            dragging = true;
            startX = e.clientX;
            pointerId = e.pointerId;
            try { track.setPointerCapture(pointerId); } catch (err) {}
            stop();
          });
          track.addEventListener('pointermove', function (e) {
            if (!dragging) return;
            applyTransform(e.clientX - startX, false);
          });
          var release = function (e) {
            if (!dragging) return;
            dragging = false;
            var delta = e.clientX - startX;
            var w = track.offsetWidth || 1;
            if (Math.abs(delta) > w * SWIPE_RATIO) {
              show(active + (delta < 0 ? 1 : -1));
            } else {
              applyTransform(0, true);
            }
            if (pointerId != null) {
              try { track.releasePointerCapture(pointerId); } catch (err) {}
              pointerId = null;
            }
            start();
          };
          track.addEventListener('pointerup', release);
          track.addEventListener('pointercancel', release);

          applyTransform(0, false);
          start();
        }
      }
    })();
  </script>
</DeskLayout>
