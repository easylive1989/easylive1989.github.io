---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllBooks } from '../lib/data';
import {
  bookStatus,
  bookFinishedYear,
  bookFinishedQuarter,
  coverGradient,
  normaliseKind,
  type BookKind,
} from '../lib/bookCover';
import type { Book } from '../lib/notion';

const BASE = import.meta.env.BASE_URL;
const allBooks = await getAllBooks();

const totalCount = allBooks.length;
const readingCount = allBooks.filter((b) => bookStatus(b) === 'reading').length;
const readCount = allBooks.filter((b) => bookStatus(b) === 'read').length;

const currentBook = allBooks.find((b) => bookStatus(b) === 'reading') ?? null;
const currentCover = currentBook ? coverGradient(currentBook) : null;

interface ShelfYear {
  year: number;
  count: number;
  books: Book[];
  peak: boolean;
}

const byYear = new Map<number, Book[]>();
for (const b of allBooks) {
  const y = bookFinishedYear(b) ?? new Date().getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(b);
}
let peakYear = 0;
let peakCount = 0;
for (const [year, items] of byYear) {
  if (items.length > peakCount) {
    peakCount = items.length;
    peakYear = year;
  }
}
const shelves: ShelfYear[] = Array.from(byYear.entries())
  .sort((a, b) => b[0] - a[0])
  .map(([year, items]) => ({
    year,
    count: items.length,
    books: items,
    peak: year === peakYear && items.length > 0,
  }));

const yearNotes: Record<number, string> = {
  2026: '架構年',
  2025: '雜食年',
  2024: '高峰年',
  2023: '工作轉折',
  2022: '入門年',
  2021: '起點',
  2020: '前夜',
};

// Heatmap data
const heatYears = Array.from(byYear.keys()).filter((y) => y > 0).sort();
const oldestYear = heatYears[0] ?? new Date().getFullYear();
const newestYear = heatYears[heatYears.length - 1] ?? new Date().getFullYear();
const heatRange: number[] = [];
for (let y = oldestYear; y <= newestYear; y++) heatRange.push(y);

const heatBucket: Record<number, [number, number, number, number]> = {};
for (const b of allBooks) {
  if (bookStatus(b) !== 'read') continue;
  const y = bookFinishedYear(b);
  const q = bookFinishedQuarter(b);
  if (y == null || q == null) continue;
  heatBucket[y] ??= [0, 0, 0, 0];
  heatBucket[y][q - 1]++;
}
const maxCell = Math.max(1, ...Object.values(heatBucket).flatMap((row) => row));
function heatLevel(v: number): number {
  if (v <= 0) return 0;
  return Math.min(4, Math.max(1, Math.round((v / maxCell) * 4)));
}

const kindMeta: Record<BookKind, { name: string; dotClass: string }> = {
  tech:   { name: '技術',   dotClass: 'dot-tech' },
  design: { name: '設計',   dotClass: 'dot-design' },
  non:    { name: '非虛構', dotClass: 'dot-non' },
  fic:    { name: '小說',   dotClass: 'dot-fic' },
  other:  { name: '其他',   dotClass: 'dot-other' },
};

// Raw Notion 類型 counts — books appear in every category they're tagged with.
const rawCatCounts = new Map<string, number>();
for (const b of allBooks) {
  for (const c of b.categories) {
    if (!c) continue;
    rawCatCounts.set(c, (rawCatCounts.get(c) ?? 0) + 1);
  }
}
const chipsData = Array.from(rawCatCounts.entries())
  .sort((a, b) => b[1] - a[1])
  .map(([name, count]) => ({
    name,
    count,
    dotClass: kindMeta[normaliseKind(name)].dotClass,
  }));
---

<BaseLayout title="書單" hideFooter bodyClass="reading-page-body">
  <div class="reading-page" id="top">

    <!-- Top nav -->
    <header class="tile reading-topnav">
      <div class="topnav-left">
        <a class="back" href={BASE}>
          <span>←</span><span>保羅的學習筆記</span>
        </a>
        <span class="topnav-sep">/</span>
        <span style="font-weight:500">書單</span>
      </div>
      <div class="topnav-right">
        <span class="mono">{totalCount} books · since {oldestYear}</span>
      </div>
    </header>

    <!-- Hero + currently reading (side by side) -->
    <div class="grid cols-6 top-row">
      <section class:list={['tile', 'hero', currentBook ? 'span-4' : 'span-6']}>
        <div class="hero-left">
          <div class="label">Reading list · 書單</div>
          <h1 class="hero-h1">讀過的<span class="hi-em">書</span>。</h1>
          <p class="hero-desc">隨手記錄看過的書。技術書幫我換腦袋、非虛構幫我換視角、小說幫我換情緒。</p>
          <div class="stats-row">
            <div><div class="stat-n" style="color:var(--bento-accent)">{totalCount}</div><div class="stat-l">total</div></div>
            <div><div class="stat-n" style="color:var(--bento-accent-2)">{readingCount}</div><div class="stat-l">reading</div></div>
            <div><div class="stat-n" style="color:var(--bento-accent-3)">{readCount}</div><div class="stat-l">read</div></div>
            <div><div class="stat-n" style="color:var(--bento-pink)">{Math.max(0, newestYear - oldestYear + 1)}</div><div class="stat-l">years</div></div>
          </div>
        </div>
        <div class="hero-right">
          <div class="heatmap-head">
            <div class="label">每季讀完的書</div>
          </div>
          <div class="heatmap">
            <div class="heatmap-row">
              <span class="yr"></span>
              <div class="heatmap-cells">
                {['Q1', 'Q2', 'Q3', 'Q4'].map((q) => (
                  <span class="qhead">{q}</span>
                ))}
              </div>
            </div>
            {heatRange.map((y) => {
              const row = heatBucket[y] ?? [0, 0, 0, 0];
              return (
                <div class="heatmap-row">
                  <span class="yr">{y}</span>
                  <div class="heatmap-cells">
                    {row.map((v) => (
                      <span class="cell" data-v={heatLevel(v)} title={`${y} · ${v} 本`}></span>
                    ))}
                  </div>
                </div>
              );
            })}
          </div>
          <div class="heatmap-legend">
            <span>少</span>
            <span class="cell" data-v="0"></span>
            <span class="cell" data-v="1"></span>
            <span class="cell" data-v="2"></span>
            <span class="cell" data-v="3"></span>
            <span class="cell" data-v="4"></span>
            <span>多</span>
          </div>
        </div>
      </section>

      {currentBook && (
        <section class="tile current span-2">
          <span class="current-chip">● 正在讀</span>
          <div class="current-book">
            {currentBook.coverUrl ? (
              <div class="book-spine book-spine--image" aria-hidden="true">
                <img src={currentBook.coverUrl} alt="" loading="lazy" />
              </div>
            ) : (
              <div class="book-spine" aria-hidden="true">
                <span class="br">{currentBook.categories[0] ?? ''}</span>
                <strong>{currentBook.title}</strong>
              </div>
            )}
            <div class="current-meta">
              <h2>{currentBook.title}</h2>
              {currentBook.categories[0] && (
                <div class="subtopic">{currentBook.categories[0]}</div>
              )}
              <div class="current-progress">
                <div class="current-progress-head">
                  <span>進度</span>
                  <span class="pct">{currentBook.progress}%</span>
                </div>
                <div class="current-progress-bar">
                  <div class="current-progress-fill" style={`width:${currentBook.progress}%`}></div>
                </div>
              </div>
            </div>
          </div>
        </section>
      )}
    </div>

    <!-- Filter bar -->
    <section class="tile filterbar">
      <div class="filter-row">
        <div class="search">
          <span class="search-icon">⌕</span>
          <input id="reading-q" type="search" placeholder="搜尋書名 / 類型..." autocomplete="off" />
          <span class="kbd">⌘K</span>
        </div>
        <button class="sort-pill" id="reading-sort" type="button" data-dir="desc">
          <span style="color:var(--bento-sub)">排序：</span>
          <span class="sort-label">↓ 最近讀完</span>
        </button>
        <div class="view-toggle" role="tablist" id="reading-view">
          <button type="button" data-view="shelf" aria-current="true">書架</button>
          <button type="button" data-view="list">列表</button>
        </div>
      </div>
      <div class="filter-row chips" id="reading-chips">
        <button class="chip" data-cat="*" aria-current="true">全部 <span class="ct">{totalCount}</span></button>
        {chipsData.map((c) => (
          <button class="chip" data-cat={c.name}>
            <span class={`dot-cat ${c.dotClass}`}></span>
            {c.name}
            <span class="ct">{c.count}</span>
          </button>
        ))}
      </div>
    </section>

    <!-- Shelves -->
    <section class="tile tile--flush" id="reading-shelves">
      {shelves.map((s) => (
        <div class="year-section" data-year={s.year}>
          <div class="year-side">
            <div>
              <div class="yr-n">{s.year}</div>
              <div class="yr-l">{s.count} 本</div>
              {s.peak ? (
                <div class="yr-badge peak">★ 高峰年</div>
              ) : (
                yearNotes[s.year] && <div class="yr-badge">{yearNotes[s.year]}</div>
              )}
            </div>
          </div>
          <div class="shelf">
            {s.books.map((b) => {
              const cv = coverGradient(b);
              const status = bookStatus(b);
              const cat = kindMeta[cv.kind];
              const rawCat = b.categories[0] ?? '';
              return (
                <a
                  class={`book is-${status}`}
                  href="#"
                  data-title={b.title}
                  data-cats={b.categories.join('|')}
                  data-date={b.finishedDate ?? ''}
                  data-progress={b.progress}
                  title={b.title}
                >
                  {b.coverUrl ? (
                    <div class="book-cover book-cover--image">
                      <img src={b.coverUrl} alt={b.title} loading="lazy" />
                    </div>
                  ) : (
                    <div
                      class="book-cover"
                      style={`background:linear-gradient(135deg, ${cv.from} 0%, ${cv.to} 100%)`}
                    >
                      <span class="pub">{rawCat}</span>
                      <span class="title">{b.title}</span>
                    </div>
                  )}
                  <div class="book-meta">
                    <span class="book-title">{b.title}</span>
                    {rawCat && (
                      <div class="book-stats">
                        <span class="book-tag">
                          <span class={`dot-cat ${cat.dotClass}`}></span>
                          {rawCat}
                        </span>
                      </div>
                    )}
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      ))}
      <div class="shelves-empty" id="reading-empty" hidden>沒有符合的書。</div>
    </section>

    <!-- Footer -->
    <footer class="tile reading-footer">
      <span>paul-learning.dev · © {new Date().getFullYear()} Paul Wu · built with Astro</span>
      <a href="#top" class="mono back-top">↑ back to top</a>
    </footer>
  </div>

  <script is:inline>
    (function () {
      if (window.__readingAbort) window.__readingAbort.abort();

      function setupReading() {
        if (window.__readingAbort) window.__readingAbort.abort();
        const ctrl = new AbortController();
        window.__readingAbort = ctrl;
        const signal = ctrl.signal;

        const host = document.getElementById('reading-shelves');
        if (!host) return;
        const q = document.getElementById('reading-q');
        const chips = document.getElementById('reading-chips');
        const sortBtn = document.getElementById('reading-sort');
        const view = document.getElementById('reading-view');
        const emptyEl = document.getElementById('reading-empty');
        const sections = Array.from(host.querySelectorAll('.year-section'));

        let activeCat = '*';
        let kw = '';

        function apply() {
          let anyVisible = false;
          for (const sec of sections) {
            const books = Array.from(sec.querySelectorAll('.book'));
            let visible = 0;
            for (const book of books) {
              const catsRaw = book.getAttribute('data-cats') || '';
              const cats = catsRaw ? catsRaw.split('|') : [];
              const title = (book.getAttribute('data-title') || '').toLowerCase();
              const catsLower = catsRaw.toLowerCase();
              const catOk = activeCat === '*' || cats.indexOf(activeCat) >= 0;
              const kwOk = !kw || title.indexOf(kw) >= 0 || catsLower.indexOf(kw) >= 0;
              const show = catOk && kwOk;
              book.style.display = show ? '' : 'none';
              if (show) visible++;
            }
            sec.style.display = visible > 0 ? '' : 'none';
            if (visible > 0) anyVisible = true;
          }
          if (emptyEl) emptyEl.hidden = anyVisible;
        }

        if (q) {
          q.addEventListener('input', () => {
            kw = q.value.trim().toLowerCase();
            apply();
          }, { signal });
        }

        if (chips) {
          chips.querySelectorAll('.chip').forEach((c) => {
            c.addEventListener('click', () => {
              chips.querySelectorAll('.chip').forEach((x) => x.setAttribute('aria-current', 'false'));
              c.setAttribute('aria-current', 'true');
              activeCat = c.getAttribute('data-cat') || '*';
              apply();
            }, { signal });
          });
        }

        if (sortBtn) {
          sortBtn.addEventListener('click', () => {
            const cur = sortBtn.getAttribute('data-dir') === 'asc' ? 'asc' : 'desc';
            const next = cur === 'asc' ? 'desc' : 'asc';
            sortBtn.setAttribute('data-dir', next);
            const label = sortBtn.querySelector('.sort-label');
            if (label) label.textContent = next === 'desc' ? '↓ 最近讀完' : '↑ 最舊讀完';
            const ordered = [...sections].sort((a, b) => {
              const ya = parseInt(a.getAttribute('data-year') || '0', 10);
              const yb = parseInt(b.getAttribute('data-year') || '0', 10);
              return next === 'desc' ? yb - ya : ya - yb;
            });
            for (const sec of ordered) host.insertBefore(sec, emptyEl);
            for (const sec of ordered) {
              const shelf = sec.querySelector('.shelf');
              if (!shelf) continue;
              const books = Array.from(shelf.querySelectorAll('.book'));
              books.sort((a, b) => {
                const da = a.getAttribute('data-date') || '';
                const db = b.getAttribute('data-date') || '';
                return next === 'desc' ? db.localeCompare(da) : da.localeCompare(db);
              });
              for (const bk of books) shelf.appendChild(bk);
            }
          }, { signal });
        }

        if (view) {
          view.querySelectorAll('button[data-view]').forEach((b) => {
            b.addEventListener('click', () => {
              const v = b.getAttribute('data-view');
              view.querySelectorAll('button[data-view]').forEach((x) => x.setAttribute('aria-current', 'false'));
              b.setAttribute('aria-current', 'true');
              host.setAttribute('data-view', v || 'shelf');
            }, { signal });
          });
        }

        document.addEventListener('keydown', (e) => {
          if ((e.metaKey || e.ctrlKey) && e.key && e.key.toLowerCase() === 'k') {
            e.preventDefault();
            if (q) q.focus();
          }
        }, { signal });
      }

      document.addEventListener('astro:page-load', setupReading);
    })();
  </script>
</BaseLayout>

<style is:global>
  body.reading-page-body {
    background: var(--bento-bg);
    color: var(--bento-ink);
    font-family: var(--bento-font-sans);
    line-height: 1.55;
  }
  body.reading-page-body main {
    max-width: 1100px;
    padding: 20px;
  }
  body.reading-page-body a { color: inherit; text-decoration: none; }
  body.reading-page-body h1,
  body.reading-page-body h2,
  body.reading-page-body h3,
  body.reading-page-body h4 {
    margin: 0; letter-spacing: -0.025em; font-weight: 600;
  }
  body.reading-page-body p { margin: 0; }
</style>

<style>
  .reading-page {
    color: var(--bento-ink);
    font-family: var(--bento-font-sans);
    display: grid;
    gap: var(--bento-gap);
  }

  /* Grid + span utilities (scoped to reading page; mirror index.astro's tokens) */
  .grid { display: grid; gap: var(--bento-gap); }
  .cols-6 { grid-template-columns: repeat(6, 1fr); }
  .span-2 { grid-column: span 2; }
  .span-4 { grid-column: span 4; }
  .span-6 { grid-column: span 6; }

  .tile {
    background: var(--bento-surface);
    border-radius: var(--bento-r-lg);
    padding: 24px;
    box-shadow: var(--bento-shadow);
    position: relative;
    overflow: hidden;
  }
  .tile--flush { padding: 0; }

  .label {
    font-size: 11px; letter-spacing: .12em; text-transform: uppercase;
    color: var(--bento-sub); font-weight: 500;
  }
  .mono { font-family: var(--bento-font-mono); font-feature-settings: 'zero' on; }

  /* Top nav */
  .reading-topnav {
    display: flex; justify-content: space-between; align-items: center;
    padding: 14px 22px;
  }
  .topnav-left { display: flex; align-items: center; gap: 14px; font-size: 13px; flex-wrap: wrap; }
  .topnav-sep { color: var(--bento-sub); opacity: .55; }
  .back {
    display: inline-flex; align-items: center; gap: 6px;
    color: var(--bento-sub); padding: 4px 10px; border-radius: var(--bento-r-chip);
    transition: background .15s, color .15s;
  }
  .back:hover { background: var(--bento-surface-2); color: var(--bento-ink); }
  .topnav-right { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--bento-sub); }

  /* Hero */
  .top-row { align-items: stretch; }

  .hero {
    display: grid; grid-template-columns: 1fr auto;
    gap: 28px; align-items: end; padding: 28px 30px 26px;
  }
  .hero-h1 { font-size: 50px; line-height: 0.95; letter-spacing: -0.03em; margin-top: 6px; }
  .hi-em {
    color: var(--bento-accent);
    font-family: 'Newsreader', 'Noto Serif TC', Georgia, serif;
    font-style: italic; font-weight: 400;
  }
  .hero-desc { font-size: 15px; color: var(--bento-sub); margin-top: 14px; max-width: 460px; }
  .stats-row { display: flex; gap: 28px; margin-top: 20px; flex-wrap: wrap; }
  .stat-n { font-size: 28px; font-weight: 600; line-height: 1; }
  .stat-l { font-size: 11px; color: var(--bento-sub); letter-spacing: .1em; text-transform: uppercase; margin-top: 4px; }

  .heatmap-head { display: flex; justify-content: flex-end; align-items: baseline; margin-bottom: 8px; }
  .heatmap { display: flex; flex-direction: column; gap: 3px; align-items: flex-end; }
  .heatmap-row { display: flex; align-items: center; gap: 5px; font-family: var(--bento-font-mono); font-size: 9px; color: var(--bento-sub); }
  .yr { width: 30px; color: var(--bento-ink); font-weight: 500; text-align: right; }
  .heatmap-cells { display: flex; gap: 2px; }
  .cell {
    width: 18px; height: 14px; border-radius: 2px;
    background: var(--bento-surface-2);
  }
  .cell[data-v="1"] { background: color-mix(in oklab, var(--bento-accent) 25%, var(--bento-surface)); }
  .cell[data-v="2"] { background: color-mix(in oklab, var(--bento-accent) 50%, var(--bento-surface)); }
  .cell[data-v="3"] { background: color-mix(in oklab, var(--bento-accent) 75%, var(--bento-surface)); }
  .cell[data-v="4"] { background: var(--bento-accent); }
  .heatmap-cells .qhead { width: 18px; text-align: center; color: var(--bento-sub); }
  .heatmap-legend {
    display: flex; gap: 6px; align-items: center; justify-content: flex-end;
    font-size: 9px; color: var(--bento-sub); margin-top: 6px;
  }
  .heatmap-legend .cell { width: 11px; height: 11px; }

  /* Currently reading — right column, dark, minimal */
  .current {
    background: linear-gradient(160deg, #243240 0%, #0e1418 100%);
    color: #fff;
    padding: 28px 28px 32px;
    display: flex; flex-direction: column; gap: 18px;
  }
  :global([data-theme="dark"]) .reading-page .current {
    background: linear-gradient(160deg, #1c2530 0%, #0a0d12 100%);
  }
  .current-chip {
    font-size: 11px; letter-spacing: .12em; text-transform: uppercase;
    color: var(--bento-accent-2); font-weight: 500;
  }
  .current-book {
    flex: 1;
    display: grid; grid-template-columns: 130px 1fr; gap: 22px;
    align-items: center;
    min-height: 0;
  }
  .book-spine {
    width: 130px; aspect-ratio: 3 / 4;
    align-self: center;
    border-radius: 4px 6px 6px 4px;
    background: linear-gradient(135deg, #2a2a2a 0%, #0e0e0e 100%);
    box-shadow: inset 4px 0 0 rgba(0, 0, 0, .35), 0 14px 28px -10px rgba(0, 0, 0, .55);
    display: flex; flex-direction: column; justify-content: space-between;
    padding: 12px 10px 10px; font-family: var(--bento-font-sans);
    position: relative; overflow: hidden;
    color: #fff;
  }
  .book-spine--image { padding: 0; background: #1a1a1a; }
  .book-spine--image img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .book-spine .br { font-size: 9px; letter-spacing: .22em; opacity: .55; }
  .book-spine strong {
    font-size: 15px; line-height: 1.25; font-weight: 600;
    align-self: center; text-align: center;
    flex: 1; display: flex; align-items: center; justify-content: center;
  }

  .current-meta {
    display: flex; flex-direction: column; justify-content: center;
    min-width: 0;
  }
  .current-meta h2 {
    font-family: var(--bento-font-sans);
    font-size: 22px; line-height: 1.15; margin: 0;
    letter-spacing: -0.02em; font-weight: 700;
  }
  .current-meta .subtopic {
    font-size: 13px; color: rgba(255, 255, 255, .55);
    margin-top: 6px;
  }
  .current-progress { display: grid; gap: 6px; margin-top: 16px; }
  .current-progress-head {
    display: flex; justify-content: space-between; align-items: baseline;
    font-size: 12px; color: rgba(255, 255, 255, .65);
    font-family: var(--bento-font-sans);
  }
  .current-progress-head .pct {
    color: var(--bento-accent-2); font-weight: 500;
    font-family: var(--bento-font-mono); font-size: 12px;
  }
  .current-progress-bar { height: 4px; background: rgba(255, 255, 255, .12); border-radius: 3px; overflow: hidden; }
  .current-progress-fill { height: 100%; background: var(--bento-accent-2); border-radius: 3px; }

  /* Filter bar */
  .filterbar { padding: 16px 22px; display: flex; flex-direction: column; gap: 12px; }
  .filter-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .search {
    flex: 1; display: flex; align-items: center; gap: 8px;
    background: var(--bento-surface-2); padding: 9px 14px;
