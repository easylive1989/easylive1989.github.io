---
import DeskLayout from '../../layouts/DeskLayout.astro';
import NotionRenderer from '../../components/notion/NotionRenderer.astro';
import '../../styles/prose.css';
import { loadConfig } from '../../lib/config';
import {
  getArticle,
  getAllArticlesForStaticPaths,
  getArticlesByCategory,
} from '../../lib/data';
import { categorySlug } from '../../lib/category';
import { computeMeta } from '../../lib/articleMeta';

export async function getStaticPaths() {
  const paths = await getAllArticlesForStaticPaths();
  return paths.map((p) => ({
    params: { category: p.categorySlug, slug: p.articleId },
  }));
}

const { category, slug } = Astro.params;
const data = await getArticle(category!, slug!);

if (!data) {
  return Astro.redirect('/404');
}

const { article, blocks, categoryName } = data;
const catSlug = categorySlug(article.category);

const allArticles = await getArticlesByCategory(catSlug);
const currentIndex = allArticles.findIndex((a) => a.id === slug);
const prevArticle = currentIndex < allArticles.length - 1 ? allArticles[currentIndex + 1] : null;
const nextArticle = currentIndex > 0 ? allArticles[currentIndex - 1] : null;

const meta = computeMeta(blocks);

function fmtDate(iso: string): string {
  const d = new Date(iso);
  return `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
}

const config = loadConfig();
const BASE = import.meta.env.BASE_URL;
const articleUrl = (id: string) => `${BASE}${catSlug}/${id}/`;
const threadsUrl = config.author.links.find((l) => l.type === 'threads')?.url ?? '#';
const bioLines = config.author.bio.split('\n');

const crumbs = [
  { label: '文章', href: `${BASE}archive/` },
  { label: categoryName, href: `${BASE}${catSlug}/` },
  { label: article.title },
];
---

<DeskLayout title={article.title} description={article.summary || undefined} width="reading" crumbs={crumbs}>
  <div class="article-progress" aria-hidden="true"><div class="article-progress-fill" id="article-progress-fill"></div></div>

  <article class="paper art">
    <header class="masthead art-masthead">
      <div class="rules" aria-hidden="true"><i></i><i></i></div>
      <div class="kicker art-kicker">
        <a class="card-kicker" href={`${BASE}${catSlug}/`}>{categoryName}</a>
        <span class="art-dot" aria-hidden="true">·</span>
        <time class="num" datetime={article.createdTime}>{fmtDate(article.createdTime)}</time>
        <span class="art-dot" aria-hidden="true">·</span>
        <span class="num">{meta.readMinutes} min read</span>
        <span class="art-dot" aria-hidden="true">·</span>
        <span class="num">{meta.chars.toLocaleString()} 字</span>
      </div>
      <h1 class="art-title">{article.title}</h1>
      <div class="byline">
        <img class="byline-avatar" src={`${BASE}${config.author.avatar}`} alt="" width="32" height="32" />
        <span class="byline-name">{config.author.name}</span>
        <span class="art-dot" aria-hidden="true">·</span>
        <span class="byline-place">Taichung</span>
      </div>
    </header>

    <div class:list={['art-body', { 'art-body--solo': meta.toc.length === 0 }]}>
      {meta.toc.length > 0 && (
        <aside class="art-toc">
          <nav aria-labelledby="art-toc-label" id="article-toc">
            <div class="toc-label" id="art-toc-label">章節</div>
            <div class="toc">
              {meta.toc.map((item, i) => (
                <a
                  href={`#${item.id}`}
                  class:list={['toc-link', { 'toc-link-h3': item.level === 2, 'toc-link-h4': item.level === 3, 'is-active': i === 0 }]}
                >
                  {item.text}
                </a>
              ))}
            </div>
          </nav>
        </aside>
      )}

      <div class="art-main">
        <div class="prose" id="article-prose">
          <NotionRenderer blocks={blocks} />
        </div>

        <div class="end-block">
          <div class="rules" aria-hidden="true"><i></i><i></i></div>
          <p class="end-kicker">— 全文完 —</p>
          <p class="end-text">如果這篇對你有幫助，可以分享給朋友，或追蹤後續更新。我在 Threads 也會貼一些零碎想法。</p>
          <div class="end-actions">
            <a class="btn btn-primary" href={BASE}>← 回書房</a>
            {nextArticle && (
              <a class="btn btn-secondary end-next" href={articleUrl(nextArticle.id)}>下一篇：{nextArticle.title}</a>
            )}
            <a class="btn btn-ghost" href={threadsUrl} target="_blank" rel="noopener">Threads 追蹤 ↗</a>
          </div>
          <div class="end-rule" aria-hidden="true"></div>
        </div>
      </div>
    </div>
  </article>

  <section class="paper author-strip" aria-label="關於作者">
    <img class="strip-avatar" src={`${BASE}${config.author.avatar}`} alt="" width="52" height="52" />
    <div class="strip-text">
      <strong class="strip-name">{config.author.name}</strong>
      <p class="strip-bio">{bioLines.map((line, i) => i === 0 ? line : [<br />, line])}</p>
    </div>
  </section>

  <nav class="pn" aria-label="上一篇與下一篇">
    {prevArticle ? (
      <a class="paper pn-card" href={articleUrl(prevArticle.id)} rel="prev">
        <span class="card-kicker">← 上一篇</span>
        <span class="pn-title">{prevArticle.title}</span>
        <span class="pn-date num">{fmtDate(prevArticle.createdTime)}</span>
      </a>
    ) : <div class="pn-empty"></div>}
    {nextArticle ? (
      <a class="paper pn-card pn-next" href={articleUrl(nextArticle.id)} rel="next">
        <span class="card-kicker">下一篇 →</span>
        <span class="pn-title">{nextArticle.title}</span>
        <span class="pn-date num">{fmtDate(nextArticle.createdTime)}</span>
      </a>
    ) : <div class="pn-empty"></div>}
  </nav>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": article.title,
    "datePublished": article.createdTime,
    "author": { "@type": "Person", "name": config.author.name },
    "publisher": { "@type": "Organization", "name": config.site.title },
  })} />

  <script is:inline>
    (function () {
      var fill = document.getElementById('article-progress-fill');
      var tocLinks = Array.prototype.slice.call(document.querySelectorAll('#article-toc .toc-link'));
      var sections = tocLinks
        .map(function (a) {
          var id = decodeURIComponent((a.getAttribute('href') || '').slice(1));
          return id ? document.getElementById(id) : null;
        })
        .filter(Boolean);
      if (!fill && sections.length === 0) return;

      var active = 0;
      var ticking = false;

      function update() {
        ticking = false;
        var doc = document.documentElement;
        var total = doc.scrollHeight - doc.clientHeight;
        var pct = total > 0 ? Math.min(1, Math.max(0, doc.scrollTop / total)) : 0;
        if (fill) fill.style.transform = 'scaleX(' + pct + ')';

        if (sections.length === 0) return;
        var idx = 0;
        for (var i = 0; i < sections.length; i++) {
          if (sections[i].getBoundingClientRect().top <= 140) idx = i;
        }
        if (idx === active) return;
        tocLinks[active].classList.remove('is-active');
        tocLinks[idx].classList.add('is-active');
        active = idx;
      }

      addEventListener('scroll', function () {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      }, { passive: true });
      addEventListener('resize', update);
      update();
    })();
  </script>
</DeskLayout>

<style>
  /* — reading progress, fixed to the very top — */
  .article-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    z-index: 30;
    pointer-events: none;
  }
  .article-progress-fill {
    height: 100%;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
    will-change: transform;
  }

  /* — the sheet — */
  .art { padding: 48px 56px 56px; }

  .art-masthead { margin-bottom: 44px; }
  .art-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 10px;
    margin-bottom: var(--space-3);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-neutral-700);
  }
  .art-kicker .card-kicker { font-size: 11px; font-weight: 600; text-decoration: none; }
  .art-kicker .card-kicker:hover { text-decoration: underline; text-underline-offset: 3px; }
  .art-dot { color: var(--color-neutral-400); }

  .art-title {
    max-width: 22em;
    font-family: var(--font-reading);
    font-size: 44px;
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  .byline {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-6);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-divider);
    font-size: 13px;
    color: var(--color-neutral-700);
  }
  .byline-avatar {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-md);
    object-fit: cover;
    background: var(--color-surface);
    box-shadow: 0 0 0 1px var(--color-divider);
  }
  .byline-name { font-weight: 700; color: var(--color-text); }

  /* — two columns: contents on the left, prose on the right — */
  .art-body {
    display: grid;
    grid-template-columns: 200px minmax(0, 660px);
    gap: 44px;
    align-items: start;
  }
  .art-body--solo { grid-template-columns: minmax(0, 660px); justify-content: center; }

  .art-toc {
    position: sticky;
    top: 92px;
    max-height: calc(100vh - 92px - 24px);
    overflow-y: auto;
    scrollbar-width: thin;
  }
  .toc-label {
    margin-bottom: var(--space-2);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-neutral-700);
  }
  .toc {
    display: grid;
    gap: 1px;
    border-left: 1px solid var(--color-divider);
  }
  .toc-link {
    display: block;
    margin-left: -1px;
    padding: 5px 0 5px 14px;
    border-left: 2px solid transparent;
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-neutral-700);
    text-decoration: none;
    overflow-wrap: break-word;
    transition: color 0.15s, border-color 0.15s;
  }
  .toc-link:hover { color: var(--color-text); }
  .toc-link.is-active {
    font-weight: 600;
    color: var(--color-accent-700);
    border-left-color: var(--color-accent);
  }
  .toc-link-h3 { padding-left: 26px; font-size: 12.5px; }
  .toc-link-h4 { padding-left: 38px; font-size: 12.5px; }

  /* — end of the article — */
  .end-block { max-width: 660px; margin-top: 3.4em; text-align: center; }
  .end-block .rules { display: flex; flex-direction: column; gap: 2px; margin-bottom: var(--space-4); }
  .end-block .rules i { display: block; background: var(--color-text); }
  .end-block .rules i:first-child { height: 3px; }
  .end-block .rules i:last-child { height: 1px; }
  .end-kicker {
    margin: 0 0 var(--space-2);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-neutral-700);
  }
  .end-text {
    max-width: 30em;
    margin: 0 auto var(--space-4);
    font-size: 15px;
    line-height: 1.75;
    color: color-mix(in srgb, var(--color-text) 78%, transparent);
  }
  .end-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
  }
  .end-next { max-width: 100%; text-align: left; line-height: 1.4; }
  .end-rule { height: 1px; margin-top: var(--space-4); background: var(--color-text); }

  /* — author strip — */
  .author-strip {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-6);
  }
  .strip-avatar {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-md);
    object-fit: cover;
    background: var(--color-surface);
    box-shadow: 0 0 0 1px var(--color-divider);
  }
  .strip-name { display: block; font-size: 16px; line-height: 1.3; }
  .strip-bio { margin: 2px 0 0; font-size: 13px; line-height: 1.6; color: var(--color-neutral-700); }

  /* — previous / next — */
  .pn {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    margin-top: var(--space-6);
  }
  .pn .paper + .paper { margin-top: 0; }
  .pn-card {
    display: grid;
    align-content: start;
    gap: 6px;
    padding: var(--space-4) var(--space-4) var(--space-3);
    color: var(--color-text);
    text-decoration: none;
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .pn-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-lg), 0 0 0 1px var(--color-accent); }
  .pn-next { text-align: right; }
  .pn-title {
    font-size: 17px;
    font-weight: 700;
    line-height: 1.4;
    text-wrap: balance;
  }
  .pn-date { font-size: 12px; color: var(--color-neutral-700); }

  @media (max-width: 860px) {
    .art { padding: 40px 36px 44px; }
    .art-body { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .art-toc { display: none; }
    .end-block { max-width: none; }
  }

  @media (max-width: 760px) {
    .art { --prose-bleed: 16px; padding: 28px 16px 32px; }
    .art-masthead { margin-bottom: var(--space-6); }
    .art-title { font-size: 30px; line-height: 1.25; }
    .byline { margin-top: var(--space-4); }
    .end-block { margin-top: 2.6em; }
    .end-actions { flex-direction: column; align-items: stretch; }
    .end-actions .btn { width: 100%; }
    .author-strip { gap: var(--space-3); padding: var(--space-3) 16px; }
    .pn { grid-template-columns: 1fr; gap: var(--space-3); }
    .pn-empty { display: none; }
    .pn-next { text-align: left; }
  }

  @media (prefers-reduced-motion: reduce) {
    .toc-link, .pn-card { transition: none; }
    .pn-card:hover { transform: none; }
  }

  @media print {
    .article-progress, .art-toc, .end-block, .author-strip, .pn { display: none; }
    .art { padding: 0; }
  }
</style>
