---
import SiteHead from '../components/SiteHead.astro';
import { buildStudyData } from '../lib/study';
import '../styles/broadsheet.css';
import '../styles/prose.css';

// The whole site opens into one full-viewport WebGL room. It owns the document
// (no BaseLayout), and the Notion content it shows is baked in as JSON at build time.
const data = await buildStudyData();
const json = JSON.stringify(data).replace(/</g, '\\u003c');
const BASE = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <SiteHead />
  </head>
  <body class="study-body">
    <div id="stage"></div>
    <div id="vig"></div>
    <div id="grain"></div>
    <div id="intro"><div>推開書房的門……</div></div>
    <div id="toast" class="hud"></div>
    <div id="tip"></div>
    <!-- A book or a page picked up and held in front of the camera -->
    <div id="reader">
      <div class="bd"></div>
      <div id="robj"></div>
      <button class="btn btn-secondary x" data-act="rclose">收起 ✕</button>
      <div id="rnav" class="rnav sheet"></div>
    </div>
    <!-- The CRT, once the camera has pushed in on it -->
    <div id="tvui"><div id="crt"></div><div id="tvbar" class="sheet"></div></div>
    <aside id="panel" aria-live="polite">
      <button class="btn btn-ghost close" data-act="close">收起 ✕</button>
      <div id="pbody"></div>
    </aside>

    <noscript>
      <style is:inline>#intro { display: none; }</style>
      <div class="noscript">
        <p>這裡是一間互動式的 3D 書房，需要開啟 JavaScript 才能走進去。</p>
        <p><a href={`${BASE}reading/`}>書單</a> · <a href={`${BASE}archive/`}>全部文章</a> · <a href="/rss.xml">RSS</a></p>
      </div>
    </noscript>

    <script type="application/json" id="study-data" is:inline set:html={json} />

    <!-- Film grain: a tiny noise canvas, jittered every 90ms -->
    <script is:inline>
      (() => {
        const c = document.createElement('canvas');
        c.width = c.height = 160;
        const x = c.getContext('2d');
        const d = x.createImageData(160, 160);
        // black and white specks on a clear sheet: plain alpha compositing, so the browser never has to
        // read the WebGL frame back for a blend mode
        for (let i = 0; i < d.data.length; i += 4) {
          const v = Math.random() < 0.5 ? 0 : 255;
          d.data[i] = d.data[i + 1] = d.data[i + 2] = v;
          d.data[i + 3] = 255;
        }
        x.putImageData(d, 0, 0);
        const g = document.getElementById('grain');
        g.style.backgroundImage = 'url(' + c.toDataURL() + ')';
        let k = 0;
        setInterval(() => {
          k = (k + 1) % 8;
          g.style.transform = 'translate(' + ((k * 37) % 50) + 'px,' + ((k * 53) % 50) + 'px)';
        }, 90);
      })();
    </script>

    <script>
      import '../scripts/study.js';
    </script>
  </body>
</html>

<style is:global>
  html, body.study-body { margin: 0; height: 100%; overflow: hidden; background: #140e0a; font-family: var(--font-body); color: var(--color-text); }
  /* :not(.btn) keeps these from outranking the button colours (a primary button is cyan with paper text) */
  body.study-body a:not(.btn) { color: var(--color-accent-700); }
  body.study-body a:not(.btn):hover { color: var(--color-accent-800); }
  body.study-body button { font-family: inherit; }

  #stage { position: fixed; inset: 0; }
  #stage canvas { display: block; outline: none; }

  #vig { position: fixed; inset: 0; pointer-events: none; z-index: 4; background: radial-gradient(ellipse at 50% 45%, rgba(0,0,0,0) 50%, rgba(0,0,0,.5) 100%); }
  #grain { position: fixed; inset: -50px; pointer-events: none; z-index: 4; opacity: .035; will-change: transform; }
  /* the low tier (study.js decides) does without the two full-screen overlays */
  body.lite #grain, body.lite #vig { display: none; }

  .hud { position: fixed; z-index: 10; }
  .sheet { background: var(--color-bg); box-shadow: var(--shadow-sm); border-radius: var(--radius-md); }

  body.immerse #tip { opacity: 0 !important; }

  #tip { position: fixed; z-index: 30; pointer-events: none; font-size: 13px; padding: 6px 10px; background: var(--color-text); color: var(--color-bg); border-radius: var(--radius-md); opacity: 0; transition: opacity .15s; white-space: nowrap; }

  #toast { left: 50%; top: var(--space-8); transform: translate(-50%, -8px); padding: var(--space-2) var(--space-4); background: var(--color-text); color: var(--color-bg); font-size: 16px; border-radius: var(--radius-md); box-shadow: var(--shadow-md); opacity: 0; transition: opacity .25s, transform .25s; pointer-events: none; }
  #toast.on { opacity: 1; transform: translate(-50%, 0); }
  body.reading #toast { left: calc(50% - 230px); }

  #intro { position: fixed; inset: 0; z-index: 50; display: grid; place-items: center; background: #140e0a; transition: opacity 1.2s; pointer-events: none; }
  #intro.off { opacity: 0; }
  #intro div { color: var(--color-bg); font-family: var(--font-heading); font-size: 20px; font-style: italic; letter-spacing: .04em; text-align: center; }
  #intro a { color: var(--color-accent-300); }

  .noscript { position: fixed; inset: 0; z-index: 60; display: grid; place-content: center; text-align: center; background: #140e0a; color: var(--color-bg); font-style: italic; }
  .noscript a { color: var(--color-accent-300); }

  /* Reading panel */
  #panel { position: fixed; top: 0; right: 0; bottom: 0; width: 460px; z-index: 20; background: var(--color-bg); box-shadow: var(--shadow-lg); transform: translateX(105%); transition: transform .45s cubic-bezier(.2,.7,.2,1); overflow: auto; box-sizing: border-box; padding: var(--space-8) var(--space-6) var(--space-8) var(--space-8); }
  #panel.open { transform: none; }
  #panel .close { position: absolute; right: var(--space-4); top: var(--space-4); }
  #panel h2 { margin: 6px 0 var(--space-3); font-family: var(--font-heading); font-weight: 600; font-size: 44px; line-height: 1.08; text-wrap: pretty; }
  #panel h3 { margin: 6px 0 var(--space-3); font-family: var(--font-heading); font-weight: 600; font-size: 34px; line-height: 1.15; text-wrap: pretty; }
  #panel .intro { font-size: 17px; font-style: italic; line-height: 1.55; margin: 0 0 var(--space-6); }
  #panel .list { display: flex; flex-direction: column; gap: var(--space-6); }
  #panel .body p { font-size: 17px; line-height: 1.7; margin: 0 0 var(--space-3); text-wrap: pretty; }
  #panel .meta { font-size: 13px; margin: var(--space-4) 0; }
  #panel .rel { display: flex; flex-direction: column; gap: 4px; margin-top: var(--space-6); }
  #panel .rel .lab { font-size: 12px; letter-spacing: .08em; }

  /* — reader: the thing in your hands. Everything inside is sized in --u so it scales with the object — */
  body.study-body { --brass: #b38b4b; --brass-light: #d9b573; --brass-dark: #6e5228; --font-reading: "Source Serif 4", "Noto Serif TC", "Songti TC", "PMingLiU", serif; } /* what prose.css borrows from desk.css */
  #reader { position: fixed; inset: 0; z-index: 25; display: none; }
  #reader.on { display: block; }
  #reader .bd { position: absolute; inset: 0; background: rgba(12,8,5,.62); opacity: 0; transition: opacity .45s; }
  #reader.vis .bd { opacity: 1; }
  #robj { position: absolute; inset: 0; pointer-events: none; }
  .obj { position: absolute; transform-origin: 0 0; pointer-events: auto; }
  #reader .x { position: absolute; right: var(--space-6); top: var(--space-6); opacity: 0; transition: opacity .3s; background: var(--color-bg); }
  #reader .rnav { position: absolute; left: 50%; bottom: var(--space-6); transform: translateX(-50%); display: flex; gap: 6px; align-items: center; padding: 6px; opacity: 0; transition: opacity .3s; white-space: nowrap; }
  #reader.vis .x, #reader.vis .rnav { opacity: 1; }
  .rnav .cnt { font-size: 14px; padding: 0 var(--space-2); white-space: nowrap; font-variant-numeric: tabular-nums; }

  /* a page off the desk: one long sheet you scroll, bookmarks down its edge for the other pages */
  #paper .stack { position: absolute; inset: 0; background: #e4d9c3; box-shadow: var(--shadow-md); border-radius: 2px; }
  #paper .pg { position: absolute; inset: 0; z-index: 2; box-sizing: border-box; overflow: auto; overscroll-behavior: contain; padding: calc(var(--u)*56px) calc(var(--u)*56px) calc(var(--u)*40px); background: radial-gradient(ellipse at 30% 20%, rgba(255,255,255,.35), rgba(255,255,255,0) 60%), #efe8d8; border-radius: 2px; box-shadow: 0 24px 50px rgba(0,0,0,.45), 0 2px 6px rgba(0,0,0,.25); scrollbar-width: thin; }
  #paper .kick { font-size: max(11px, calc(var(--u)*13px)); letter-spacing: .08em; color: var(--color-accent-2-700); }
  #paper h3.ttl { font-family: var(--font-heading); font-weight: 600; font-size: calc(var(--u)*34px); line-height: 1.18; margin: calc(var(--u)*10px) 0 calc(var(--u)*22px); padding-bottom: calc(var(--u)*18px); border-bottom: 1px solid rgba(90,72,55,.3); text-wrap: pretty; }
  #paper .foot { display: flex; justify-content: space-between; gap: var(--space-3); margin-top: calc(var(--u)*40px); padding-top: calc(var(--u)*14px); border-top: 1px solid rgba(90,72,55,.3); font-size: max(11px, calc(var(--u)*13px)); }
  #paper .tab { all: unset; position: absolute; left: calc(100% - var(--u)*12px); width: calc(var(--u)*52px); height: calc(var(--u)*156px); white-space: nowrap; overflow: hidden; box-sizing: border-box; padding: calc(var(--u)*16px) 0 0 calc(var(--u)*13px); writing-mode: vertical-rl; font-size: max(11px, calc(var(--u)*15px)); letter-spacing: .1em; cursor: pointer; background: var(--color-accent-2-100); color: var(--color-accent-2-900); border-radius: 0 3px 3px 0; box-shadow: var(--shadow-sm); z-index: 1; transition: transform .2s, background .2s; }
  #paper .tab:hover { transform: translateX(4px); background: var(--color-accent-2-200); }
  #paper .tab.on { background: var(--color-accent-2-500); color: #f3f2f2; z-index: 3; transform: translateX(8px); }
  #paper .tab:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }

  /* a book off the shelf: two boards, a spread of pages, leaves that turn on the spine */
  #book { perspective: 2800px; }
  #book .board { position: absolute; top: 0; height: 100%; width: 50%; background: var(--bg); box-shadow: 0 22px 46px rgba(0,0,0,.45), 0 2px 6px rgba(0,0,0,.3); }
  #book .board.L { left: 0; border-radius: 5px 1px 1px 5px; }
  #book .board.R { left: 50%; border-radius: 1px 5px 5px 1px; }
  #book .board.S { left: 0; width: 100%; border-radius: 2px 5px 5px 2px; }
  #book .pages { position: absolute; perspective: 2800px; }
  #book .page { position: absolute; top: 0; width: 50%; height: 100%; overflow: hidden; cursor: pointer; }
  #book .page.L { left: 0; box-shadow: -2px 0 0 #e7dece, -4px 0 0 #d6cbb4; }
  #book .page.R { left: 50%; box-shadow: 2px 0 0 #e7dece, 4px 0 0 #d6cbb4; }
  #book .pages.single .page.R { left: 0; width: 100%; }
  #book .sL { background: linear-gradient(to left, rgba(70,45,20,.22), rgba(70,45,20,0) 10%), #f4eee1; }
  #book .sR { background: linear-gradient(to right, rgba(70,45,20,.22), rgba(70,45,20,0) 10%), #f4eee1; }
  #book .lf { position: absolute; top: 0; width: 50%; height: 100%; transform-style: preserve-3d; }
  #book .pages .lf.R { left: 50%; transform-origin: 0 50%; }
  #book .pages .lf.L { left: 0; transform-origin: 100% 50%; }
  #book .pages.single .lf.R { left: 0; width: 100%; }
  #book .lf.cov { left: 50%; transform-origin: 0 50%; }
  #book .pf { position: absolute; inset: 0; overflow: hidden; backface-visibility: hidden; -webkit-backface-visibility: hidden; }
  #book .pf.back { transform: rotateY(180deg); }
  #book .sh { position: absolute; inset: 0; background: #2a1a0c; opacity: 0; pointer-events: none; }
  #book .pc { position: absolute; inset: 0; box-sizing: border-box; padding: calc(var(--u)*58px) calc(var(--u)*50px) calc(var(--u)*66px); display: flex; flex-direction: column; gap: calc(var(--u)*14px); }
  #book .pn { position: absolute; bottom: calc(var(--u)*26px); font-size: max(10px, calc(var(--u)*12px)); font-variant-numeric: tabular-nums; }
  #book .sL .pn { left: calc(var(--u)*50px); }
  #book .sR .pn { right: calc(var(--u)*50px); }
  #book .rh { position: absolute; top: calc(var(--u)*28px); left: calc(var(--u)*50px); right: calc(var(--u)*50px); font-size: max(10px, calc(var(--u)*11px)); letter-spacing: .1em; color: var(--color-neutral-600); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  #book .sR .rh { text-align: right; }
  #book .kick { font-size: max(11px, calc(var(--u)*13px)); letter-spacing: .08em; color: var(--color-accent-700); }
  #book .pc > h2 { font-family: var(--font-heading); font-weight: 600; font-size: calc(var(--u)*38px); line-height: 1.14; margin: calc(var(--u)*4px) 0 0; text-wrap: pretty; }
  #book .by { font-style: italic; font-size: max(13px, calc(var(--u)*17px)); line-height: 1.6; margin: 0; text-wrap: pretty; }
  #book .foot { margin-top: auto; font-size: max(11px, calc(var(--u)*13px)); }
  #book .sec { font-size: max(11px, calc(var(--u)*12px)); letter-spacing: .14em; color: var(--color-accent-700); }
  #book .body p { font-size: max(14px, calc(var(--u)*18px)); line-height: 1.75; margin: 0 0 calc(var(--u)*12px); text-wrap: pretty; }
  #book .rel { display: flex; flex-direction: column; gap: 4px; }
  #book .rel .btn { justify-content: flex-start; text-align: left; margin-left: -6px; white-space: normal; }
  #book .colo { flex: 1; display: grid; place-items: center; font-style: italic; font-size: max(13px, calc(var(--u)*16px)); }
  #book .cover-img { align-self: flex-start; max-width: 46%; max-height: 42%; border-radius: 2px; box-shadow: var(--shadow-md); }
  #book .toc { display: flex; flex-direction: column; gap: calc(var(--u)*13px); }
  #book .toc button { all: unset; cursor: pointer; display: flex; flex-direction: column; gap: 2px; }
  #book .toc button:hover b, #book .toc button:focus-visible b { color: var(--color-accent-700); }
  #book .toc span { font-size: max(10px, calc(var(--u)*11.5px)); letter-spacing: .08em; color: var(--color-neutral-600); font-variant-numeric: tabular-nums; }
  #book .toc b { font-family: var(--font-heading); font-weight: 600; font-size: max(13px, calc(var(--u)*17px)); line-height: 1.32; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  #book .cvr { background: var(--bg); color: var(--fg); border-radius: 1px 5px 5px 1px; box-sizing: border-box; padding: 22% 13% 14%; display: flex; flex-direction: column; gap: calc(var(--u)*14px); box-shadow: inset 9px 0 12px -8px rgba(0,0,0,.5); }
  #book .cvr .band { position: absolute; left: 0; right: 0; height: calc(var(--u)*3px); background: #e3cf98; opacity: .85; }
  #book .cvr .ck { font-size: max(11px, calc(var(--u)*13px)); letter-spacing: .16em; }
  #book .cvr b { font-family: var(--font-heading); font-weight: 600; font-size: calc(var(--u)*36px); line-height: 1.18; text-wrap: pretty; }
  #book .cvr .cb { font-style: italic; font-size: max(12px, calc(var(--u)*15px)); line-height: 1.5; }
  #book .cvr .cf { margin-top: auto; font-size: max(11px, calc(var(--u)*13px)); letter-spacing: .08em; }
  #book .cvb { background: var(--bg); border-radius: 5px 1px 1px 5px; }
  #book .endp { position: absolute; inset: 0; display: grid; place-items: center; background-color: var(--bg); background-image: repeating-linear-gradient(45deg, rgba(255,255,255,.06) 0 2px, transparent 2px 10px); color: var(--fg); }
  #book .exlib { display: flex; flex-direction: column; align-items: center; gap: calc(var(--u)*8px); padding: calc(var(--u)*22px) calc(var(--u)*28px); border: 1.5px solid currentColor; font-size: max(10px, calc(var(--u)*12px)); letter-spacing: .16em; text-align: center; }
  #book .exlib b { font-family: var(--font-heading); font-weight: 600; font-size: calc(var(--u)*26px); letter-spacing: .04em; }

  /* An article set in a book: the whole text is poured into page-sized columns and each page is a window onto one of them,
     so paragraphs and code run on from page to page the way print does. */
  .win { overflow: hidden; flex: none; }
  .prose.flow { max-width: none; column-fill: auto; line-height: 1.75; orphans: 2; widows: 2; }
  .prose.flow > :first-child { margin-top: 0; }
  .prose.flow :is(h2, h3, h4, h5) { break-after: avoid; margin: 1.5em 0 .6em; padding: 0; border: 0; background: none; line-height: 1.3; }
  .prose.flow h2 { font-size: 1.32em; }
  .prose.flow h3 { font-size: 1.16em; }
  .prose.flow h4 { font-size: 1.04em; }
  .prose.flow h5 { font-size: 1em; margin-top: 1.2em; }
  .prose.flow .callout-content > :is(h2, h3, h4, h5) { margin: 0; }
  .prose.flow :is(figure, .callout, .bookmark, blockquote, tr, .video-container) { break-inside: avoid; }
  .prose.flow figure { margin: 1.2em 0; text-align: center; }
  .prose.flow figure img { max-width: 100%; max-height: calc(var(--fh) * .72); width: auto; height: auto; }
  .prose.flow .video-container video { max-width: 100%; max-height: calc(var(--fh) * .6); }
  /* code wraps instead of scrolling, and a long block is cut at the foot of the page and picked up on the next */
  .prose.flow .code-block, .prose.paper .code-block { overflow: visible; margin: 1.2em 0; font-size: .74em; line-height: 1.6; box-shadow: none; -webkit-box-decoration-break: clone; box-decoration-break: clone; }
  .prose.flow .code-block pre, .prose.paper .code-block pre { overflow: visible; white-space: pre-wrap; overflow-wrap: anywhere; padding: .9em 1.1em; }
  .prose.flow .code-block pre code, .prose.paper .code-block pre code { width: auto; min-width: 0; }
  .prose.flow .code-header { padding: .5em 1.1em; break-after: avoid; }
  .prose.flow .table-wrapper { overflow: visible; margin: 1.2em 0; font-size: .82em; }
  .prose.flow :is(th, td) { overflow-wrap: anywhere; }
  .prose.flow .callout-content, .prose.flow .callout-icon { font-size: 1em; }
  .prose.paper { max-width: none; font-size: max(15px, calc(var(--u)*17px)); line-height: 1.8; }
  .prose.paper > :first-child { margin-top: 0; }
  .prose.paper figure img { max-width: 100%; height: auto; }
  .prose .embed-out { display: block; padding: .8em 1em; border: 1px solid var(--color-divider); border-radius: var(--radius-md); font-size: .9em; }
  .prose .loading { font-style: italic; color: var(--color-neutral-600); }

  /* — the CRT: DOM laid over the screen's projected rectangle — */
  #tvui { position: fixed; inset: 0; z-index: 22; pointer-events: none; display: none; }
  #tvui.on { display: block; }
  #crt { position: absolute; pointer-events: auto; overflow: hidden; border-radius: 5%/6%; background: #0e1622; color: #f3f2f2; font-family: ui-monospace, Menlo, Consolas, monospace; opacity: 0; transition: opacity .4s; text-shadow: 0 0 .35em rgba(170,210,255,.45); }
  #tvui.vis #crt { opacity: 1; }
  #crt .scan { position: absolute; inset: 0; pointer-events: none; z-index: 3; background: repeating-linear-gradient(to bottom, rgba(0,0,0,.25) 0 1px, transparent 1px 3px), radial-gradient(ellipse at center, rgba(255,255,255,.05), rgba(0,0,0,.5) 100%); }
  #crt .menu { position: absolute; inset: 0; box-sizing: border-box; padding: 7% 9%; display: flex; flex-direction: column; gap: .35em; }
  #crt .hd { display: flex; justify-content: space-between; font-weight: 700; letter-spacing: .12em; }
  #crt .hd span:first-child { color: var(--color-accent-300); }
  #crt .sub { font-size: .8em; opacity: .8; }
  #crt .gl { display: flex; flex-direction: column; gap: .1em; margin-top: .2em; min-height: 0; overflow: auto; scrollbar-width: none; }
  #crt .gi { all: unset; cursor: pointer; display: flex; gap: .6em; padding: .1em .4em; line-height: 1.3; }
  #crt .gi .c { visibility: hidden; }
  #crt .gi .k { margin-left: auto; opacity: .75; }
  #crt .gi.on { background: #f3f2f2; color: #0e1622; text-shadow: none; }
  #crt .gi.on .c { visibility: visible; animation: crt-blink 1s steps(2) infinite; }
  #crt .ht { margin-top: auto; font-size: .62em; opacity: .65; letter-spacing: .06em; }
  #crt iframe { position: absolute; left: 0; top: 0; border: 0; transform-origin: 0 0; background: #000; z-index: 1; }
  #crt .ld { position: absolute; inset: 0; z-index: 2; display: grid; place-items: center; text-align: center; line-height: 1.6; background: #0e1622; }
  #tvbar { position: absolute; pointer-events: auto; display: flex; gap: 6px; padding: 6px; transform: translateX(-50%); opacity: 0; transition: opacity .4s; white-space: nowrap; }
  #tvui.vis #tvbar { opacity: 1; }
  @keyframes crt-blink { 50% { opacity: 0; } }

  /* Reading progress bar */
  .prog { height: 4px; background: var(--color-neutral-200); margin: var(--space-2) 0 var(--space-1); }
  .prog i { display: block; height: 4px; background: var(--color-accent); }

  /* Phones: the panel becomes a bottom sheet (study.js shifts the camera to match) */
  @media (max-width: 760px) {
    #toast { top: 76px; font-size: 14px; max-width: calc(100vw - 24px); text-align: center; }
    body.reading #toast { left: 50%; }
    #panel { top: auto; left: 0; right: 0; width: auto; height: 58vh; transform: translateY(105%); padding: var(--space-6) var(--space-4) var(--space-8); box-shadow: 0 -12px 32px color-mix(in srgb, #000 40%, transparent); }
    #panel.open { transform: none; }
    #panel h2 { font-size: 34px; }
    #panel h3 { font-size: 26px; }
    #panel .intro, #panel .body p { font-size: 16px; }
    #reader .x { right: var(--space-2); top: var(--space-2); }
    #reader .rnav { bottom: var(--space-2); }
    #reader .rnav .btn { padding: 8px 10px; font-size: 13px; }
  }
</style>
