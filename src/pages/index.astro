---
import SiteHead from '../components/SiteHead.astro';
import { buildStudyData } from '../lib/study';
import '../styles/broadsheet.css';

// The whole site opens into one full-viewport WebGL room. It owns the document
// (no BaseLayout), and the Notion content it shows is baked in as JSON at build time.
const data = await buildStudyData();
const json = JSON.stringify(data).replace(/</g, '\\u003c');
const BASE = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <SiteHead />
  </head>
  <body class="study-body">
    <div id="stage"></div>
    <div id="vig"></div>
    <div id="grain"></div>
    <div id="intro"><div>推開書房的門……</div></div>
    <div id="chips" class="hud sheet"></div>
    <div id="dock" class="hud">
      <div class="row sheet">
        <button class="btn btn-primary" id="bRandom">隨手翻一樣</button>
        <button class="btn btn-secondary" id="bLight">關燈</button>
        <button class="btn btn-secondary" id="bSeason">窗外：秋</button>
      </div>
      <span class="hint">拖曳環顧 · 滾輪靠近 · 點房間裡的東西 · Esc 退回</span>
    </div>
    <div id="toast" class="hud"></div>
    <div id="tip"></div>
    <aside id="panel" aria-live="polite">
      <button class="btn btn-ghost close" data-act="close">收起 ✕</button>
      <div id="pbody"></div>
    </aside>

    <noscript>
      <style is:inline>#intro { display: none; }</style>
      <div class="noscript">
        <p>這裡是一間互動式的 3D 書房，需要開啟 JavaScript 才能走進去。</p>
        <p><a href={`${BASE}reading/`}>書單</a> · <a href={`${BASE}archive/`}>全部文章</a> · <a href="/rss.xml">RSS</a></p>
      </div>
    </noscript>

    <script type="application/json" id="study-data" is:inline set:html={json} />

    <!-- Film grain: a tiny noise canvas, jittered every 90ms -->
    <script is:inline>
      (() => {
        const c = document.createElement('canvas');
        c.width = c.height = 160;
        const x = c.getContext('2d');
        const d = x.createImageData(160, 160);
        for (let i = 0; i < d.data.length; i += 4) {
          const v = Math.random() * 255;
          d.data[i] = d.data[i + 1] = d.data[i + 2] = v;
          d.data[i + 3] = 255;
        }
        x.putImageData(d, 0, 0);
        const g = document.getElementById('grain');
        g.style.backgroundImage = 'url(' + c.toDataURL() + ')';
        let k = 0;
        setInterval(() => {
          k = (k + 1) % 8;
          g.style.transform = 'translate(' + ((k * 37) % 50) + 'px,' + ((k * 53) % 50) + 'px)';
        }, 90);
      })();
    </script>

    <script>
      import '../scripts/study.js';
    </script>
  </body>
</html>

<style is:global>
  html, body.study-body { margin: 0; height: 100%; overflow: hidden; background: #140e0a; font-family: var(--font-body); color: var(--color-text); }
  /* :not(.btn) keeps these from outranking the button colours (a primary button is cyan with paper text) */
  body.study-body a:not(.btn) { color: var(--color-accent-700); }
  body.study-body a:not(.btn):hover { color: var(--color-accent-800); }
  body.study-body button { font-family: inherit; }

  #stage { position: fixed; inset: 0; }
  #stage canvas { display: block; outline: none; }

  #vig { position: fixed; inset: 0; pointer-events: none; z-index: 4; background: radial-gradient(ellipse at 50% 45%, rgba(0,0,0,0) 50%, rgba(0,0,0,.5) 100%); }
  #grain { position: fixed; inset: -50px; pointer-events: none; z-index: 4; opacity: .06; mix-blend-mode: overlay; }

  .hud { position: fixed; z-index: 10; }
  .sheet { background: var(--color-bg); box-shadow: var(--shadow-sm); border-radius: var(--radius-md); }

  #chips { right: var(--space-6); top: var(--space-6); padding: var(--space-2); display: flex; gap: 6px; align-items: center; flex-wrap: wrap; max-width: 560px; justify-content: flex-end; }
  #chips button { all: unset; cursor: pointer; }
  #chips .count { font-size: 12px; padding: 0 6px; }

  #dock { left: var(--space-6); bottom: var(--space-6); display: flex; flex-direction: column; gap: var(--space-2); align-items: flex-start; transition: opacity .4s; }
  #dock .row { display: flex; gap: 6px; padding: 6px; }
  #dock .hint { font-size: 12px; font-style: italic; color: var(--color-bg); }
  body.reading #dock { opacity: 0; pointer-events: none; }

  #tip { position: fixed; z-index: 30; pointer-events: none; font-size: 13px; padding: 6px 10px; background: var(--color-text); color: var(--color-bg); border-radius: var(--radius-md); opacity: 0; transition: opacity .15s; white-space: nowrap; }

  #toast { left: 50%; top: var(--space-8); transform: translate(-50%, -8px); padding: var(--space-2) var(--space-4); background: var(--color-text); color: var(--color-bg); font-size: 16px; border-radius: var(--radius-md); box-shadow: var(--shadow-md); opacity: 0; transition: opacity .25s, transform .25s; pointer-events: none; }
  #toast.on { opacity: 1; transform: translate(-50%, 0); }
  body.reading #toast { left: calc(50% - 230px); }

  #intro { position: fixed; inset: 0; z-index: 50; display: grid; place-items: center; background: #140e0a; transition: opacity 1.2s; pointer-events: none; }
  #intro.off { opacity: 0; }
  #intro div { color: var(--color-bg); font-family: var(--font-heading); font-size: 20px; font-style: italic; letter-spacing: .04em; text-align: center; }
  #intro a { color: var(--color-accent-300); }

  .noscript { position: fixed; inset: 0; z-index: 60; display: grid; place-content: center; text-align: center; background: #140e0a; color: var(--color-bg); font-style: italic; }
  .noscript a { color: var(--color-accent-300); }

  /* Reading panel */
  #panel { position: fixed; top: 0; right: 0; bottom: 0; width: 460px; z-index: 20; background: var(--color-bg); box-shadow: var(--shadow-lg); transform: translateX(105%); transition: transform .45s cubic-bezier(.2,.7,.2,1); overflow: auto; box-sizing: border-box; padding: var(--space-8) var(--space-6) var(--space-8) var(--space-8); }
  #panel.open { transform: none; }
  #panel .close { position: absolute; right: var(--space-4); top: var(--space-4); }
  #panel h2 { margin: 6px 0 var(--space-3); font-family: var(--font-heading); font-weight: 600; font-size: 44px; line-height: 1.08; text-wrap: pretty; }
  #panel h3 { margin: 6px 0 var(--space-3); font-family: var(--font-heading); font-weight: 600; font-size: 34px; line-height: 1.15; text-wrap: pretty; }
  #panel .intro { font-size: 17px; font-style: italic; line-height: 1.55; margin: 0 0 var(--space-6); }
  #panel .list { display: flex; flex-direction: column; gap: var(--space-6); }
  #panel .body p { font-size: 17px; line-height: 1.7; margin: 0 0 var(--space-3); text-wrap: pretty; }
  #panel .meta { font-size: 13px; margin: var(--space-4) 0; }
  #panel .rel { display: flex; flex-direction: column; gap: 4px; margin-top: var(--space-6); }
  #panel .rel .lab { font-size: 12px; letter-spacing: .08em; }

  /* Reading progress bar */
  .prog { height: 4px; background: var(--color-neutral-200); margin: var(--space-2) 0 var(--space-1); }
  .prog i { display: block; height: 4px; background: var(--color-accent); }

  /* Phones: the panel becomes a bottom sheet (study.js shifts the camera to match) */
  @media (max-width: 760px) {
    #chips { left: var(--space-2); right: var(--space-2); top: var(--space-2); max-width: none; justify-content: flex-start; padding: 6px; }
    #dock { left: var(--space-2); right: var(--space-2); bottom: var(--space-2); }
    #dock .row { flex-wrap: wrap; }
    #dock .btn { padding: 8px 12px; font-size: 13px; }
    #dock .hint { font-size: 11px; }
    #toast { top: 76px; font-size: 14px; max-width: calc(100vw - 24px); text-align: center; }
    body.reading #toast { left: 50%; }
    #panel { top: auto; left: 0; right: 0; width: auto; height: 58vh; transform: translateY(105%); padding: var(--space-6) var(--space-4) var(--space-8); box-shadow: 0 -12px 32px color-mix(in srgb, #000 40%, transparent); }
    #panel.open { transform: none; }
    #panel h2 { font-size: 34px; }
    #panel h3 { font-size: 26px; }
    #panel .intro, #panel .body p { font-size: 16px; }
  }
</style>
