---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ReadingTile from '../components/ReadingTile.astro';
import { loadConfig } from '../lib/config';
import {
  getAllArticles,
  getArticlesByCategory,
  getAllBooks,
  getAllSideProjects,
  getAllPlayboxGames,
} from '../lib/data';
import { getGithubContributions } from '../lib/github';
import { categorySlug } from '../lib/category';
import { bookStatus } from '../lib/bookCover';
import avatar2 from '../assets/avatar_2.png';
import avatar3 from '../assets/avatar_3.png';
import bookCover from '../assets/flutter-testing.webp';

const config = loadConfig();
const BASE = import.meta.env.BASE_URL;

const allArticles = await getAllArticles();

const categoriesOrdered = [
  { name: '開發日常' },
  { name: '30 天輕鬆學會 Flutter 測試' },
  { name: 'Flutter 開發設計雜談' },
];

const latestArticle = allArticles[0] ?? null;
const latestSlug = latestArticle ? categorySlug(latestArticle.category) : '';

const tabsData = await Promise.all(
  categoriesOrdered.map(async (cat) => {
    const slug = categorySlug(cat.name);
    const articles = await getArticlesByCategory(slug);
    const skipFirst = slug === latestSlug;
    return {
      name: cat.name,
      slug,
      count: articles.length,
      featured: articles[0] ?? null,
      recent: skipFirst ? articles.slice(1, 7) : articles.slice(0, 6),
    };
  })
);
const defaultTab = tabsData[0];

const allBooks = await getAllBooks();
const currentBook = allBooks.find((b) => bookStatus(b) === 'reading') ?? null;
const recentBooks = allBooks
  .filter((b) => bookStatus(b) === 'read')
  .sort((a, b) => (b.finishedDate ?? '').localeCompare(a.finishedDate ?? ''))
  .slice(0, 2);

function formatDate(iso: string): string {
  if (!iso) return '';
  const d = new Date(iso);
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  return `${y}.${m}.${day}`;
}

function articleHref(article: { id: string; category: string }): string {
  return `${BASE}${categorySlug(article.category)}/${article.id}/`;
}

const postDecorations = [
  { icon: '🧠', bg: '#f6e9cd' },
  { icon: '🔍', bg: '#d8e9e1' },
  { icon: '👆', bg: '#e9dde6' },
  { icon: '🌀', bg: '#ddd9ea' },
  { icon: '🧩', bg: '#f0e6da' },
  { icon: '📂', bg: '#dceaf2' },
];

const channelByType: Record<string, { label: string; value: string; icon: string }> = {
  github:     { label: 'GitHub',       value: 'easylive1989',         icon: '⧉' },
  threads:    { label: 'Threads',      value: 'paul.ch.wu',           icon: '@' },
  linkedin:   { label: 'LinkedIn',     value: 'Paul Wu',              icon: 'in' },
  email:      { label: 'Email',        value: 'easylive1989@gmail.com', icon: '✉' },
  appstore:   { label: 'App Store',    value: 'cheng-hua-wu',         icon: '' },
  googleplay: { label: 'Google Play',  value: 'Paul Wu',              icon: '▶' },
  playbox:    { label: 'Paul Playbox', value: 'paul 的遊樂場',         icon: '◈' },
};
const channels = config.author.links;

const talks = [
  { year: '2025', emoji: '📣', title: '實踐 Flutter 測試的眉眉角角', venue: 'Agile.Taichung', venueColor: 'sub', url: 'https://www.accupass.com/event/2503031416141112169743' },
  { year: '2024', emoji: '📣', title: 'Flutter Widget Test 深度探索',  venue: 'iThome 鐵人講堂',  venueColor: 'sub', url: 'https://itplus.ithome.com.tw/webinar-page/237' },
  { year: '2023', emoji: '✍️', title: '30 天輕鬆學會 Flutter 測試',     venue: '鐵人賽佳作',       venueColor: 'green', url: 'https://ithelp.ithome.com.tw/users/20129825/ironman/5974' },
  { year: '2022', emoji: '✍️', title: 'Flutter 開發設計雜談',           venue: '鐵人賽佳作',       venueColor: 'green', url: 'https://ithelp.ithome.com.tw/users/20129825/ironman/4992' },
  { year: '2020', emoji: '✍️', title: '在 Kata 中尋找 Clean Code',       venue: '鐵人賽完賽',       venueColor: 'sub', url: 'https://ithelp.ithome.com.tw/users/20129825/ironman/3440?page=1' },
];

// Fetched from Notion (sorted by 排序 ascending)
const allSideProjects = await getAllSideProjects();
const heroProject = allSideProjects[0] ?? null;
const stackProjects = allSideProjects.slice(1, 3);
const cardProjects = allSideProjects.slice(3);
const playboxGames = await getAllPlayboxGames();

const articlesCount = allArticles.length;
const categoriesCount = tabsData.filter((t) => t.count > 0).length;

const githubChannel = config.author.links.find((l) => l.type === 'github');
const githubUsername =
  githubChannel?.url.match(/github\.com\/([^/]+)/)?.[1] ?? 'easylive1989';
const contrib = await getGithubContributions(githubUsername);
const contribYear = new Date().getFullYear();
---

<BaseLayout hideFooter bodyClass="bento-page">
  <div class="bento-home">

    <!-- ─────────── Row 1 — Identity + Now ─────────── -->
    <div class="grid cols-6">
      <section class="tile span-4 identity-tile">
        <div class="identity">
          <img src={`${BASE}${config.author.avatar}`} alt={config.author.name} class="avatar" width="104" height="104" />
          <div>
            <div class="label">Hi, I'm</div>
            <h1 class="h-display">{config.author.name}</h1>
            <div class="badges">
              <span class="chip"><span class="dot" style="background:var(--bento-accent-2)"></span> Available for chat</span>
              <span class="chip">📍 Taichung</span>
            </div>
          </div>
          <button class="tile-theme-toggle" id="theme-toggle" aria-label="Toggle theme">
            <svg class="theme-icon sun-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="4"/>
              <line x1="12" y1="2" x2="12" y2="5"/><line x1="12" y1="19" x2="12" y2="22"/>
              <line x1="4.93" y1="4.93" x2="7.05" y2="7.05"/><line x1="16.95" y1="16.95" x2="19.07" y2="19.07"/>
              <line x1="2" y1="12" x2="5" y2="12"/><line x1="19" y1="12" x2="22" y2="12"/>
              <line x1="4.93" y1="19.07" x2="7.05" y2="16.95"/><line x1="16.95" y1="7.05" x2="19.07" y2="4.93"/>
            </svg>
            <svg class="theme-icon moon-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z"/>
            </svg>
          </button>
        </div>
        <p class="bio">{config.author.bio.split('\n').map((line, i) => i === 0 ? line : [<br />, line])}</p>
      </section>

      <ReadingTile current={currentBook} recent={recentBooks} />
    </div>

    <!-- ─────────── Row 2 — Tabs ─────────── -->
    <div class="grid cols-tabs" style="margin-top:calc(var(--bento-gap) * 4)">
      <nav class="tile tabs-tile">
        <div class="tabs" role="tablist">
          {tabsData.map((tab, i) => (
            <button
              type="button"
              role="tab"
              data-tab-target={tab.slug}
              aria-current={i === 0 ? 'true' : undefined}
              class:list={['tab-link', { active: i === 0 }]}
            >
              <div class="tab-meta">
                <span class="tab-meta-active">Active · {tab.count} 篇</span>
                <span class="tab-meta-idle">{tab.count} 篇</span>
              </div>
              <div class="tab-label">{tab.name}</div>
              <span class="live-dot">●</span>
            </button>
          ))}
        </div>
      </nav>
    </div>

    <!-- ─────────── Row 3 — Featured + Book + GitHub ─────────── -->
    <div class="grid cols-6" style="margin-top:var(--bento-gap)">
      {latestArticle && (
        <article class="tile tile--accent span-4 featured">
          <div class="featured-body">
            <div class="featured-head">
              <span class="chip chip--on-accent">★ 最新文章 · {latestArticle.category}</span>
              <span class="mono" style="font-size:11px;color:rgba(255,255,255,.7);letter-spacing:.1em">{formatDate(latestArticle.createdTime)}</span>
            </div>
            <h2>{latestArticle.title}</h2>
            {latestArticle.summary && (
              <p>{latestArticle.summary}</p>
            )}
            <div style="display:flex;gap:10px;align-items:center">
              <a href={articleHref(latestArticle)} class="btn-pri">閱讀全文 <span>↗</span></a>
              <span style="font-size:12px;color:rgba(255,255,255,.7)">{latestArticle.category}</span>
            </div>
          </div>
          <div class="featured-band">
            <span>📑 共 {articlesCount} 篇文章</span><span>·</span>
            <span>🧠 {categoriesCount} 個系列</span><span>·</span>
            <span>⏱ 從 2020 寫到現在</span>
          </div>
        </article>
      )}

      <div class="grid span-2 stack-2 stack-2--fill">
        <section class="tile tile--green book-tile">
          <Image src={bookCover} alt="30 天輕鬆學會 Flutter 測試" class="book-cover-img" width={160} height={213} loading="eager" />
          <div class="book-content">
            <div class="label label--on-color">出版書籍 · Book</div>
            <h4 class="book-title">30 天輕鬆學會<br />Flutter 測試</h4>
          </div>
          <a href="https://www.tenlong.com.tw/products/9786264140010?list_name=srh" target="_blank" rel="noopener" class="book-cta">看書 →</a>
          <p class="book-blurb">由 2023 鐵人賽佳作改寫成書，從基礎到進階一次到位。</p>
        </section>
        <a
          class="tile contrib-tile"
          href={`https://github.com/${githubUsername}`}
          target="_blank"
          rel="noopener"
          aria-label={`@${githubUsername} on GitHub`}
        >
          <div class="contrib-head">
            <div class="contrib-head-text">
              <div class="label">GitHub · 過去 18 週</div>
              <div class="contrib-summary">
                <strong>{contrib.totalThisYear.toLocaleString()}</strong> contributions in {contribYear}
              </div>
            </div>
            {contrib.currentStreak > 0 && (
              <span class="mono contrib-active">● active</span>
            )}
          </div>

          <div class="contrib-months" aria-hidden="true">
            {contrib.monthLabels.map((m) => <span>{m}</span>)}
          </div>
          <div
            class="contrib-grid"
            role="img"
            aria-label={`過去 18 週 GitHub 貢獻熱度，共 ${contrib.totalThisYear} 次`}
          >
            {Array.from({ length: 7 }).map((_, d) => (
              contrib.weeks.map((week) => {
                const cell = week[d];
                if (!cell.inRange) return <i aria-hidden="true" style="visibility:hidden"></i>;
                if (cell.level === 0) return <i aria-hidden="true"></i>;
                return <i class={`l${cell.level}`} aria-hidden="true"></i>;
              })
            ))}
          </div>

          <div class="contrib-foot">
            <div class="contrib-streaks">
              <span><strong>{contrib.currentStreak}</strong> 天連續</span>
              <span><strong>{contrib.longestStreak}</strong> 最長</span>
            </div>
            <span class="contrib-legend" aria-hidden="true">
              less <i></i><i class="l1"></i><i class="l2"></i><i class="l3"></i><i class="l4"></i> more
            </span>
          </div>
        </a>
      </div>
    </div>

    <!-- ─────────── Row 4 — Posts + Channels + Talks ─────────── -->
    <div class="grid cols-6" style="margin-top:var(--bento-gap)">
      {tabsData.map((t) => (
        <section
          class="tile span-4 tile--flush"
          data-tab-content={t.slug}
          hidden={t.slug !== defaultTab.slug}
        >
          <div class="posts-head">
            <div>
              <div class="label">All posts</div>
              <h3 style="font-size:24px;margin-top:4px">最近 {t.recent.length} 篇</h3>
            </div>
            <a href={`${BASE}${t.slug}/`} class="posts-link mono">↓ 新到舊 · 看全部 ↗</a>
          </div>
          <div class="posts-divider"></div>

          {t.recent.length === 0 ? (
            <p class="posts-empty">目前還沒有文章。</p>
          ) : (
            t.recent.map((post, i) => {
              const deco = postDecorations[i % postDecorations.length];
              return (
                <a class="post-row" href={articleHref(post)}>
                  <div class="post-icon" style={`background:${deco.bg}`}>{deco.icon}</div>
                  <div>
                    <div class="post-title">{post.title}</div>
                    <div class="post-meta"><span class="chip chip--mini">{post.category}</span> {formatDate(post.createdTime)}</div>
                  </div>
                  <span class="post-tail mono">{post.category}</span>
                  <span class="arrow">↗</span>
                </a>
              );
            })
          )}
        </section>
      ))}

      <div class="grid span-2 stack-2">
        <section class="tile" style="padding:20px">
          <div class="label" style="margin-bottom:14px">Find me at</div>
          <div class="channels">
            {channels.map((link) => {
              const info = channelByType[link.type];
              if (!info) return null;
              return (
                <a class="ch-row" href={link.url} target="_blank" rel="noopener">
                  <span class="ch-left">
                    <span class="ch-icon">{info.icon}</span>
                    <span>{info.label}</span>
                  </span>
                  <span class="ch-val">{info.value}</span>
                </a>
              );
            })}
          </div>
        </section>
        <section class="tile" style="padding:20px">
          <div class="label" style="margin-bottom:14px">競賽與演講 · Awards & Talks</div>
          <ul class="talks-list">
            {talks.map((t) => (
              <li>
                <span class="mono talks-year">{t.year}</span>
                <span>
                  {t.emoji} <a href={t.url} target="_blank" rel="noopener" class="talks-link">{t.title}</a>
                  <br />
                  <span class={`talks-venue talks-venue--${t.venueColor}`}>{t.venue}</span>
                </span>
              </li>
            ))}
          </ul>
        </section>
      </div>
    </div>

    <!-- ─────────── Row 5 — Side projects ─────────── -->
    <div class="grid cols-6" style="margin-top:calc(var(--bento-gap) * 4)">
      <section class="tile span-6 sec-head">
        <div class="sec-head-left">
          <Image src={avatar2} alt="" class="sec-head-avatar" width={128} height={128} loading="lazy" />
          <div>
            <h3>Side projects</h3>
            <p class="mono sec-head-tagline">solo · for fun · always shipping</p>
          </div>
        </div>
      </section>

      {heroProject && (
        <article class="tile span-4 project-hero">
          <div
            class:list={['project-cover', { 'project-cover--image': !!heroProject.coverUrl }]}
            style={heroProject.coverUrl ? `background-image:url('${heroProject.coverUrl}')` : undefined}
          >
            <div class="project-cover-overlay"></div>
            {heroProject.platforms.length > 0 && (
              <span class="mono project-tag">{heroProject.platforms.join(' · ')}</span>
            )}
            <span class="pill project-pill">● {heroProject.status || '活著'}</span>
          </div>
          <div class="project-body">
            <h4>
              {heroProject.title}
              {heroProject.subtitle && <span class="project-sub"> · {heroProject.subtitle}</span>}
            </h4>
            {heroProject.description && (
              <p class="project-blurb">{heroProject.description}</p>
            )}
            {heroProject.tags.length > 0 && (
              <div class="project-chips">
                {heroProject.tags.map((tag) => (
                  <span class="chip">{tag}</span>
                ))}
              </div>
            )}
            <div class="project-foot project-foot--links">
              {heroProject.githubUrl && (
                <a href={heroProject.githubUrl} target="_blank" rel="noopener">GitHub ↗</a>
              )}
              {heroProject.mainUrl && (
                <a href={heroProject.mainUrl} target="_blank" rel="noopener" class="link-accent">玩玩看 ↗</a>
              )}
            </div>
          </div>
        </article>
      )}

      {stackProjects.length > 0 && (
        <div class="tile span-2 tile--flush">
          <div class="project-stack">
            {stackProjects.map((p) => (
              <div class="project-stack-cell">
                <div class="project-stack-head">
                  {p.icon && (
                    <div class="pj-icon" style={`background:${p.iconBg || 'var(--bento-accent)'}`}>{p.icon}</div>
                  )}
                  <span class="pill pill--muted">● {p.status || '活著'}</span>
                </div>
                <div>
                  <h4 class="project-stack-title">{p.title}</h4>
                  {p.platforms.length > 0 && (
                    <div class="mono project-stack-sub">{p.platforms.join(' · ')}</div>
                  )}
                </div>
                {p.description && (
                  <p class="project-stack-blurb">{p.description}</p>
                )}
                {p.tags.length > 0 && (
                  <div class="project-stack-chips">
                    {p.tags.map((tag) => (
                      <span class="chip chip--mini">{tag}</span>
                    ))}
                  </div>
                )}
                <div class="project-stack-foot">
                  {p.githubUrl && (
                    <a href={p.githubUrl} target="_blank" rel="noopener">GitHub</a>
                  )}
                  {p.mainUrl && (
                    <a href={p.mainUrl} target="_blank" rel="noopener" class="link-accent">玩玩看 ↗</a>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {cardProjects.map((p) => (
        <article class="tile span-3 project-card">
          <div class="project-stack-head">
            {p.icon && (
              <div class="pj-icon" style={`background:${p.iconBg || 'var(--bento-accent)'}`}>{p.icon}</div>
            )}
            <span class="pill pill--muted">● {p.status || '活著'}</span>
          </div>
          <div>
            <h4 class="project-stack-title">{p.title}</h4>
            {p.platforms.length > 0 && (
              <div class="mono project-stack-sub">{p.platforms.join(' · ')}</div>
            )}
          </div>
          {p.description && (
            <p class="project-stack-blurb">{p.description}</p>
          )}
          {p.tags.length > 0 && (
            <div class="project-stack-chips">
              {p.tags.map((tag) => (
                <span class="chip chip--mini">{tag}</span>
              ))}
            </div>
          )}
          <div class="project-stack-foot">
            {p.githubUrl && (
              <a href={p.githubUrl} target="_blank" rel="noopener">GitHub</a>
            )}
            {p.mainUrl && (
              <a href={p.mainUrl} target="_blank" rel="noopener" class="link-accent">玩玩看 ↗</a>
            )}
          </div>
        </article>
      ))}
    </div>

    <!-- ─────────── Row 6 — Paul Playbox (dedicated section) ─────────── -->
    <div class="grid cols-6" style="margin-top:calc(var(--bento-gap) * 4)">
      <section class="tile span-6 sec-head">
        <div class="sec-head-left">
          <Image src={avatar3} alt="" class="sec-head-avatar" width={128} height={128} loading="lazy" />
          <div>
            <h3>Playbox</h3>
            <p class="mono sec-head-tagline">play · prototype · always tinkering</p>
          </div>
        </div>
        <a href="https://github.com/easylive1989/paul-playbox" target="_blank" rel="noopener" class="mono lab-link">github.com/easylive1989/paul-playbox ↗</a>
      </section>

      <section class="tile span-6 tile--flush">
        <div class="playbox-grid">
          {playboxGames.map((game) => (
            <a class="game" href={game.url} target="_blank" rel="noopener">
              <div class="game-cover">
                {game.imageUrl && (
                  <img src={game.imageUrl} alt={`${game.name} screenshot`} loading="lazy" />
                )}
              </div>
              <div class="game-body">
                <p class="game-blurb">{game.name}</p>
                <span class="play-btn">▶ play</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    </div>

    <!-- ─────────── Footer ─────────── -->
    <div class="grid cols-tabs" style="margin-top:var(--bento-gap)">
      <footer class="tile bento-footer">
        <span>paul-learning.dev · © {new Date().getFullYear()} {config.author.name} · built with Astro</span>
        <a href="/rss.xml" class="mono bento-footer-rss">RSS ↗</a>
      </footer>
    </div>

  </div>

  <script is:inline>
    (function () {
      if (window.__bentoTabsAbort) window.__bentoTabsAbort.abort();

      function setupBentoTabs() {
        if (window.__bentoTabsAbort) window.__bentoTabsAbort.abort();
        const ctrl = new AbortController();
        window.__bentoTabsAbort = ctrl;
        const signal = ctrl.signal;

        const tabBtns = Array.from(document.querySelectorAll('[data-tab-target]'));
        const panels  = Array.from(document.querySelectorAll('[data-tab-content]'));
        if (tabBtns.length === 0 || panels.length === 0) return;
        const valid = new Set(tabBtns.map((b) => b.getAttribute('data-tab-target')));

        function activate(slug, opts) {
          if (!valid.has(slug)) return;
          const pushUrl = !opts || opts.pushUrl !== false;
          tabBtns.forEach((b) => {
            const on = b.getAttribute('data-tab-target') === slug;
            b.classList.toggle('active', on);
            if (on) b.setAttribute('aria-current', 'true');
            else b.removeAttribute('aria-current');
          });
          panels.forEach((p) => {
            p.hidden = p.getAttribute('data-tab-content') !== slug;
          });
          if (pushUrl) {
            const url = new URL(location.href);
            url.searchParams.set('tab', slug);
            history.replaceState({}, '', url);
          }
        }

        const initial = new URL(location.href).searchParams.get('tab');
        if (initial && valid.has(initial)) activate(initial, { pushUrl: false });

        tabBtns.forEach((b) => {
          b.addEventListener('click', () => activate(b.getAttribute('data-tab-target')), { signal });
        });
      }

      document.addEventListener('astro:page-load', setupBentoTabs);
    })();
  </script>
</BaseLayout>

<style is:global>
  /* Body / main overrides only when the bento homepage is loaded */
  body.bento-page {
    background: var(--bento-bg);
    color: var(--bento-ink);
    font-family: var(--bento-font-sans);
    line-height: 1.5;
  }
  body.bento-page main {
    max-width: 1100px;
    padding: 20px;
  }
  body.bento-page a { color: inherit; text-decoration: none; }
  body.bento-page h1, body.bento-page h2, body.bento-page h3,
  body.bento-page h4, body.bento-page h5 {
