---
import SiteHead from '../components/SiteHead.astro';
import { buildStudyData } from '../lib/study';
import '../styles/broadsheet.css';
import '../styles/prose.css';

// The whole site opens into one full-viewport WebGL room. It owns the document
// (no BaseLayout), and the Notion content it shows is baked in as JSON at build time.
const data = await buildStudyData();
const json = JSON.stringify(data).replace(/</g, '\\u003c');
const BASE = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <SiteHead deferType />
  </head>
  <body class="study-body">
    <div id="stage"></div>
    <div id="vig"></div>
    <div id="grain"></div>
    <!-- The loading screen: the study's door, pushed a little wider at each stage of the load (study.js counts them into data-s) -->
    <div id="intro" data-s="0">
      <div class="door" aria-hidden="true">
        <div class="rays"></div>
        <div class="sill"></div>
        <div class="pool"></div>
        <div class="way">
          <div class="leaf">
            <svg viewBox="0 0 260 536" preserveAspectRatio="none">
              <defs>
                <linearGradient id="door-wood" x1="0" x2="1" y1="0" y2="0"><stop offset="0" stop-color="#553321" /><stop offset="1" stop-color="#43281a" /></linearGradient>
                <radialGradient id="door-brass" cx=".35" cy=".3" r=".8"><stop offset="0" stop-color="#e6c482" /><stop offset=".6" stop-color="#b38b4b" /><stop offset="1" stop-color="#6e5228" /></radialGradient>
              </defs>
              <rect width="260" height="536" fill="url(#door-wood)" />
              <g class="pn">
                <rect x="30" y="30" width="88" height="92" /><rect x="142" y="30" width="88" height="92" />
                <rect x="30" y="148" width="88" height="170" /><rect x="142" y="148" width="88" height="170" />
                <rect x="30" y="344" width="88" height="162" /><rect x="142" y="344" width="88" height="162" />
              </g>
              <g class="pi">
                <rect x="40" y="40" width="68" height="72" /><rect x="152" y="40" width="68" height="72" />
                <rect x="40" y="158" width="68" height="150" /><rect x="152" y="158" width="68" height="150" />
                <rect x="40" y="354" width="68" height="142" /><rect x="152" y="354" width="68" height="142" />
              </g>
              <rect x="239" y="262" width="12" height="62" rx="3" fill="#6e5228" />
              <circle cx="245" cy="282" r="8" fill="url(#door-brass)" />
              <circle class="key" cx="245" cy="308" r="2.2" />
              <rect class="shade" width="260" height="536" />
              <rect class="rim" x="256" width="4" height="536" />
            </svg>
          </div>
        </div>
      </div>
      <div class="flood"></div>
      <p class="cap">推開書房的門……</p>
    </div>
    <div id="toast" class="hud rpg"></div>
    <div id="tip"></div>
    <!-- The dock: the room's four corners, the way back to its middle and, set apart, the way out to the blog -->
    <nav id="hud" class="hud rpg" aria-label="書房導覽">
      <button class="opt hz home" data-home disabled title="回到房間中心" style="--i:0"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10l8-6 8 6v10H4zM10 20v-6h4v6" /></svg><span>回中心</span></button>
      <span class="sep" style="--i:1"></span>
      <button class="opt hz" data-zone="shelf" title="讀過的書" style="--i:2"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h4v16H4zM10 4h4v16h-4zM16.5 5l3.8-1 3.7 15-3.8 1z" /></svg><span>書架</span></button>
      <button class="opt hz" data-zone="display" title="演講、鐵人賽、side project" style="--i:3"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4h10v3a5 5 0 0 1-10 0zM7 6H4a3 3 0 0 0 3 3M17 6h3a3 3 0 0 1-3 3M12 12v4M8 20h8M9 16h6" /></svg><span>展示架</span></button>
      <button class="opt hz" data-zone="desk" title="最新文章與系列" style="--i:4"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9h18M5 9v10M19 9v10M8 9V6h8v3M13 13h4v3h-4z" /></svg><span>書桌</span></button>
      <button class="opt hz" data-zone="tv" title="做著玩的遊戲" style="--i:5"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18v12H3zM8 21h8M6 9h9v6H6zM18 9v1M18 12v1" /></svg><span>遊樂器</span></button>
      <span class="sep" style="--i:6"></span>
      <a class="opt hz" href={`${BASE}archive/`} title="所有文章、書架、關於我" style="--i:7"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h6a3 3 0 0 1 3 3v12a2.5 2.5 0 0 0-2.5-2.5H3zM21 5h-6a3 3 0 0 0-3 3v12a2.5 2.5 0 0 1 2.5-2.5H21z" /></svg><span>部落格</span></a>
    </nav>
    <!-- A book or a page picked up and held in front of the camera -->
    <div id="reader">
      <div class="bd"></div>
      <div id="robj"></div>
      <div class="x rpg"><button class="opt" data-act="rclose">收起 ×</button></div>
      <div id="rnav" class="rnav rpg"></div>
    </div>
    <!-- The CRT, once the camera has pushed in on it -->
    <div id="tvui"><div id="crt"></div><div id="tvbar" class="rpg"></div></div>
    <aside id="panel" class="rpg" aria-live="polite">
      <button class="opt close" data-act="close">收起 ×</button>
      <div id="pbody"></div>
    </aside>

    <noscript>
      <style is:inline>#intro { display: none; }</style>
      <div class="noscript">
        <p>這裡是一間互動式的 3D 書房，需要開啟 JavaScript 才能走進去。</p>
        <p><a href={`${BASE}archive/`}>所有文章</a> · <a href={`${BASE}reading/`}>書架</a> · <a href={`${BASE}about/`}>關於我</a> · <a href="/rss.xml">RSS</a></p>
      </div>
    </noscript>

    <script type="application/json" id="study-data" is:inline set:html={json} />

    <!-- Film grain: a tiny noise canvas, jittered every 90ms -->
    <script is:inline>
      (() => {
        const c = document.createElement('canvas');
        c.width = c.height = 160;
        const x = c.getContext('2d');
        const d = x.createImageData(160, 160);
        // black and white specks on a clear sheet: plain alpha compositing, so the browser never has to
        // read the WebGL frame back for a blend mode
        for (let i = 0; i < d.data.length; i += 4) {
          const v = Math.random() < 0.5 ? 0 : 255;
          d.data[i] = d.data[i + 1] = d.data[i + 2] = v;
          d.data[i + 3] = 255;
        }
        x.putImageData(d, 0, 0);
        const g = document.getElementById('grain');
        g.style.backgroundImage = 'url(' + c.toDataURL() + ')';
        let k = 0;
        setInterval(() => {
          k = (k + 1) % 8;
          g.style.transform = 'translate(' + ((k * 37) % 50) + 'px,' + ((k * 53) % 50) + 'px)';
        }, 90);
      })();
    </script>

    <!-- If the room's script cannot be fetched (a dropped connection, or this page cached from before a deploy, asking for chunks that are
         gone) the door would wait forever. The first failure reloads the page once by itself (at most once every five minutes); after
         that, or when the script has still not run 20 s on (30 s on a phone), the door says so and leaves the way out -->
    <script is:inline define:vars={{ BASE }}>
      (() => {
        const KEY = 'study-boot-retry', intro = document.getElementById('intro');
        let ran = false;
        const stuck = () => {
          const cap = intro.querySelector('.cap'); // gone when study.js has put up its own message (no WebGL)
          if (ran || !cap || intro.classList.contains('off')) return;
          intro.style.pointerEvents = 'auto';
          cap.innerHTML = '書房的門卡住了。<a href="" data-retry>再推一次</a> · <a href="' + BASE + 'archive/">所有文章</a> · <a href="' + BASE + 'reading/">書架</a> · <a href="' + BASE + 'about/">關於我</a>';
          cap.querySelector('[data-retry]').onclick = e => { e.preventDefault(); location.reload(); };
        };
        addEventListener('error', e => {
          if (!(e.target instanceof HTMLScriptElement) || e.target.type !== 'module') return;
          // without sessionStorage there is no telling a first failure from a second, so no reloading by itself at all
          let retry = false;
          try { retry = Date.now() - (+sessionStorage.getItem(KEY) || 0) > 300000; if (retry) sessionStorage.setItem(KEY, String(Date.now())); } catch { retry = false; }
          if (retry) location.reload(); else stuck();
        }, true);
        addEventListener('load', e => { if (e.target instanceof HTMLScriptElement && e.target.type === 'module') ran = true; }, true);
        setTimeout(stuck, matchMedia('(pointer: coarse)').matches ? 30000 : 20000);
      })();
    </script>

    <script>
      import '../scripts/study.js';
    </script>
  </body>
</html>

<style is:global>
  html, body.study-body { margin: 0; height: 100%; overflow: hidden; background: #140e0a; font-family: var(--font-body); color: var(--color-text); }
  /* :not(.btn, .opt) keeps these from outranking the button colours (a primary button is cyan with paper text) and the
     options in the room's windows */
  body.study-body a:not(.btn, .opt) { color: var(--color-accent-700); }
  body.study-body a:not(.btn, .opt):hover { color: var(--color-accent-800); }
  body.study-body button { font-family: inherit; }

  #stage { position: fixed; inset: 0; }
  #stage canvas { display: block; outline: none; }

  #vig { position: fixed; inset: 0; pointer-events: none; z-index: 4; background: radial-gradient(ellipse at 50% 45%, rgba(0,0,0,0) 50%, rgba(0,0,0,.5) 100%); }
  #grain { position: fixed; inset: -50px; pointer-events: none; z-index: 4; opacity: .035; will-change: transform; }
  /* the low tier (study.js decides) does without the two full-screen overlays */
  body.lite #grain, body.lite #vig { display: none; }

  .hud { position: fixed; z-index: 10; }
  .sheet { background: var(--color-bg); box-shadow: var(--shadow-sm); border-radius: var(--radius-md); }

  /* The room's own windows, after an old console RPG: black, a white frame, a pixel face, and a ▶ that stands in front of
     whatever is pointed at and blinks on what is chosen. Cubic 11 is drawn on a 12px grid, so it is set at 12, 18 or 24px
     to stay sharp on a 2x screen, and the cursor is cut in the same 1.5px steps as the letters beside it at 18px. */
  @font-face { font-family: "Cubic 11"; src: url("/fonts/cubic-11/Cubic_11.woff2") format("woff2"); font-display: swap; }
  body.study-body { --pixel: "Cubic 11", var(--font-body); --rpg-bg: rgba(12,9,20,.93); --rpg-ink: #f6f2e8; --rpg-hi: #ffd76a; --rpg-dim: #77718a; --rpg-sky: #8fd3ff; }
  .rpg { background: var(--rpg-bg); color: var(--rpg-ink); border: 3px solid var(--rpg-ink); border-radius: 7px; box-shadow: 0 0 0 3px #0c0914, 6px 6px 0 3px rgba(0,0,0,.35); font-family: var(--pixel); }
  .rpg .opt { all: unset; position: relative; box-sizing: border-box; display: inline-flex; font-family: var(--pixel); align-items: center; gap: 6px; padding: 6px 10px 6px 22px; color: var(--rpg-ink); white-space: nowrap; cursor: pointer; }
  .rpg .opt::before { content: ""; position: absolute; left: 8px; top: 50%; width: 6px; height: 10.5px; margin-top: -5.25px; background: var(--rpg-hi); visibility: hidden;
    clip-path: polygon(0 0, 1.5px 0, 1.5px 1.5px, 3px 1.5px, 3px 3px, 4.5px 3px, 4.5px 4.5px, 6px 4.5px, 6px 6px, 4.5px 6px, 4.5px 7.5px, 3px 7.5px, 3px 9px, 1.5px 9px, 1.5px 10.5px, 0 10.5px); }
  .rpg .opt:is(:hover, :focus-visible):not(:disabled)::before, .rpg .opt.on::before { visibility: visible; }
  .rpg .opt:focus-visible, .rpg .opt.on { color: var(--rpg-hi); }
  .rpg .opt.on::before { animation: rpg-blink 1s steps(2) infinite; }
  .rpg .opt:disabled { color: var(--rpg-dim); cursor: default; }
  .rpg .sep { width: 3px; height: 18px; margin: 0 4px; flex: none; background: repeating-linear-gradient(color-mix(in srgb, var(--rpg-ink) 55%, transparent) 0 3px, transparent 3px 6px); }
  @keyframes rpg-blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .rpg .opt.on::before { animation: none; } }

  body.immerse #tip { opacity: 0 !important; }

  /* the name of what is under the pointer, in a window of the room's kind cut down to a label */
  #tip { position: fixed; z-index: 30; pointer-events: none; font: 12px/1.3 var(--pixel); padding: 5px 8px; background: var(--rpg-bg); color: var(--rpg-ink); border: 2px solid var(--rpg-ink); border-radius: 4px; box-shadow: 0 0 0 2px #0c0914; opacity: 0; transition: opacity .15s; white-space: nowrap; }

  #toast { left: 50%; top: var(--space-8); transform: translate(-50%, -8px); padding: 10px 18px; font-size: 18px; line-height: 1.4; opacity: 0; transition: opacity .25s, transform .25s; pointer-events: none; }
  #toast.on { opacity: 1; transform: translate(-50%, 0); }
  body.reading #toast { left: calc(50% - 230px); }

  /* The dock. On a desk it sits in the top left corner; on a phone, whose view never takes in the whole room, it is a bar
     along the bottom. It comes in one button at a time once the door has opened, and steps aside while something is held up
     to read. */
  #hud { top: var(--space-4); left: var(--space-6); display: flex; align-items: center; padding: 3px 6px 3px 2px; font-size: 18px; line-height: 1.2; transition: opacity .35s, transform .35s; }
  /* on a desk it is a plain menu of words; the icons only come out for the phone's bar */
  #hud .hz svg { display: none; width: 20px; height: 20px; stroke: currentColor; fill: none; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; flex: none; }
  /* not shown until the door is open: then each button slides in on its turn, after the door has faded */
  #hud .hz, #hud .sep { opacity: 0; }
  /* and not tappable either: a tap on the invisible 部落格 while the door is still opening would leave the room */
  body:not(.in) #hud { pointer-events: none; }
  body.in #hud .hz, body.in #hud .sep { animation: hud-in .5s cubic-bezier(.2,.7,.2,1) both; animation-delay: calc(1.2s + var(--i) * 80ms); }
  @keyframes hud-in { from { opacity: 0; transform: translateX(-10px); } to { opacity: 1; transform: none; } }
  body.immerse #hud { opacity: 0; transform: translateY(-6px); pointer-events: none; }
  @media (max-width: 760px) {
    #hud { top: auto; left: var(--space-2); right: var(--space-2); bottom: calc(var(--space-3) + env(safe-area-inset-bottom, 0px)); padding: 3px 2px; justify-content: space-between; font-size: 12px; }
    /* no pointer to follow on a phone, so no cursor: the corner the camera went to turns gold */
    #hud .hz { flex-direction: column; justify-content: center; gap: 4px; padding: 6px 2px; flex: 1; }
    #hud .hz::before { display: none; }
    #hud .hz svg { display: block; }
    #hud .sep { display: none; }
    body.immerse #hud { transform: translateY(6px); }
    /* the panel's dialogue box takes the bottom of the screen, so the bar steps aside for it too */
    body.reading #hud { opacity: 0; transform: translateY(6px); pointer-events: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    body.in #hud .hz, body.in #hud .sep { animation: none; opacity: 1; }
  }

  /* The loading door. --dr is its unit (the doorway is 26 × 54 of them); each stage sets how far the leaf has swung (--a),
     how much of the doorway that uncovers (--g, which the light on the floor is scaled by) and how far the rays reach (--r).
     Only transforms and opacity move, so it keeps swinging smoothly while the room is being built on the main thread. */
  #intro { --dr: min(1vh, 1.5vw); --a: 0deg; --g: 0; --r: 0; --sw: .9s cubic-bezier(.3,.1,.2,1); position: fixed; inset: 0; z-index: 50; overflow: hidden; display: grid; place-items: center; background: linear-gradient(to bottom, #17100b calc(50% + var(--dr)*27), #0e0906 0); transition: opacity 1s .45s; pointer-events: none; color: var(--color-bg); font-family: var(--font-heading); font-size: 20px; font-style: italic; letter-spacing: .04em; text-align: center; }
  #intro[data-s="1"] { --a: 14deg; --g: .06; --r: .3; }
  #intro[data-s="2"] { --a: 32deg; --g: .2; --r: .55; }
  #intro[data-s="3"] { --a: 54deg; --g: .43; --r: .8; }
  #intro[data-s="4"] { --a: 86deg; --g: .83; --r: 1.5; }
  /* an open door takes no clicks, even when the stuck-door message made it clickable (an inline style, hence the !important) and the
     room turned up after all */
  #intro.off { opacity: 0; pointer-events: none !important; }
  #intro a { color: var(--color-accent-300); }
  #intro .door { position: relative; width: calc(var(--dr)*26); height: calc(var(--dr)*54); transform-origin: 60% 50%; transition: transform 1.6s cubic-bezier(.5,0,.8,.4); }
  #intro[data-s="4"] .door { transform: scale(2.6); } /* and you walk in */
  #intro .way { position: absolute; inset: calc(var(--dr)*-1.1) calc(var(--dr)*-1.1) 0; border: calc(var(--dr)*1.1) solid #2b1a10; border-bottom: 0; background: radial-gradient(ellipse at 50% 45%, #ecd3a2, #d3a25c 55%, #a96c2c) padding-box; perspective: calc(var(--dr)*90); }
  /* the leaf stops short of the floor, so a line of light shows under the shut door */
  #intro .leaf { position: absolute; inset: 0 0 calc(var(--dr)*.4); transform-origin: 0 50%; transform: rotateY(var(--a)); transition: transform var(--sw); }
  #intro .leaf svg { display: block; width: 100%; height: 100%; }
  #intro .pn { fill: #33200f; stroke: #24160b; stroke-width: 2; }
  #intro .pi { fill: #4a2c1c; stroke: #5f3b26; stroke-width: 1.5; }
  #intro .key { fill: #e8c48a; }
  #intro .shade { fill: #0a0603; opacity: calc(var(--r)*.4); transition: opacity var(--sw); }
  #intro .rim { fill: #e8c48a; opacity: min(1, var(--r)*2); transition: opacity var(--sw); }
  #intro .rays { position: absolute; left: calc(50% - var(--dr)*75); top: calc(50% - var(--dr)*75); width: calc(var(--dr)*150); height: calc(var(--dr)*150); opacity: min(1, var(--r)*1.25); transform: scale(calc(.35 + var(--r)*.75)); transition: opacity var(--sw), transform var(--sw); }
  #intro .rays::before { content: ""; position: absolute; inset: 0; background: radial-gradient(circle, rgba(255,214,150,.28), rgba(255,190,110,.1) 22%, transparent 48%), repeating-conic-gradient(from 8deg, transparent 0 7deg, rgba(255,206,134,.13) 10deg, transparent 13deg 18deg), repeating-conic-gradient(transparent 0 22deg, rgba(255,226,170,.1) 29deg, transparent 36deg 40deg); -webkit-mask-image: radial-gradient(circle, #000 12%, transparent 70%); mask-image: radial-gradient(circle, #000 12%, transparent 70%); animation: door-rays 90s linear infinite; }
  #intro .sill { position: absolute; left: -10%; width: 120%; top: calc(100% - var(--dr)*.4); height: calc(var(--dr)*3); background: radial-gradient(ellipse at 50% 0, rgba(255,205,130,.38), transparent 70%); }
  /* the light on the floor: hung from the latch-side jamb and scaled to the gap, so it fans out from wherever the leaf's edge is */
  #intro .pool { position: absolute; left: -90%; width: 280%; top: 100%; height: calc(var(--dr)*40); transform-origin: 67.86% 0; transform: scaleX(var(--g)); filter: blur(calc(var(--dr)*.5)); transition: transform var(--sw); }
  #intro .pool::before { content: ""; position: absolute; inset: 0; clip-path: polygon(32.14% 0, 67.86% 0, 100% 100%, 0 100%); background: linear-gradient(to bottom, rgba(236,196,130,.5), rgba(255,190,110,0)); }
  #intro .flood { position: absolute; inset: 0; background: radial-gradient(ellipse at 50% 50%, #e6c995, rgba(205,155,90,.8) 60%, rgba(150,95,40,.6)); opacity: 0; transition: opacity .7s ease-in; }
  #intro[data-s="4"] .flood { opacity: .7; }
  #intro .cap { position: absolute; left: 0; right: 0; top: calc(50% + var(--dr)*32); margin: 0; transition: opacity .4s; }
  #intro[data-s="4"] .cap { opacity: 0; }
  @keyframes door-rays { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) {
    #intro .rays::before { animation: none; }
    #intro[data-s="4"] .door { transform: none; }
  }

  .noscript { position: fixed; inset: 0; z-index: 60; display: grid; place-content: center; text-align: center; background: #140e0a; color: var(--color-bg); font-style: italic; }
  .noscript a { color: var(--color-accent-300); }

  /* Reading panel */
  /* A window of the room's kind, standing at the right (a dialogue box along the bottom on a phone). Its headings, labels and
     options are in the pixel face; what is there to be read stays in the book face. */
  #panel { position: fixed; top: var(--space-4); right: var(--space-4); width: 440px; max-height: calc(100% - var(--space-4) * 2); z-index: 20; box-sizing: border-box; overflow: auto; overscroll-behavior: contain; padding: 52px 28px 28px 30px; font-family: var(--font-body); transform: translateX(calc(100% + 40px)); transition: transform .45s cubic-bezier(.2,.7,.2,1); scrollbar-width: thin; scrollbar-color: color-mix(in srgb, var(--rpg-ink) 45%, transparent) transparent; }
  #panel.open { transform: none; }
  #panel .close { position: absolute; right: 8px; top: 8px; font-size: 18px; }
  #panel h2, #panel h3 { margin: 8px 0 var(--space-3); font-family: var(--pixel); font-weight: 400; line-height: 1.3; color: #fff; text-wrap: pretty; }
  #panel h2 { font-size: 36px; }
  #panel h3 { font-size: 30px; }
  #panel .card-kicker { font-family: var(--pixel); font-size: 12px; letter-spacing: .08em; color: var(--rpg-sky); }
  #panel .card-kicker.k2 { color: #ffab91; } /* the newest article and the 碎碎念 notes */
  #panel .tag { font-family: var(--pixel); font-size: 12px; padding: 2px 8px; border: 2px solid var(--rpg-ink); border-radius: 4px; background: none; color: var(--rpg-ink); }
  #panel img { border: 3px solid var(--rpg-ink); }
  #panel .intro { font-size: 17px; font-style: italic; line-height: 1.6; margin: 0 0 var(--space-4); color: #e6e0d2; }
  #panel .body:not(:empty) { margin-top: var(--space-4); padding-top: var(--space-4); border-top: 2px dashed color-mix(in srgb, var(--rpg-ink) 30%, transparent); }
  #panel .body p { font-size: 17px; line-height: 1.75; margin: 0 0 var(--space-3); color: #e6e0d2; text-wrap: pretty; }
  /* a game's rows: the cursor stands at the title line */
  #panel .list { display: flex; flex-direction: column; margin-left: -8px; }
  #panel .li { flex-direction: column; align-items: flex-start; gap: 2px; white-space: normal; }
  #panel .li::before { top: 36px; }
