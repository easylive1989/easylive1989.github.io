---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArchiveView from '../components/ArchiveView.astro';
import { getAllArticles, getAllCategories } from '../lib/data';

const articles = await getAllArticles();
const categories = await getAllCategories();
---

<BaseLayout title="所有文章" hideFooter bodyClass="archive-page-body">
  <ArchiveView articles={articles} allCategories={categories} />
</BaseLayout>
