---
import SiteHead from '../components/SiteHead.astro';
import Landscape from '../components/Landscape.astro';
import { loadConfig } from '../lib/config';
import '../styles/broadsheet.css';
import '../styles/desk.css';

/** The blog's three tabs; every page here sits under one of them. */
type Tab = 'archive' | 'reading' | 'about';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** An article's dates and category, for link previews (SiteHead). */
  article?: { published: string; modified?: string; section?: string };
  /** The tab this page sits under, lit in the masthead. */
  tab: Tab;
  /** `wide` gives shelf-style pages more room than a reading column. */
  width?: 'reading' | 'wide';
  bodyClass?: string;
  /** The ink landscape seen from far back (every page) or with the camera pushed in (the about page). */
  landscape?: 'far' | 'near';
}

const BASE = import.meta.env.BASE_URL;
const BLOG = loadConfig().site.blogTitle;
const TABS: [Tab, string, string][] = [
  ['archive', '所有文章', `${BASE}`],
  ['reading', '書架', `${BASE}reading/`],
  ['about', '關於我', `${BASE}about/`],
];
const { title, description, ogImage, article, tab, width = 'reading', bodyClass, landscape = 'far' } = Astro.props;
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <SiteHead title={title} siteTitle={BLOG} description={description} ogImage={ogImage} article={article} />
    <!-- Arriving through one of the blog's transitions (deskFx.js): the page that started it left a note saying which,
         read before the first paint so the page can begin where the transition left off -->
    <script is:inline>
      (function () {
        try {
          var a = sessionStorage.getItem('desk-arrive');
          if (!a) return;
          sessionStorage.removeItem('desk-arrive');
          if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.setAttribute('data-arrive', a);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class:list={['desk-body', bodyClass]}>
    <!-- The page itself, in one wrapper: the secret door splits a copy of it down the middle -->
    <div class="desk-page">
      <Landscape near={landscape === 'near'} />

      <!-- The blog's masthead: its name beside the red sun, its three tabs in a pill, and the feed -->
      <header class:list={['blog-head', `desk-${width}`]}>
        <a class="blog-brand" href={`${BASE}`}><i aria-hidden="true"></i><span>{BLOG}</span></a>
        <nav class="blog-tabs" aria-label="部落格">
          {TABS.map(([id, label, href]) => (
            <a href={href} data-tab={id} class:list={{ on: id === tab }} aria-current={id === tab ? 'true' : undefined}>{label}</a>
          ))}
        </nav>
        <a class="blog-rss" href="/rss.xml" target="_blank" rel="noopener" title="RSS 訂閱" aria-label="RSS 訂閱">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.18 17.82c0 1.2-.97 2.18-2.18 2.18S1.82 19.02 1.82 17.82 2.79 15.64 4 15.64s2.18.98 2.18 2.18zM4 4.44v3.06A12.5 12.5 0 0 1 16.5 20h3.06A15.56 15.56 0 0 0 4 4.44zM4 10.6v3.07A6.4 6.4 0 0 1 10.4 20h3.07A9.47 9.47 0 0 0 4 10.6z" /></svg>
        </a>
      </header>

      <main class:list={['desk-main', `desk-${width}`]}>
        <slot />
      </main>

      <div class="desk-foot" aria-hidden="true"></div>
    </div>

    <!-- The way back up, once the page has scrolled a way down -->
    <button class="desk-top" id="desk-top" type="button" aria-label="回到最上面" title="回到最上面">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
    </button>
    <script is:inline>
      (function () {
        var btn = document.getElementById('desk-top');
        if (!btn) return;
        var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        var queued = false;
        var update = function () {
          queued = false;
          btn.classList.toggle('is-shown', window.scrollY > window.innerHeight / 2);
        };
        window.addEventListener('scroll', function () {
          if (queued) return;
          queued = true;
          window.requestAnimationFrame(update);
        }, { passive: true });
        btn.addEventListener('click', function () {
          window.scrollTo({ top: 0, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
        });
        update();
      })();
    </script>
    <script>
      import './deskFx.js';
    </script>
  </body>
</html>
