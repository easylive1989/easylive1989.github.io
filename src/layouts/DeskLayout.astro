---
import SiteHead from '../components/SiteHead.astro';
import '../styles/broadsheet.css';
import '../styles/desk.css';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Trail shown in the HUD next to the "back to the study" button. */
  crumbs?: Crumb[];
  /** `wide` gives shelf-style pages more room than a reading column. */
  width?: 'reading' | 'wide';
  bodyClass?: string;
}

const BASE = import.meta.env.BASE_URL;
const { title, description, ogImage, crumbs = [], width = 'reading', bodyClass } = Astro.props;
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <SiteHead title={title} description={description} ogImage={ogImage} />
  </head>
  <body class:list={['desk-body', bodyClass]}>
    <!-- The one fixture on every page: the way into the room, lined up with the page's left edge -->
    <nav class:list={['desk-hud', `desk-${width}`]} aria-label="站內導覽">
      <div class="hud-cluster sheet">
        <a class="btn btn-primary" href={BASE}>← 回書房</a>
        {crumbs.length > 0 && (
          <ol class="crumbs">
            {crumbs.map((c) => (
              <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
            ))}
          </ol>
        )}
      </div>
    </nav>

    <main class:list={['desk-main', `desk-${width}`]}>
      <slot />
    </main>

    <!-- The way back up, once the page has scrolled a way down -->
    <button class="desk-top sheet" id="desk-top" type="button" aria-label="回到最上面" title="回到最上面">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
    </button>
    <script is:inline>
      (function () {
        var btn = document.getElementById('desk-top');
        if (!btn) return;
        var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        var queued = false;
        var update = function () {
          queued = false;
          btn.classList.toggle('is-shown', window.scrollY > window.innerHeight / 2);
        };
        window.addEventListener('scroll', function () {
          if (queued) return;
          queued = true;
          window.requestAnimationFrame(update);
        }, { passive: true });
        btn.addEventListener('click', function () {
          window.scrollTo({ top: 0, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
        });
        update();
      })();
    </script>
  </body>
</html>
