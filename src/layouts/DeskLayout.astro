---
import SiteHead from '../components/SiteHead.astro';
import { loadConfig } from '../lib/config';
import '../styles/broadsheet.css';
import '../styles/desk.css';

/** The blog's three tabs; every page here sits under one of them. */
type Tab = 'archive' | 'reading' | 'about';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** The tab this page sits under, lit in the masthead. */
  tab: Tab;
  /** `wide` gives shelf-style pages more room than a reading column. */
  width?: 'reading' | 'wide';
  bodyClass?: string;
}

const BASE = import.meta.env.BASE_URL;
const BLOG = loadConfig().site.blogTitle;
const TABS: [Tab, string, string][] = [
  ['archive', '所有文章', `${BASE}archive/`],
  ['reading', '書架', `${BASE}reading/`],
  ['about', '關於我', `${BASE}about/`],
];
const { title, description, ogImage, tab, width = 'reading', bodyClass } = Astro.props;
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <SiteHead title={title} siteTitle={BLOG} description={description} ogImage={ogImage} />
  </head>
  <body class:list={['desk-body', bodyClass]}>
    <!-- The blog's masthead: its name, its three tabs and, set apart, the way into the room. As wide as the paper, so it lines up with its edges -->
    <header class:list={['blog-head', `desk-${width}`]}>
      <a class="blog-brand" href={`${BASE}archive/`}>{BLOG}</a>
      <nav class="blog-tabs" aria-label="部落格">
        {TABS.map(([id, label, href]) => (
          <a href={href} data-tab={id} class:list={{ on: id === tab }} aria-current={id === tab ? 'true' : undefined}>{label}</a>
        ))}
      </nav>
      <a class="blog-room" href={BASE} title="切到 3D 書房">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 21V4h12v17M3 21h18M14.5 12.5v1" /></svg>
        <span>書房</span>
      </a>
    </header>

    <main class:list={['desk-main', `desk-${width}`]}>
      <slot />
    </main>

    <!-- The way back up, once the page has scrolled a way down -->
    <button class="desk-top sheet" id="desk-top" type="button" aria-label="回到最上面" title="回到最上面">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
    </button>
    <script is:inline>
      (function () {
        var btn = document.getElementById('desk-top');
        if (!btn) return;
        var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        var queued = false;
        var update = function () {
          queued = false;
          btn.classList.toggle('is-shown', window.scrollY > window.innerHeight / 2);
        };
        window.addEventListener('scroll', function () {
          if (queued) return;
          queued = true;
          window.requestAnimationFrame(update);
        }, { passive: true });
        btn.addEventListener('click', function () {
          window.scrollTo({ top: 0, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
        });
        update();
      })();
    </script>
  </body>
</html>
