---
import SiteHead from '../components/SiteHead.astro';
import '../styles/broadsheet.css';
import '../styles/desk.css';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Trail shown in the HUD next to the "back to the study" button. */
  crumbs?: Crumb[];
  /** `wide` gives shelf-style pages more room than a reading column. */
  width?: 'reading' | 'wide';
  bodyClass?: string;
}

const BASE = import.meta.env.BASE_URL;
const { title, description, ogImage, crumbs = [], width = 'reading', bodyClass } = Astro.props;
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <SiteHead title={title} description={description} ogImage={ogImage} />
  </head>
  <body class:list={['desk-body', bodyClass]}>
    <!-- The one fixture on every page: the way into the room, lined up with the page's left edge -->
    <nav class:list={['desk-hud', `desk-${width}`]} aria-label="站內導覽">
      <div class="hud-cluster sheet">
        <a class="btn btn-primary" href={BASE}>← 回書房</a>
        {crumbs.length > 0 && (
          <ol class="crumbs">
            {crumbs.map((c) => (
              <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
            ))}
          </ol>
        )}
      </div>
    </nav>

    <main class:list={['desk-main', `desk-${width}`]}>
      <slot />
    </main>
  </body>
</html>
